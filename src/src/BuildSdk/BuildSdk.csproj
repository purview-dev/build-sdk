<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>Purview.BuildSdk</PackageId>
		<PackageType>MSBuildSdk</PackageType>
		<Description>A reusable MSBuild SDK that provides standardised .NET project defaults, code style enforcement, configurable testing framework wiring (TUnit, Xunit, or None), mocking provider wiring (TUnitMocks, NSubstitute, or None), and Central Package Management integration. Drop in via Directory.Build.props to apply uniformly across every project in a repo.</Description>
		<PackageTags>msbuild;sdk;build;tunit;xunit;tunitmock;nsubstitute;bogus;csharp;dotnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>purview-logo-light.png</PackageIcon>

		<!-- No compiled output — this is a pure MSBuild SDK package -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<DisableGenerateAssemblyInfoClass>true</DisableGenerateAssemblyInfoClass>
		<DisableGenerateAssemblyIdentifierClass>true</DisableGenerateAssemblyIdentifierClass>
		<IsPackable>true</IsPackable>

		<!-- No telemetry packages for this meta-project -->
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<ExcludeMSTelemetryExtension>true</ExcludeMSTelemetryExtension>
		<!-- No compiled output, so no symbol package is produced -->
		<IncludeSymbols>false</IncludeSymbols>
		<IncludeSource>false</IncludeSource>
		<!-- This is an MSBuild SDK package, not a standard .NET project; disable auto Sdk/ packing. -->
		<PurviewAutoSdkPack>false</PurviewAutoSdkPack>
		<!-- NU5128: expected for MSBuildSdk packages — no lib/ref assemblies by design -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<!-- Allow dotfiles (e.g., .editorconfig) to be packed -->
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<!-- No C# so no need to generate useful usings -->
		<AutoIncludeUsings>false</AutoIncludeUsings>
		<!-- Skills are not packed into any package. They live at the repository root in skills/
		     and are published through the skills CLI, which clones the git repository:
		     `npx skills add purview-dev/build-sdk`. ValidatePurviewSkills still runs before Pack,
		     so a malformed skill fails here rather than reaching the CLI. -->
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\Analyzers\Analyzers.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
			Targets="GetSourceGeneratorAnalyzerFiles"
		/>
		<ProjectReference
			Include="..\CodeFixers\CodeFixers.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
			Targets="GetSourceGeneratorAnalyzerFiles"
		/>
	</ItemGroup>

	<!-- =====================================================================
	     EDITORCONFIG VERSION STAMP
	     The packed .editorconfig opens with '# Purview.BuildSdk <version>', which is how the SDK later
	     recognises a bootstrapped file as one it wrote and decides whether that copy is stale. The
	     version is therefore part of the package's content, and is stamped in at pack time from
	     $(Version) rather than being maintained by hand in the repository file - a hand-maintained
	     marker is one bump away from telling every consumer their copy is current when it is a release
	     behind.

	     The stamp is written to obj/ and that copy is packed. The tracked .editorconfig is never
	     rewritten by a build: mutating a tracked source file leaves a dirty working tree on CI and
	     races when projects build in parallel.
	     ===================================================================== -->
	<PropertyGroup>
		<_PurviewSourceEditorConfig>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../.editorconfig'))</_PurviewSourceEditorConfig>
	</PropertyGroup>

	<UsingTask
		TaskName="StampPurviewEditorConfigVersion"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<SourceFile ParameterType="System.String" Required="true" />
			<DestinationFile ParameterType="System.String" Required="true" />
			<MarkerPrefix ParameterType="System.String" Required="true" />
			<Version ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
				if (!File.Exists(SourceFile))
				{
					Log.LogError("The source .editorconfig '{0}' does not exist.", SourceFile);
					return false;
				}

				var lines = File.ReadAllLines(SourceFile);
				var stampedLine = MarkerPrefix + Version + " - managed file, do not edit";
				var markerIndex = -1;

				for (var i = 0; i < lines.Length; i++)
				{
					if (string.IsNullOrWhiteSpace(lines[i]))
					{
						continue;
					}

					// The marker has to be the first thing in the file: that is where the SDK looks for
					// it, and where a developer opening the file will read it.
					markerIndex = lines[i].TrimStart().StartsWith(MarkerPrefix, StringComparison.Ordinal) ? i : -1;
					break;
				}

				if (markerIndex < 0)
				{
					Log.LogError(
						"The source .editorconfig '{0}' does not open with the version marker '{1}'. The packed file would not be recognised as SDK-managed, and would never be updated in a consuming repository.",
						SourceFile,
						MarkerPrefix);
					return false;
				}

				lines[markerIndex] = stampedLine;

				var destinationDirectory = Path.GetDirectoryName(DestinationFile);
				if (!string.IsNullOrEmpty(destinationDirectory))
				{
					Directory.CreateDirectory(destinationDirectory);
				}

				var stamped = string.Join("\n", lines) + "\n";

				// Only write when the content actually changes, so packing twice does not keep
				// invalidating anything downstream that tracks the file's timestamp.
				if (!File.Exists(DestinationFile) || File.ReadAllText(DestinationFile) != stamped)
				{
					File.WriteAllText(DestinationFile, stamped);
					Log.LogMessage(MessageImportance.Normal, "Stamped '{0}' into '{1}'.", stampedLine, DestinationFile);
				}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="StampPurviewEditorConfigVersionTarget"
		BeforeTargets="_GetPackageFiles;GenerateNuspec;AssignTargetPaths"
		Label="Writes the packed .editorconfig with the version being built stamped onto its marker line."
	>
		<PropertyGroup>
			<!-- PackageVersion is what names the package and what a consumer restores, so it is what the
			     marker has to agree with. It and Version only differ when one is set explicitly. -->
			<_PurviewEditorConfigStampVersion>$([System.String]::Copy('$(PackageVersion)').Trim())</_PurviewEditorConfigStampVersion>
			<_PurviewEditorConfigStampVersion Condition="'$(_PurviewEditorConfigStampVersion)' == ''"
				>$(Version)</_PurviewEditorConfigStampVersion>
			<!--
				Resolved here rather than in a top-level PropertyGroup: IntermediateOutputPath is set by the
				SDK's own targets, so at evaluation time it is still empty and the stamp would be written
				into the source tree next to the project - where it would also be picked up as a real
				.editorconfig for everything beneath that folder.

				Overridable so a test can drive the target to a scratch path.
			-->
			<_PurviewStampedEditorConfig Condition="'$(_PurviewStampedEditorConfig)' == ''"
				>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)purview-editorconfig/.editorconfig'))</_PurviewStampedEditorConfig>
		</PropertyGroup>
		<!--
			Deliberately no Inputs/Outputs. The version is as much an input as the file is, and an
			incremental check keyed on the source alone silently reuses a stamp from a previous version -
			which is precisely the stale marker this whole mechanism exists to prevent. The task is a
			single file read and only writes when the content differs, so running it every pack is free.
		-->
		<StampPurviewEditorConfigVersion
			SourceFile="$(_PurviewSourceEditorConfig)"
			DestinationFile="$(_PurviewStampedEditorConfig)"
			MarkerPrefix="$(PurviewEditorConfigVersionMarker)"
			Version="$(_PurviewEditorConfigStampVersion)"
		/>
		<!-- Added here too, for the same reason the path is resolved here: the item has to name a path
		     that is only known once the SDK's targets have run. -->
		<ItemGroup>
			<None
				Include="$(_PurviewStampedEditorConfig)"
				Pack="true"
				PackagePath="Sdk/.editorconfig"
				Visible="false"
			/>
		</ItemGroup>
	</Target>

	<!-- Pack the Sdk/ folder contents into the correct locations in the NuGet package.
	     .editorconfig must be listed explicitly — NuGet excludes dotfiles by default. -->
	<ItemGroup>
		<None
			Include="Sdk/.github/**/*"
			Pack="true"
			PackagePath=".github/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)"
			Visible="true"
		/>
		<None
			Include="Sdk/build/**/*"
			Pack="true"
			PackagePath="build/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)"
			Visible="true"
		/>
		<None
			Include="Sdk/buildTransitive/**/*"
			Pack="true"
			PackagePath="buildTransitive/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)"
			Visible="true"
		/>
		<None
			Include="Sdk/buildMultiTargeting/**/*"
			Pack="true"
			PackagePath="buildMultiTargeting/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)"
			Visible="true"
		/>
		<None
			Include="Sdk/*.md;Sdk/*.png;Sdk/*.jpg;Sdk/*.jpeg;Sdk/*.gif;Sdk/*.svg"
			Pack="true"
			PackagePath="%(Filename)%(Extension)"
			Visible="true"
		/>
		<None
			Include="Sdk/**/*"
			Pack="true"
			PackagePath="Sdk/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)"
			Visible="true"
			Exclude="Sdk/.github/**/*;Sdk/build/**/*;Sdk/buildTransitive/**/*;Sdk/buildMultiTargeting/**/*;Sdk/*.md;Sdk/*.png;Sdk/*.jpg;Sdk/*.jpeg;Sdk/*.gif;Sdk/*.svg"
		/>

		<None Include="$(MSBuildThisFileDirectory)../../../README.md" Pack="true" PackagePath="/" />
		<None
			Include="$(MSBuildThisFileDirectory)../../../assets/images/purview-logo-light.png"
			Pack="true"
			PackagePath="/"
		/>
	</ItemGroup>
</Project>
