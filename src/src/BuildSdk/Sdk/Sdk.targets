<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="$(MSBuildThisFileDirectory)Targets/VersionDetection.targets " />

	<PropertyGroup>
		<DefaultTargetFramework Condition="'$(DefaultTargetFramework)' == '' AND '$(TargetFrameworks)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Match('$(TargetFrameworks)', '^[^;]+').Value)</DefaultTargetFramework>
		<DefaultTargetFramework Condition="'$(DefaultTargetFramework)' == '' AND '$(TargetFramework)' != ''"
			>$(TargetFramework)</DefaultTargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'">
		<!-- Microsoft.Managed.Core.targets clears this when emission is disabled; retain the
		     Roslyn-component default so enabling EmitCompilerGeneratedFiles needs no second setting. -->
		<CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''"
			>$(IntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<!-- =====================================================================
	     PACKABLE ROSLYN COMPONENT ANALYZER ASSET
	     Packs the built analyzer/generator assembly (and its PDB) into
	     analyzers/dotnet/cs so consumers receive it as a Roslyn analyzer rather
	     than a lib/ asset. IncludeBuildOutput=false keeps lib/ empty. Gated on
	     single-targeting because TargetPath is a single-TFM path; the SDK clears
	     TargetFrameworks for Roslyn components by default, and a project that
	     explicitly multi-targets opts out of this convenience.
	     ===================================================================== -->
	<ItemGroup
		Label="Packable Roslyn Component Analyzer Asset"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '$(IsPackable)' == 'true' AND '$(TargetFrameworks)' == ''"
	>
		<None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<!-- The PDB ships inside the .nupkg beside the analyzer by default (PurviewPackAnalyzerPdb=true)
		     so symbols are always delivered. NuGet's .snupkg cannot host analyzers/dotnet/cs symbols
		     (symbols flow is gated on IncludeBuildOutput inside the PackTask), so opt out only when
		     symbols are delivered another way. -->
		<None
			Include="$(TargetDir)$(TargetName).pdb"
			Pack="true"
			PackagePath="analyzers/dotnet/cs"
			Visible="false"
			Condition="'$(DebugType)' != 'embedded' AND '$(DebugType)' != 'none' AND '$(PurviewPackAnalyzerPdb)' != 'false'"
		/>
	</ItemGroup>

	<!-- =====================================================================
	     ROSLYN DEV DEPENDENCY DEFAULTS
	     Roslyn packages (Microsoft.CodeAnalysis.*, Microsoft.CodeAnalysis.Analyzers)
	     are development-only dependencies of analyzer/generator projects. When a
	     Roslyn component references them, default PrivateAssets=all (and the
	     analyzer IncludeAssets for Microsoft.CodeAnalysis.Analyzers) so they never
	     leak into the packed nuspec as package dependencies. Update-only: existing
	     references are amended; nothing is added, and explicit metadata is preserved.
	     ===================================================================== -->
	<ItemGroup
		Label="Roslyn Dev Dependency Defaults"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'"
	>
		<PackageReference Update="Microsoft.CodeAnalysis.CSharp">
			<PrivateAssets Condition="'%(PackageReference.PrivateAssets)' == ''">all</PrivateAssets>
		</PackageReference>
		<PackageReference Update="Microsoft.CodeAnalysis.CSharp.Workspaces">
			<PrivateAssets Condition="'%(PackageReference.PrivateAssets)' == ''">all</PrivateAssets>
		</PackageReference>
		<PackageReference Update="Microsoft.CodeAnalysis.Analyzers">
			<PrivateAssets Condition="'%(PackageReference.PrivateAssets)' == ''">all</PrivateAssets>
			<IncludeAssets Condition="'%(PackageReference.IncludeAssets)' == ''"
				>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- =====================================================================
	     VALIDATE ROSLYN COMPONENT COMPILER SETTINGS
	     Ensures packable Roslyn components are always shipped with the standard
	     compiler defaults so every analyzer package is built with latest C#,
	     nullable enable, warnings-as-errors, and extended analyzer rules.
	     Opt out with DisableRoslynCompilerDefaultsValidation=true.
	     ===================================================================== -->
	<Target
		Name="ValidateRoslynComponentCompilerSettings"
		BeforeTargets="Pack"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '$(IsPackable)' == 'true' AND '$(DisableRoslynCompilerDefaultsValidation)' != 'true'"
		Label="Validates Roslyn components are shipped with the standard compiler defaults."
	>
		<Error
			Code="PRSGD0001"
			Text="The Roslyn component '$(MSBuildProjectName)' does not set LangVersion. Source-generator packages must ship with a defined C# language version (default latest)."
			Condition="'$(LangVersion)' == ''"
		/>
		<Error
			Code="PRSGD0002"
			Text="The Roslyn component '$(MSBuildProjectName)' does not set Nullable. Source-generator packages must ship with a defined nullable context (default enable)."
			Condition="'$(Nullable)' == ''"
		/>
		<Error
			Code="PRSGD0003"
			Text="The Roslyn component '$(MSBuildProjectName)' disables TreatWarningsAsErrors. Source-generator packages must ship with warnings-as-errors enabled (default true)."
			Condition="'$(TreatWarningsAsErrors)' != 'true'"
		/>
		<Error
			Code="PRSGD0004"
			Text="The Roslyn component '$(MSBuildProjectName)' disables EnforceExtendedAnalyzerRules. Source-generator packages must ship with extended analyzer rules enabled (default true)."
			Condition="'$(EnforceExtendedAnalyzerRules)' != 'true'"
		/>
	</Target>

	<Target
		Name="CreateRoslynComponentGeneratedFilesDirectory"
		BeforeTargets="CoreCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '$(CompilerGeneratedFilesOutputPath)' != ''"
	>
		<MakeDir Directories="$(CompilerGeneratedFilesOutputPath)" />
	</Target>

	<!-- Analyzer project references need the extended target so runtime dependencies are
	     propagated as well as the generator assembly. Make it the default when omitted. -->
	<Target Name="ConfigureSourceGeneratorProjectReferences" BeforeTargets="AssignProjectConfiguration">
		<ItemGroup>
			<ProjectReference
				Update="@(ProjectReference)"
				Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer' AND '%(ProjectReference.ReferenceOutputAssembly)' == 'false' AND '%(ProjectReference.Targets)' == ''"
			>
				<Targets>GetSourceGeneratorAnalyzerFiles</Targets>
			</ProjectReference>
		</ItemGroup>
	</Target>

	<!-- Visual Studio's project system may retain only the primary output from an analyzer
	     ProjectReference. Resolve the extended target explicitly and add every returned file
	     to the compiler's Analyzer items, including generator runtime dependencies. -->
	<Target Name="ResolveSourceGeneratorProjectReferenceFiles" AfterTargets="ResolveProjectReferences">
		<ItemGroup>
			<_PurviewSourceGeneratorCompilerProjectReference
				Include="@(ProjectReference)"
				Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer' AND '%(ProjectReference.ReferenceOutputAssembly)' == 'false'"
			/>
		</ItemGroup>
		<MSBuild
			Projects="@(_PurviewSourceGeneratorCompilerProjectReference)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewSourceGeneratorCompilerProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewResolvedSourceGeneratorCompilerFile" />
		</MSBuild>

		<!--
			Visual Studio's project system additionally resolves an OutputItemType=Analyzer project
			reference to the referenced project's default target path - the component's *unmerged* bin
			assembly - and adds it to the compiler's analyzers. That copy is not a valid analyzer for a
			merged component: it still references Purview.SourceGeneratorFramework, so loading it makes
			the compiler host look for a framework assembly it does not have (CS8784
			FileNotFoundException) and registers the generators twice.

			Remove the referenced projects' target paths before adding the resolved closure so only the
			merged artifact is handed to Roslyn, and also remove any analyzer whose file name collides
			with a resolved closure file (the merged and unmerged assemblies share a file name).
		-->
		<MSBuild
			Projects="@(_PurviewSourceGeneratorCompilerProjectReference)"
			Targets="GetTargetPath"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewSourceGeneratorCompilerProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewUnmergedSourceGeneratorCompilerFile" />
		</MSBuild>
		<ItemGroup>
			<Analyzer Remove="@(_PurviewUnmergedSourceGeneratorCompilerFile)" />
			<Analyzer Remove="@(_PurviewResolvedSourceGeneratorCompilerFile)" MatchOnMetadata="Filename" />
			<Analyzer Include="@(_PurviewResolvedSourceGeneratorCompilerFile)" />
		</ItemGroup>
	</Target>

	<Target
		Name="CopySourceGeneratorRuntimeDependencies"
		AfterTargets="CopyFilesToOutputDirectory"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '@(SourceGeneratorRuntimeDependency)' != ''"
	>
		<ItemGroup>
			<_PurviewSourceGeneratorRuntimeDependency Include="@(SourceGeneratorRuntimeDependency)">
				<DestinationPath Condition="'%(SourceGeneratorRuntimeDependency.DestinationSubPath)' != ''"
					>$(TargetDir)%(SourceGeneratorRuntimeDependency.DestinationSubPath)</DestinationPath>
				<DestinationPath Condition="'%(SourceGeneratorRuntimeDependency.DestinationSubPath)' == ''"
					>$(TargetDir)%(SourceGeneratorRuntimeDependency.Filename)%(SourceGeneratorRuntimeDependency.Extension)</DestinationPath>
			</_PurviewSourceGeneratorRuntimeDependency>
		</ItemGroup>
		<Copy
			SourceFiles="@(_PurviewSourceGeneratorRuntimeDependency)"
			DestinationFiles="@(_PurviewSourceGeneratorRuntimeDependency->'%(DestinationPath)')"
			SkipUnchangedFiles="true"
		/>
	</Target>

	<!-- Analyzer project references can request this target to receive the built generator
	     assembly. Generator-specific packages may override it to append runtime dependencies. -->
	<Target
		Name="GetSourceGeneratorAnalyzerFiles"
		Returns="@(_PurviewSourceGeneratorAnalyzerFile)"
		DependsOnTargets="Build;GetTargetPathWithTargetPlatformMoniker"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'"
	>
		<ItemGroup>
			<_PurviewSourceGeneratorAnalyzerFileRaw Include="@(TargetPathWithTargetPlatformMoniker)" />
			<!-- Roslyn resolves analyzer dependencies beside the analyzer assembly. Return the
			     copies in TargetDir, rather than their original NuGet/package locations. -->
			<_PurviewSourceGeneratorAnalyzerFileRaw
				Include="$(TargetDir)%(SourceGeneratorRuntimeDependency.DestinationSubPath)"
				Condition="'@(SourceGeneratorRuntimeDependency)' != '' AND '%(SourceGeneratorRuntimeDependency.DestinationSubPath)' != ''"
			/>
			<_PurviewSourceGeneratorAnalyzerFileRaw
				Include="$(TargetDir)%(SourceGeneratorRuntimeDependency.Filename)%(SourceGeneratorRuntimeDependency.Extension)"
				Condition="'@(SourceGeneratorRuntimeDependency)' != '' AND '%(SourceGeneratorRuntimeDependency.DestinationSubPath)' == ''"
			/>
		</ItemGroup>

		<!--
			A component that references another Roslyn component has a genuine runtime dependency on
			it (for example a code-fix component that shares the generator's diagnostic identity). The
			referenced component's *analyzer artifact* therefore belongs to this component's closure so
			Roslyn can load both. Its own merged, self-contained assembly is returned: the referenced
			component is never IL-merged into this one, which would duplicate its types (including
			InternalsVisibleTo-visible internals) inside a second analyzer in the same host.

			Non-component project references are harmless: the referenced project's
			GetSourceGeneratorAnalyzerFiles target is skipped by its own IsRoslynComponent condition
			and returns nothing.
		-->
		<ItemGroup>
			<_PurviewComponentReferenceProjectReference
				Include="@(ProjectReference)"
				Condition="'$(PurviewIncludeComponentReferenceAnalyzerClosure)' != 'false' AND '%(ProjectReference.ReferenceOutputAssembly)' != 'false' AND '%(ProjectReference.OutputItemType)' != 'Analyzer'"
			/>
		</ItemGroup>
		<MSBuild
			Projects="@(_PurviewComponentReferenceProjectReference)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewComponentReferenceProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewComponentReferenceAnalyzerFile" />
		</MSBuild>
		<ItemGroup Condition="'@(_PurviewComponentReferenceAnalyzerFile)' != ''">
			<_PurviewSourceGeneratorAnalyzerFileRaw Include="@(_PurviewComponentReferenceAnalyzerFile)" />
		</ItemGroup>

		<RemoveDuplicates Inputs="@(_PurviewSourceGeneratorAnalyzerFileRaw)">
			<Output TaskParameter="Filtered" ItemName="_PurviewSourceGeneratorAnalyzerFile" />
		</RemoveDuplicates>

		<Error
			Code="PSGF0001"
			Condition="'@(_PurviewSourceGeneratorAnalyzerFile)' == ''"
			Text="The Roslyn component '$(MSBuildProjectName)' did not produce a source-generator analyzer assembly. Ensure IsRoslynComponent is true and the project builds successfully."
		/>
		<Error
			Code="PSGF0001"
			Condition="!Exists('%(_PurviewSourceGeneratorAnalyzerFile.Identity)')"
			Text="Source-generator analyzer file '%(_PurviewSourceGeneratorAnalyzerFile.Identity)' was not produced. Runtime dependencies must be declared as SourceGeneratorRuntimeDependency items so they can be copied beside the generator."
		/>
	</Target>

	<UsingTask
		TaskName="DeduplicateSourceGeneratorPackageFiles"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<DeduplicatedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					var results = new List<ITaskItem>();
					foreach (var file in Files ?? Array.Empty<ITaskItem>())
					{
						// Two analyzer projects can share a runtime dependency (for example a shared
						// support assembly). NuGet fails the pack on duplicate target paths, so keep
						// only the first file for each resolved analyzers/dotnet/cs package path.
						// The calling target re-applies PackagePath metadata afterwards.
						var packagePath = "analyzers/dotnet/cs/" + Path.GetFileName(file.ItemSpec);
						if (!seen.Add(packagePath))
							continue;

						results.Add(new TaskItem(file.ItemSpec));
					}
					DeduplicatedFiles = results.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="IncludeProjectReferencedSourceGenerators"
		Condition="'$(PackProjectReferencedSourceGenerators)' == 'true' AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Packs analyzer project references and their runtime dependencies automatically."
	>
		<ItemGroup>
			<_PurviewSourceGeneratorProjectReference
				Include="@(ProjectReference)"
				Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer' AND '%(ProjectReference.ReferenceOutputAssembly)' == 'false' AND '%(ProjectReference.Pack)' != 'false'"
			/>
		</ItemGroup>

		<MSBuild
			Projects="@(_PurviewSourceGeneratorProjectReference)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewSourceGeneratorProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewSourceGeneratorPackageFile" />
		</MSBuild>

		<DeduplicateSourceGeneratorPackageFiles
			Files="@(_PurviewSourceGeneratorPackageFile)"
			Condition="'@(_PurviewSourceGeneratorPackageFile)' != ''"
		>
			<Output TaskParameter="DeduplicatedFiles" ItemName="_PurviewDeduplicatedSourceGeneratorPackageFile" />
		</DeduplicateSourceGeneratorPackageFiles>

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_PurviewDeduplicatedSourceGeneratorPackageFile)">
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<NoDefaultExcludes Condition="'$(NoDefaultExcludes)' == '' AND '$(PurviewAutoSdkPack)' == 'true'"
			>true</NoDefaultExcludes>
	</PropertyGroup>

	<!-- =====================================================================
	     SDK .AGENTS FOLDER GITIGNORE GENERATION
	     Generates a .gitignore in each second-level folder of the Sdk/.agents
	     folder so that copied agent content (skills, prompts, agents, etc.)
	     ends up in the NuGet package with the correct ignore rules.
	     ===================================================================== -->
	<UsingTask
		TaskName="CreateSdkDotAgentsGitIgnoreFiles"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<AgentPackRoot ParameterType="System.String" Required="true" />
			<StagingRoot ParameterType="System.String" Required="true" />
			<GitIgnoreContent ParameterType="System.String" Required="true" />
			<GitIgnoreFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var files = new List<ITaskItem>();
					if (Directory.Exists(AgentPackRoot))
					{
						foreach (var firstLevelDir in Directory.GetDirectories(AgentPackRoot))
						{
							var firstLevelName = Path.GetFileName(firstLevelDir);
							foreach (var secondLevelDir in Directory.GetDirectories(firstLevelDir))
							{
								var secondLevelName = Path.GetFileName(secondLevelDir);
								var gitIgnorePath = Path.Combine(StagingRoot, firstLevelName, secondLevelName, ".gitignore");
								Directory.CreateDirectory(Path.GetDirectoryName(gitIgnorePath));
								File.WriteAllText(gitIgnorePath, GitIgnoreContent);
								var item = new TaskItem(gitIgnorePath);
								item.SetMetadata("PackagePath", ".agents/" + firstLevelName + "/" + secondLevelName + "/.gitignore");
								files.Add(item);
							}
						}
					}
					GitIgnoreFiles = files.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     DISCOVER PACKAGED AGENT FOLDERS
	     Reads project.assets.json to find every restored NuGet package (any
	     PackageReference, not just this SDK) that bundles its own .agents
	     folder at its package root - the same layout PurviewAutoSdkPack
	     produces for any packable project. Lets EnableAgentFolderInPackage
	     copy bundled agent content from every such package automatically.
	     ===================================================================== -->
	<UsingTask
		TaskName="DiscoverAgentPackageFolders"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<ProjectAssetsFile ParameterType="System.String" Required="true" />
			<NuGetPackageFolders ParameterType="System.String" Required="false" />
			<ExcludeFolder ParameterType="System.String" Required="false" />
			<AgentFolders ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var results = new List<ITaskItem>();
					if (File.Exists(ProjectAssetsFile))
					{
						var roots = (NuGetPackageFolders ?? string.Empty)
							.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
							.Select(root => root.TrimEnd('\\', '/'))
							.Where(root => root.Length > 0)
							.ToArray();
						var excludeFullPath = string.IsNullOrEmpty(ExcludeFolder) ? null : Path.GetFullPath(ExcludeFolder);

						// project.assets.json "libraries" entries are consistently emitted by NuGet as
						// "<id>/<version>": { "sha512": "...", "type": "package", "path": "<lowercase-id>/<version>", "files": [...] }
						var json = File.ReadAllText(ProjectAssetsFile);
						var libraryPattern = new Regex(
							"\"(?<id>[^\"/]+)/[^\"]+\"\\s*:\\s*\\{[^{}]*?\"type\"\\s*:\\s*\"package\"[^{}]*?\"path\"\\s*:\\s*\"(?<path>[^\"]+)\"",
							RegexOptions.Singleline
						);
						foreach (Match match in libraryPattern.Matches(json))
						{
							var libraryPath = match.Groups["path"].Value;
							if (string.IsNullOrEmpty(libraryPath))
								continue;

							var normalizedPath = libraryPath.Replace('/', Path.DirectorySeparatorChar);
							foreach (var root in roots)
							{
								var candidate = Path.GetFullPath(Path.Combine(root, normalizedPath, ".agents"));
								if (!Directory.Exists(candidate))
									continue;

								if (excludeFullPath != null && string.Equals(candidate, excludeFullPath, StringComparison.OrdinalIgnoreCase))
									break;

								var item = new TaskItem(candidate);
								item.SetMetadata("PackageId", match.Groups["id"].Value);
								results.Add(item);
								break;
							}
						}
					}
					AgentFolders = results.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     SHARED REPOSITORY DESTINATION COPY RETRIES
	     .agents content, .editorconfig and global.json are written by every
	     project in a solution, so several projects legitimately race for the
	     same destination and the built-in copy task's retry notice (MSB3026)
	     is pure noise. Retries still happen and a copy that never succeeds is
	     still reported - as an error by default, or a warning when the relevant
	     *FailureAsError property is false. Set PurviewSuppressCopyRetryWarnings
	     to false (project body or Directory.Build.props) to see every retry.

	     This lives in Sdk.targets rather than Sdk.props because targets are
	     imported after the project body, so the toggle honours values set in
	     the project file as well as earlier imports.
	     ===================================================================== -->
	<PropertyGroup Label="Shared repository copy retry diagnostics">
		<PurviewSuppressCopyRetryWarnings Condition="'$(PurviewSuppressCopyRetryWarnings)' == ''"
			>true</PurviewSuppressCopyRetryWarnings>
		<MSBuildWarningsAsMessages
			Condition="'$(PurviewSuppressCopyRetryWarnings)' != 'false' AND !$([System.String]::Copy('$(MSBuildWarningsAsMessages)').Contains('MSB3026'))"
			>$(MSBuildWarningsAsMessages);MSB3026</MSBuildWarningsAsMessages>
	</PropertyGroup>

	<!-- =====================================================================
	     REPOSITORY FILE SYNC
	     Copies SDK/package-provided files into shared repository locations
	     (.agents content, .editorconfig, global.json) without the failure modes
	     of the built-in Copy task:

	       * retry attempts are logged as low-importance messages instead of
	         MSB3026 warnings, and only the terminal failure is surfaced - as an
	         error by default, or a warning when the caller opts out,
	       * writes are staged into a temporary file in the destination directory
	         and renamed into place, so a reader never observes a partial file and
	         concurrent writers cannot interleave,
	       * unchanged content is skipped using a portable content fingerprint
	         (FNV-1a over raw bytes) recorded in a repository manifest, so a
	         republished package that keeps the same version still re-syncs,
	       * bootstrap files (WriteFile mode) are only written when missing by
	         default, which makes a lost race between parallel projects a no-op
	         instead of a build failure.

	     The copy logic deliberately avoids crypto, JSON and LINQ APIs so the
	     inline task compiles on both MSBuild flavours (Visual Studio's .NET
	     Framework MSBuild and the .NET SDK MSBuild) on Windows, Linux and macOS.
	     ===================================================================== -->
	<UsingTask
		TaskName="SyncPurviewRepositoryFiles"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<Mode ParameterType="System.String" Required="true" />
			<Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<DestinationRoot ParameterType="System.String" Required="false" />
			<DestinationFile ParameterType="System.String" Required="false" />
			<SourceFile ParameterType="System.String" Required="false" />
			<Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<ManifestPath ParameterType="System.String" Required="false" />
			<OverwriteExisting ParameterType="System.Boolean" Required="false" />
			<VerifyExistingContent ParameterType="System.Boolean" Required="false" />
			<Retries ParameterType="System.Int32" Required="false" />
			<RetryDelayMilliseconds ParameterType="System.Int32" Required="false" />
			<TreatFailureAsError ParameterType="System.Boolean" Required="false" />
			<UpToDate ParameterType="System.Boolean" Output="true" />
			<CopiedCount ParameterType="System.Int32" Output="true" />
			<SkippedCount ParameterType="System.Int32" Output="true" />
			<FailedCount ParameterType="System.Int32" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.Globalization" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Using Namespace="System.Threading" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var isMirror = string.Equals(Mode, "Mirror", StringComparison.OrdinalIgnoreCase);
					var attemptLimit = Retries > 0 ? Retries : 3;
					var retryDelay = RetryDelayMilliseconds > 0 ? RetryDelayMilliseconds : 500;
					var pathComparison = Path.DirectorySeparatorChar == '\\'
						? StringComparison.OrdinalIgnoreCase
						: StringComparison.Ordinal;

					var copied = 0;
					var skipped = 0;
					var failed = 0;
					var upToDate = false;

					bool IsTransient(Exception exception) =>
						exception is IOException || exception is UnauthorizedAccessException;

					bool IsPermanent(Exception exception) =>
						exception is ArgumentException
						|| exception is NotSupportedException
						|| exception is PathTooLongException
						|| exception is DirectoryNotFoundException;

					string NormalizeSlashes(string value) =>
						string.IsNullOrEmpty(value) ? string.Empty : value.Replace('\\', '/');

					ulong ComputeHash(byte[] bytes)
					{
						unchecked
						{
							// FNV-1a: dependency-free and identical on every platform, which
							// matters because the manifest outlives a single operating system.
							var hash = 14695981039346656037UL;
							foreach (var value in bytes)
							{
								hash ^= value;
								hash *= 1099511628211UL;
							}
							return hash;
						}
					}

					string ComputeFileHash(string path) =>
						ComputeHash(File.ReadAllBytes(path)).ToString("x16", CultureInfo.InvariantCulture);

					string GetRelativePath(string root, string file)
					{
						var rootFull = Path.GetFullPath(root);
						if (!rootFull.EndsWith(Path.DirectorySeparatorChar.ToString(), StringComparison.Ordinal))
							rootFull += Path.DirectorySeparatorChar;

						var fileFull = Path.GetFullPath(file);
						return fileFull.StartsWith(rootFull, pathComparison)
							? NormalizeSlashes(fileFull.Substring(rootFull.Length))
							: NormalizeSlashes(Path.GetFileName(fileFull));
					}

					void ClearReadOnlyAttribute(string path)
					{
						try
						{
							var attributes = File.GetAttributes(path);
							if ((attributes & FileAttributes.ReadOnly) == FileAttributes.ReadOnly)
								File.SetAttributes(path, attributes & ~FileAttributes.ReadOnly);
						}
						catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
						{
							// Reported by the retry loop when the write itself fails.
						}
					}

					bool FilesMatch(string first, string second)
					{
						var firstInfo = new FileInfo(first);
						var secondInfo = new FileInfo(second);
						if (!secondInfo.Exists || firstInfo.Length != secondInfo.Length)
							return false;

						return ComputeFileHash(first) == ComputeFileHash(second);
					}

					bool TextMatches(string first, string second)
					{
						try
						{
							// Line endings differ between checkouts (core.autocrlf, .gitattributes),
							// so drift detection compares normalized text.
							var firstText = File.ReadAllText(first).Replace("\r\n", "\n");
							var secondText = File.ReadAllText(second).Replace("\r\n", "\n");
							return string.Equals(firstText, secondText, StringComparison.Ordinal);
						}
						catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
						{
							return false;
						}
					}

					// Stage the write next to the destination so the final rename stays
					// on one volume and is atomic on Windows, Linux and macOS.
					void WriteAtomically(string destination, Action<string> writeTemporary)
					{
						var directory = Path.GetDirectoryName(destination);
						if (!string.IsNullOrEmpty(directory))
							Directory.CreateDirectory(directory);

						var temporary = destination + "." + Guid.NewGuid().ToString("N") + ".tmp";
						try
						{
							writeTemporary(temporary);

							if (File.Exists(destination))
							{
								ClearReadOnlyAttribute(destination);
								try
								{
									File.Replace(temporary, destination, null);
								}
								catch (Exception e) when (e is PlatformNotSupportedException || e is IOException)
								{
									// Some file systems reject Replace; overwrite in place instead
									// and let the retry loop report a genuinely locked destination.
									File.Copy(temporary, destination, true);
								}
							}
							else
							{
								File.Move(temporary, destination);
							}
						}
						finally
						{
							if (File.Exists(temporary))
							{
								try
								{
									File.Delete(temporary);
								}
								catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
								{
									// A leftover temp file is harmless; the next build reuses the name.
								}
							}
						}
					}

					void ReportFailure(string source, string destination, int attempts, string message)
					{
						failed++;
						if (TreatFailureAsError)
						{
							Log.LogError(
								"The Purview SDK could not copy '{0}' to '{1}' after {2} attempt(s): {3}",
								source,
								destination,
								attempts,
								message
							);
						}
						else
						{
							Log.LogWarning(
								"The Purview SDK could not copy '{0}' to '{1}' after {2} attempt(s): {3}",
								source,
								destination,
								attempts,
								message
							);
						}
					}

					bool Finish()
					{
						UpToDate = upToDate;
						CopiedCount = copied;
						SkippedCount = skipped;
						FailedCount = failed;
						return !Log.HasLoggedErrors;
					}

					if (isMirror)
					{
						var sources = Sources ?? Array.Empty<ITaskItem>();
						var destinationRoot = DestinationRoot ?? string.Empty;
						if (sources.Length == 0 || string.IsNullOrEmpty(destinationRoot))
						{
							upToDate = true;
							return Finish();
						}

						var manifestFile = ManifestPath ?? string.Empty;
						if (!string.IsNullOrEmpty(manifestFile))
						{
							// Keep the manifest folder invisible to Git without requiring any
							// consumer configuration; the folder contents are build artifacts.
							try
							{
								var manifestDirectory = Path.GetDirectoryName(manifestFile);
								if (!string.IsNullOrEmpty(manifestDirectory))
								{
									Directory.CreateDirectory(manifestDirectory);
									var ignoreFile = Path.Combine(manifestDirectory, ".gitignore");
									if (!File.Exists(ignoreFile))
										File.WriteAllText(ignoreFile, "*" + Environment.NewLine, new UTF8Encoding(false));
								}
							}
							catch (Exception e) when (IsTransient(e))
							{
								Log.LogMessage(
									MessageImportance.Low,
									"Could not prepare the agent sync manifest folder '{0}': {1}",
									manifestFile,
									e.Message
								);
							}
						}

						var previous = new Dictionary<string, string>(StringComparer.Ordinal);
						if (!string.IsNullOrEmpty(manifestFile) && File.Exists(manifestFile))
						{
							try
							{
								foreach (var line in File.ReadAllLines(manifestFile))
								{
									var parts = line.Split('|');
									if (parts.Length >= 6 && parts[0] == "file")
										previous[parts[1] + "|" + parts[2]] = parts[3] + "|" + parts[4] + "|" + parts[5];
								}
							}
							catch (Exception e) when (IsTransient(e))
							{
								Log.LogMessage(
									MessageImportance.Low,
									"Ignoring unreadable agent sync manifest '{0}': {1}",
									manifestFile,
									e.Message
								);
								previous.Clear();
							}
						}

						var groups = new HashSet<string>(StringComparer.Ordinal);
						var assets = new List<ITaskItem>();
						foreach (var source in sources)
						{
							var root = source.ItemSpec;
							if (string.IsNullOrEmpty(root) || !Directory.Exists(root))
								continue;

							var group = source.GetMetadata("ChangeGroup");
							if (string.IsNullOrEmpty(group))
								group = NormalizeSlashes(Path.GetFullPath(root));
							groups.Add(group);

							try
							{
								foreach (var file in Directory.GetFiles(root, "*", SearchOption.AllDirectories))
								{
									var relative = GetRelativePath(root, file);
									var asset = new TaskItem(file);
									asset.SetMetadata("PurviewGroup", group);
									asset.SetMetadata("PurviewRelativePath", relative);
									asset.SetMetadata(
										"PurviewDestination",
										Path.GetFullPath(
											Path.Combine(destinationRoot, relative.Replace('/', Path.DirectorySeparatorChar))
										)
									);
									assets.Add(asset);
								}
							}
							catch (Exception e) when (IsTransient(e))
							{
								ReportFailure(root, destinationRoot, attemptLimit, e.Message);
							}
						}

						var desired = new Dictionary<string, string>(StringComparer.Ordinal);
						foreach (var asset in assets)
						{
							var assetSource = asset.ItemSpec;
							var destination = asset.GetMetadata("PurviewDestination");
							var key = asset.GetMetadata("PurviewGroup") + "|" + asset.GetMetadata("PurviewRelativePath");

							string fingerprint;
							string hash;
							try
							{
								var info = new FileInfo(assetSource);
								var length = info.Length.ToString(CultureInfo.InvariantCulture);
								var ticks = info.LastWriteTimeUtc.Ticks.ToString(CultureInfo.InvariantCulture);
								fingerprint = length + "|" + ticks;

								var reuseCachedHash = false;
								if (previous.TryGetValue(key, out var prior))
								{
									var priorParts = prior.Split('|');
									// Only re-hash content when the cheap fingerprint moved. Hashing
									// is what detects an in-place republish that keeps the package
									// version and therefore may keep extraction timestamps.
									reuseCachedHash =
										priorParts.Length == 3
										&& string.Equals(priorParts[0], length, StringComparison.Ordinal)
										&& string.Equals(priorParts[1], ticks, StringComparison.Ordinal);
									if (reuseCachedHash)
										hash = priorParts[2];
									else
										hash = ComputeFileHash(assetSource);
								}
								else
								{
									hash = ComputeFileHash(assetSource);
								}
							}
							catch (Exception e) when (IsTransient(e))
							{
								ReportFailure(assetSource, destination, attemptLimit, e.Message);
								continue;
							}

							var value = fingerprint + "|" + hash;
							desired[key] = value;

							if (
								File.Exists(destination)
								&& previous.TryGetValue(key, out var previousValue)
								&& string.Equals(previousValue, value, StringComparison.Ordinal)
							)
							{
								skipped++;
								continue;
							}

							upToDate = false;
							for (var attempt = 1; attempt <= attemptLimit; attempt++)
							{
								try
								{
									if (File.Exists(destination) && FilesMatch(assetSource, destination))
									{
										// Another project or node already produced identical content,
										// so the race is a no-op rather than a failure.
										skipped++;
										break;
									}

									WriteAtomically(destination, temporary => File.Copy(assetSource, temporary, true));
									copied++;
									break;
								}
								catch (Exception e) when (IsTransient(e))
								{
									if (attempt < attemptLimit)
									{
										Log.LogMessage(
											MessageImportance.Low,
											"Retrying copy of '{0}' to '{1}' (attempt {2} of {3}): {4}",
											assetSource,
											destination,
											attempt + 1,
											attemptLimit,
											e.Message
										);
										Thread.Sleep(retryDelay + ((attempt - 1) * 100));
									}
									else
									{
										ReportFailure(assetSource, destination, attempt, e.Message);
									}
								}
								catch (Exception e) when (IsPermanent(e))
								{
									ReportFailure(assetSource, destination, attempt, e.Message);
									break;
								}
							}
						}

						if (!string.IsNullOrEmpty(manifestFile) && failed == 0)
						{
							var lines = new List<string> { "schema|1" };
							var counts = new Dictionary<string, int>(StringComparer.Ordinal);
							foreach (var pair in desired)
							{
								var separator = pair.Key.IndexOf('|');
								if (separator < 0)
									continue;

								var group = pair.Key.Substring(0, separator);
								counts[group] = counts.ContainsKey(group) ? counts[group] + 1 : 1;
								lines.Add("file|" + group + "|" + pair.Key.Substring(separator + 1) + "|" + pair.Value);
							}

							foreach (var group in groups)
								lines.Add("group|" + group + "|" + (counts.ContainsKey(group) ? counts[group] : 0));

							// Entries owned by another target (the packaged agent folders, for
							// example) are preserved so both targets can share one manifest.
							if (File.Exists(manifestFile))
							{
								try
								{
									foreach (var line in File.ReadAllLines(manifestFile))
									{
										var parts = line.Split('|');
										if (
											parts.Length >= 3
											&& (parts[0] == "file" || parts[0] == "group")
											&& !groups.Contains(parts[1])
										)
										{
											lines.Add(line);
										}
									}
								}
								catch (Exception e) when (IsTransient(e))
								{
									Log.LogMessage(
										MessageImportance.Low,
										"Could not preserve existing agent sync manifest entries: {0}",
										e.Message
									);
								}
							}

							// A no-op build must not touch repository files at all, so the
							// manifest is only written when its content actually changes.
							var manifestUpToDate = false;
							try
							{
								if (File.Exists(manifestFile))
								{
									var desiredManifest = new StringBuilder();
									foreach (var line in lines)
										desiredManifest.Append(line).Append('\n');

									manifestUpToDate = string.Equals(
										File.ReadAllText(manifestFile).Replace("\r\n", "\n"),
										desiredManifest.ToString(),
										StringComparison.Ordinal
									);
								}
							}
							catch (Exception e) when (IsTransient(e))
							{
								manifestUpToDate = false;
							}

							for (var attempt = 1; attempt <= attemptLimit && !manifestUpToDate; attempt++)
							{
								try
								{
									WriteAtomically(
										manifestFile,
										temporary => File.WriteAllLines(temporary, lines, new UTF8Encoding(false))
									);
									break;
								}
								catch (Exception e) when (IsTransient(e))
								{
									if (attempt < attemptLimit)
									{
										Thread.Sleep(retryDelay);
									}
									else
									{
										Log.LogMessage(
											MessageImportance.Low,
											"Could not update the agent sync manifest '{0}': {1}",
											manifestFile,
											e.Message
										);
									}
								}
							}
						}

						upToDate = upToDate || copied == 0;
						Log.LogMessage(
							MessageImportance.Low,
							"Purview .agents sync: {0} copied, {1} unchanged, {2} failed.",
							copied,
							skipped,
							failed
						);
						return Finish();
					}

					var destinationFile = DestinationFile ?? string.Empty;
					if (string.IsNullOrEmpty(destinationFile))
					{
						upToDate = true;
						return Finish();
					}

					if (File.Exists(destinationFile))
					{
						if (!OverwriteExisting)
						{
							// Bootstraps are user-owned: an existing file is never touched, which
							// turns a lost race between parallel projects into a no-op.
							if (
								VerifyExistingContent
								&& !string.IsNullOrEmpty(SourceFile)
								&& File.Exists(SourceFile)
								&& !TextMatches(destinationFile, SourceFile)
							)
							{
								Log.LogWarning(
									"'{0}' already exists and was left untouched, but it differs from the SDK-provided '{1}'. Set PurviewRepoBootstrapMode=Always to overwrite it.",
									destinationFile,
									SourceFile
								);
							}

							skipped++;
							upToDate = true;
							return Finish();
						}

						if (!string.IsNullOrEmpty(SourceFile) && File.Exists(SourceFile) && FilesMatch(SourceFile, destinationFile))
						{
							skipped++;
							upToDate = true;
							return Finish();
						}
					}

					byte[] content;
					var lineItems = Lines ?? Array.Empty<ITaskItem>();
					var sourceDescription = string.IsNullOrEmpty(SourceFile) ? "generated content" : SourceFile;
					if (!string.IsNullOrEmpty(SourceFile) && File.Exists(SourceFile))
					{
						content = File.ReadAllBytes(SourceFile);
					}
					else if (lineItems.Length > 0)
					{
						var builder = new StringBuilder();
						foreach (var line in lineItems)
							builder.Append(line.ItemSpec).Append(Environment.NewLine);
						content = new UTF8Encoding(false).GetBytes(builder.ToString());
					}
					else if (!string.IsNullOrEmpty(SourceFile))
					{
						ReportFailure(sourceDescription, destinationFile, attemptLimit, "the source file does not exist");
						return Finish();
					}
					else
					{
						upToDate = true;
						return Finish();
					}

					for (var attempt = 1; attempt <= attemptLimit; attempt++)
					{
						try
						{
							WriteAtomically(destinationFile, temporary => File.WriteAllBytes(temporary, content));
							copied++;
							upToDate = true;
							break;
						}
						catch (Exception e) when (IsTransient(e))
						{
							if (attempt < attemptLimit)
							{
								Log.LogMessage(
									MessageImportance.Low,
									"Retrying bootstrap write of '{0}' (attempt {1} of {2}): {3}",
									destinationFile,
									attempt + 1,
									attemptLimit,
									e.Message
								);
								Thread.Sleep(retryDelay + ((attempt - 1) * 100));
							}
							else
							{
								ReportFailure(sourceDescription, destinationFile, attempt, e.Message);
							}
						}
						catch (Exception e) when (IsPermanent(e))
						{
							ReportFailure(sourceDescription, destinationFile, attempt, e.Message);
							break;
						}
					}

					Log.LogMessage(
						MessageImportance.Low,
						"Purview repository bootstrap: '{0}' {1}, {2} skipped, {3} failed.",
						destinationFile,
						copied > 0 ? "written" : "unchanged",
						skipped,
						failed
					);

					// This fragment deliberately ends without a return statement: the code task
					// factory appends its own success return, so ending on a return here would
					// make that generated statement unreachable (CS0162). Logged errors still
					// fail the target, and the explicit check below keeps the task contract.
					Finish();
					if (Log.HasLoggedErrors)
					{
						return false;
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     FIX ROOT NAMESPACE
	     Strips known suffixes from RootNamespace. @(NamespaceRemoveSuffix) only
	     expands inside a Target (after static item evaluation), so the regex
	     cannot be computed in a static PropertyGroup.
	     ===================================================================== -->
	<Target
		Name="FixRootNamespaceTarget"
		BeforeTargets="GenerateAssemblyInfoClassTarget;GenerateGlobalUsings"
		Condition="'$(IsCSharpProject)' == 'true'"
		Label="Strips known suffixes from RootNamespace."
	>
		<PropertyGroup>
			<_NsRemovePattern>@(NamespaceRemoveSuffix, '|')</_NsRemovePattern>
			<_FixedRootNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(RootNamespace)', '\.(?:$(_NsRemovePattern))(?=\.|$)', ''))</_FixedRootNamespace>
		</PropertyGroup>
		<ItemGroup Condition="'$(RootNamespace)' != '$(_FixedRootNamespace)'">
			<Using Remove="$(RootNamespace)" />
			<Using Include="$(_FixedRootNamespace)" />
		</ItemGroup>
		<PropertyGroup Condition="'$(RootNamespace)' != '$(_FixedRootNamespace)'">
			<RootNamespace>$(_FixedRootNamespace)</RootNamespace>
		</PropertyGroup>
	</Target>

	<!-- =====================================================================
	     VALIDATE NAMESPACE PREFIX
	     Errors the build if NamespacePrefix is not set.
	     Disable with <DisableNamespacePrefixCheck>true</DisableNamespacePrefixCheck>.
	     ===================================================================== -->
	<Target
		Name="ResolvePurviewRepoBootstrapModeTarget"
		Label="Maps PurviewRepoBootstrapMode onto the repository file sync overwrite and drift-check switches."
	>
		<PropertyGroup>
			<_PurviewRepoBootstrapOverwriteExisting Condition="'$(PurviewRepoBootstrapMode)' == 'Always'"
				>true</_PurviewRepoBootstrapOverwriteExisting>
			<_PurviewRepoBootstrapVerifyExistingContent Condition="'$(PurviewRepoBootstrapMode)' == 'WarnOnDrift'"
				>true</_PurviewRepoBootstrapVerifyExistingContent>
			<_PurviewRepoBootstrapOverwriteExisting Condition="'$(_PurviewRepoBootstrapOverwriteExisting)' == ''"
				>false</_PurviewRepoBootstrapOverwriteExisting>
			<_PurviewRepoBootstrapVerifyExistingContent
				Condition="'$(_PurviewRepoBootstrapVerifyExistingContent)' == ''"
				>false</_PurviewRepoBootstrapVerifyExistingContent>
		</PropertyGroup>
	</Target>

	<Target
		Name="EnsureRepositoryEditorConfigTarget"
		BeforeTargets="PrepareForBuild"
		DependsOnTargets="ResolvePurviewRepoBootstrapModeTarget"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableAutoCopySdkFiles)' != 'true' AND '$(BootstrapEditorConfigToRepoRoot)' == 'true' AND '$(PurviewRepoBootstrapMode)' != 'Never' AND Exists('$(EditorConfigFilePath)')"
		Label="Bootstraps a physical .editorconfig at the repo root for external tooling."
	>
		<PropertyGroup>
			<_DirectoryBuildPropsDirectory>$([System.IO.Path]::GetDirectoryName('$(DirectoryBuildPropsPath)'))</_DirectoryBuildPropsDirectory>
		</PropertyGroup>
		<Exec
			Command="git -C &quot;$(_DirectoryBuildPropsDirectory)&quot; rev-parse --show-toplevel"
			ConsoleToMSBuild="true"
			IgnoreExitCode="true"
			IgnoreStandardErrorWarningFormat="true"
			StandardErrorImportance="low"
			StandardOutputImportance="low"
			Condition="'$(RepositoryEditorConfigFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
		>
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitRepositoryRoot" />
		</Exec>
		<PropertyGroup>
			<_GitRepositoryRoot>$([System.String]::Copy('$(_GitRepositoryRoot)').Trim())</_GitRepositoryRoot>
			<_RepositoryProbe0>$(_DirectoryBuildPropsDirectory)</_RepositoryProbe0>
			<_RepositoryProbe1>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe0)\..'))</_RepositoryProbe1>
			<_RepositoryProbe2>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe1)\..'))</_RepositoryProbe2>
			<_RepositoryProbe3>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe2)\..'))</_RepositoryProbe3>
			<_RepositoryProbe4>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe3)\..'))</_RepositoryProbe4>
			<_DetectedRepositoryRoot Condition="'$(_GitRepositoryRoot)' != '' AND Exists('$(_GitRepositoryRoot)')"
				>$(_GitRepositoryRoot)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe0)/.git/HEAD') OR Exists('$(_RepositoryProbe0)/.git'))"
				>$(_RepositoryProbe0)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe1)/.git/HEAD') OR Exists('$(_RepositoryProbe1)/.git'))"
				>$(_RepositoryProbe1)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe2)/.git/HEAD') OR Exists('$(_RepositoryProbe2)/.git'))"
				>$(_RepositoryProbe2)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe3)/.git/HEAD') OR Exists('$(_RepositoryProbe3)/.git'))"
				>$(_RepositoryProbe3)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe4)/.git/HEAD') OR Exists('$(_RepositoryProbe4)/.git'))"
				>$(_RepositoryProbe4)</_DetectedRepositoryRoot>
			<_EffectiveRepositoryEditorConfigFilePath>$(RepositoryEditorConfigFilePath)</_EffectiveRepositoryEditorConfigFilePath>
			<_EffectiveRepositoryEditorConfigFilePath
				Condition="'$(_EffectiveRepositoryEditorConfigFilePath)' == '' AND '$(_DetectedRepositoryRoot)' != ''"
				>$([System.IO.Path]::Combine('$(_DetectedRepositoryRoot)', '.editorconfig'))</_EffectiveRepositoryEditorConfigFilePath>
			<_EffectiveRepositoryEditorConfigFilePath
				Condition="'$(_EffectiveRepositoryEditorConfigFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
				>$([System.IO.Path]::Combine('$(_DirectoryBuildPropsDirectory)', '.editorconfig'))</_EffectiveRepositoryEditorConfigFilePath>
			<_RepositoryEditorConfigDirectory>$([System.IO.Path]::GetDirectoryName('$(_EffectiveRepositoryEditorConfigFilePath)'))</_RepositoryEditorConfigDirectory>
		</PropertyGroup>
		<PropertyGroup>
			<RepositoryEditorConfigFilePath
				Condition="'$(RepositoryEditorConfigFilePath)' == '' AND '$(_EffectiveRepositoryEditorConfigFilePath)' != ''"
				>$(_EffectiveRepositoryEditorConfigFilePath)</RepositoryEditorConfigFilePath>
		</PropertyGroup>
		<SyncPurviewRepositoryFiles
			Mode="WriteFile"
			DestinationFile="$(_EffectiveRepositoryEditorConfigFilePath)"
			SourceFile="$(EditorConfigFilePath)"
			OverwriteExisting="$(_PurviewRepoBootstrapOverwriteExisting)"
			VerifyExistingContent="$(_PurviewRepoBootstrapVerifyExistingContent)"
			Retries="$(PurviewRepoBootstrapCopyRetries)"
			RetryDelayMilliseconds="$(PurviewRepoBootstrapCopyRetryDelayMilliseconds)"
			TreatFailureAsError="$(PurviewRepoBootstrapCopyFailureAsError)"
			Condition="'$(_EffectiveRepositoryEditorConfigFilePath)' != ''"
		/>
	</Target>

	<Target
		Name="ResolveAgentPackDestinationRootTarget"
		DependsOnTargets="InitializeSourceControlInformation"
		Condition="'$(EnableAgentFolderInPackage)' != 'false' AND '$(_PurviewAgentFolderDestinationRoot)' == ''"
		Label="Resolves the repo-relative destination root used when copying bundled .agents folders."
	>
		<ItemGroup>
			<_PurviewAgentSourceRoot Include="@(SourceRoot -> WithMetadataValue('SourceControl', 'git'))" />
		</ItemGroup>
		<PropertyGroup>
			<_PurviewAgentFolderRepoRoot Condition="'$(RepoRoot)' != ''">$(RepoRoot)</_PurviewAgentFolderRepoRoot>
			<_PurviewAgentFolderAgentsMd Condition="'$(_PurviewAgentFolderRepoRoot)' == ''"
				>$([MSBuild]::GetPathOfFileAbove('AGENTS.md', '$(MSBuildProjectDirectory)'))</_PurviewAgentFolderAgentsMd>
			<_PurviewAgentFolderRepoRoot
				Condition="'$(_PurviewAgentFolderRepoRoot)' == '' AND '$(_PurviewAgentFolderAgentsMd)' != ''"
				>$([System.IO.Path]::GetDirectoryName('$(_PurviewAgentFolderAgentsMd)'))\</_PurviewAgentFolderRepoRoot>
			<_PurviewAgentFolderRepoRoot Condition="'$(_PurviewAgentFolderRepoRoot)' == ''"
				>@(_PurviewAgentSourceRoot)</_PurviewAgentFolderRepoRoot>
			<_PurviewAgentFolderDestinationRoot Condition="'$(_PurviewAgentFolderRepoRoot)' != ''"
				>$([MSBuild]::NormalizePath('$(_PurviewAgentFolderRepoRoot)', '$(AgentPackDestinationFolder)'))</_PurviewAgentFolderDestinationRoot>
		</PropertyGroup>
	</Target>

	<Target
		Name="ResolveAgentSyncManifestPathTarget"
		DependsOnTargets="ResolveAgentPackDestinationRootTarget"
		Condition="'$(EnableAgentFolderInPackage)' != 'false' AND '$(_PurviewAgentSyncManifestPath)' == ''"
		Label="Resolves the change-detection manifest used to skip unchanged .agents syncs."
	>
		<PropertyGroup Condition="'$(_PurviewAgentFolderRepoRoot)' != ''">
			<_PurviewAgentSyncManifestPath>$([MSBuild]::NormalizePath('$(_PurviewAgentFolderRepoRoot)', '.purview', 'agent-sync.cache'))</_PurviewAgentSyncManifestPath>
		</PropertyGroup>
		<PropertyGroup Condition="'$(PurviewAgentSyncManifestPath)' != ''">
			<_PurviewAgentSyncManifestPath>$(PurviewAgentSyncManifestPath)</_PurviewAgentSyncManifestPath>
		</PropertyGroup>
	</Target>

	<Target
		Name="EnsureAgentFolderInPackageTarget"
		BeforeTargets="PrepareForBuild"
		DependsOnTargets="ResolveAgentPackDestinationRootTarget;ResolveAgentSyncManifestPathTarget"
		Condition="'$(EnableAgentFolderInPackage)' != 'false' AND Exists('$(PurviewAgentFolderSourcePath)') AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Copies the bundled .agents folder into the consuming repository for agent discovery."
	>
		<ItemGroup Condition="'$(_PurviewAgentFolderDestinationRoot)' != ''">
			<_PurviewAgentFolderSyncSource Include="$(PurviewAgentFolderSourcePath)">
				<ChangeGroup>sdk:$(PurviewBuildSdkVersionForGlobalJson)</ChangeGroup>
			</_PurviewAgentFolderSyncSource>
		</ItemGroup>
		<SyncPurviewRepositoryFiles
			Mode="Mirror"
			Sources="@(_PurviewAgentFolderSyncSource)"
			DestinationRoot="$(_PurviewAgentFolderDestinationRoot)"
			ManifestPath="$(_PurviewAgentSyncManifestPath)"
			Retries="$(PurviewAgentFolderCopyRetries)"
			RetryDelayMilliseconds="$(PurviewAgentFolderCopyRetryDelayMilliseconds)"
			TreatFailureAsError="$(PurviewAgentFolderCopyFailureAsError)"
			Condition="'@(_PurviewAgentFolderSyncSource)' != '' AND '$(_PurviewAgentFolderDestinationRoot)' != ''"
		>
			<Output TaskParameter="UpToDate" PropertyName="_PurviewAgentFolderUpToDate" />
			<Output TaskParameter="CopiedCount" PropertyName="_PurviewAgentFolderCopiedCount" />
		</SyncPurviewRepositoryFiles>
		<Message
			Condition="'$(_PurviewAgentFolderUpToDate)' == 'true'"
			Importance="Low"
			Text="Bundled .agents content is already in sync with '$(_PurviewAgentFolderDestinationRoot)'."
		/>
	</Target>

	<Target
		Name="CopyPackagedAgentFoldersTarget"
		BeforeTargets="PrepareForBuild"
		DependsOnTargets="ResolveAgentPackDestinationRootTarget;ResolveAgentSyncManifestPathTarget"
		Condition="'$(EnableAgentFolderInPackage)' != 'false' AND '$(_PurviewAgentFolderDestinationRoot)' != '' AND Exists('$(ProjectAssetsFile)') AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Copies bundled .agents folders shipped by any restored NuGet package (via PurviewAutoSdkPack) into the consuming repository."
	>
		<DiscoverAgentPackageFolders
			ProjectAssetsFile="$(ProjectAssetsFile)"
			NuGetPackageFolders="$(NuGetPackageFolders)"
			ExcludeFolder="$([System.IO.Path]::GetFullPath('$(PurviewAgentFolderSourcePath)'))"
		>
			<Output TaskParameter="AgentFolders" ItemName="_PurviewPackagedAgentFolder" />
		</DiscoverAgentPackageFolders>
		<ItemGroup Condition="'@(_PurviewPackagedAgentFolder)' != ''">
			<_PurviewPackagedAgentFolderSyncSource Include="@(_PurviewPackagedAgentFolder)">
				<ChangeGroup>package:%(PackageId)</ChangeGroup>
			</_PurviewPackagedAgentFolderSyncSource>
		</ItemGroup>
		<SyncPurviewRepositoryFiles
			Mode="Mirror"
			Sources="@(_PurviewPackagedAgentFolderSyncSource)"
			DestinationRoot="$(_PurviewAgentFolderDestinationRoot)"
			ManifestPath="$(_PurviewAgentSyncManifestPath)"
			Retries="$(PurviewAgentFolderCopyRetries)"
			RetryDelayMilliseconds="$(PurviewAgentFolderCopyRetryDelayMilliseconds)"
			TreatFailureAsError="$(PurviewAgentFolderCopyFailureAsError)"
			Condition="'@(_PurviewPackagedAgentFolderSyncSource)' != ''"
		/>
	</Target>

	<Target
		Name="IncludeLinkedSdkFiles"
		Condition="'$(PurviewAutoSdkPack)' == 'true' AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Packs external files linked beneath Sdk/ using the same paths as physical Sdk files."
	>
		<ItemGroup>
			<_PurviewLinkedSdkFile
				Include="@(None)"
				Condition="$([System.String]::Copy('%(None.Link)').StartsWith('Sdk\')) OR $([System.String]::Copy('%(None.Link)').StartsWith('Sdk/'))"
			>
				<PackagePath>$([System.String]::Copy('%(None.Link)').Substring(4).Replace('\', '/'))</PackagePath>
			</_PurviewLinkedSdkFile>
			<TfmSpecificPackageFile Include="@(_PurviewLinkedSdkFile)" />
		</ItemGroup>
	</Target>

	<Target
		Name="IncludeSdkDotAgentsGitIgnoreFiles"
		DependsOnTargets="InitializeSourceControlInformation"
		Condition="'$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)'"
		Label="Generates .gitignore files for each second-level folder under Sdk/.agents and includes them in the package."
	>
		<PropertyGroup>
			<_PurviewSdkDotAgentsRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'Sdk', '.agents'))</_PurviewSdkDotAgentsRoot>
			<_PurviewSdkDotAgentsGitIgnoreStagingRoot>$([MSBuild]::NormalizePath('$(IntermediateOutputPath)', '_PurviewSdkDotAgentsGitIgnores'))</_PurviewSdkDotAgentsGitIgnoreStagingRoot>
		</PropertyGroup>
		<RemoveDir
			Directories="$(_PurviewSdkDotAgentsGitIgnoreStagingRoot)"
			Condition="'$(_PurviewSdkDotAgentsGitIgnoreStagingRoot)' != ''"
		/>
		<CreateSdkDotAgentsGitIgnoreFiles
			AgentPackRoot="$(_PurviewSdkDotAgentsRoot)"
			StagingRoot="$(_PurviewSdkDotAgentsGitIgnoreStagingRoot)"
			GitIgnoreContent="# Ignore all files%0a*%0a%0a# Don't ignore directories, so Git can traverse them%0a!*/%0a%0a# Keep this file%0a!.gitignore"
			Condition="Exists('$(_PurviewSdkDotAgentsRoot)')"
		>
			<Output TaskParameter="GitIgnoreFiles" ItemName="_PurviewSdkDotAgentsGitIgnoreFiles" />
		</CreateSdkDotAgentsGitIgnoreFiles>
		<ItemGroup Condition="Exists('$(_PurviewSdkDotAgentsRoot)')">
			<TfmSpecificPackageFile Include="@(_PurviewSdkDotAgentsGitIgnoreFiles)">
				<PackagePath>%(PackagePath)</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!-- =====================================================================
	     REPOSITORY README PACKAGING
	     Packs the repository-root README for packable projects when the file
	     exists and PackageReadmeFile has not been explicitly configured.
	     Skips when a README-named file is already being packed so no duplicate
	     packed README items are produced.
	     ===================================================================== -->
	<Target
		Name="IncludeRepoReadmeInPackage"
		DependsOnTargets="IncludeLinkedSdkFiles;IncludeSdkDotAgentsGitIgnoreFiles"
		Condition="'$(IsPackable)' == 'true' AND '$(PackageReadmeFile)' == 'README.md' AND '$(RepoRoot)' != '' AND Exists('$(RepoRoot)/README.md') AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Packs the repository-root README when present and PackageReadmeFile is unset."
	>
		<ItemGroup>
			<_PurviewPackedReadme
				Include="@(None)"
				Condition="'%(None.Pack)' == 'true' AND $([System.String]::Copy('%(None.Filename)').ToLowerInvariant()) == 'readme'"
			/>
			<_PurviewPackedReadme
				Include="@(None)"
				Condition="($([System.String]::Copy('%(None.Link)').ToLowerInvariant()) == 'sdk/readme.md' OR $([System.String]::Copy('%(None.Link)').ToLowerInvariant()) == 'sdk\readme.md')"
			/>
			<_PurviewPackedReadme
				Include="@(TfmSpecificPackageFile)"
				Condition="$([System.String]::Copy('%(TfmSpecificPackageFile.Filename)').ToLowerInvariant()) == 'readme'"
			/>
		</ItemGroup>
		<ItemGroup Condition="'@(_PurviewPackedReadme)' == ''">
			<TfmSpecificPackageFile Include="$(RepoRoot)/README.md">
				<PackagePath>/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!-- 
		VALIDATE Testing Framework.
	-->
	<Target Name="ValidateTestingFramework" BeforeTargets="Build;Restore;Pack">
		<Error
			Condition="
				'$(_TestingFrameworkNormalized)' != '' AND
				'$(_TestingFrameworkNormalized)' != 'none' AND
				'$(_TestingFrameworkNormalized)' != 'tunit' AND
				'$(_TestingFrameworkNormalized)' != 'xunit'"
			Text="Invalid TestingFramework value '$(TestingFramework)'. Supported values are: None, Xunit, and TUnit (default)."
		/>
	</Target>

	<!-- 
		VALIDATE Substitution Framework.
	-->
	<Target Name="ValidateSubstituteFramework" BeforeTargets="Build;Restore;Pack">
		<Error
			Condition="
				'$(_SubstituteFrameworkNormalized)' != '' AND
				'$(_SubstituteFrameworkNormalized)' != 'none' AND
				'$(_SubstituteFrameworkNormalized)' != 'nsubstitute' AND
				'$(_SubstituteFrameworkNormalized)' != 'tunitmocks'"
			Text="Invalid SubstituteFramework value '$(SubstituteFramework)'. Supported values are: None, NSubstitute, and TUnitMocks (default)."
		/>
	</Target>

	<!-- 
		VALIDATE Testing Data Framework.
	-->
	<Target Name="ValidateTestingDataFramework" BeforeTargets="Build;Restore;Pack">
		<Error
			Condition="
				'$(_TestDataFrameworkNormalized)' != '' AND
				'$(_TestDataFrameworkNormalized)' != 'none' AND
				'$(_TestDataFrameworkNormalized)' != 'bogus'"
			Text="Invalid TestDataFramework value '$(TestDataFramework)'. Supported values are: None, and Bogus (default)."
		/>
	</Target>

	<Target
		Name="EnsureRepositoryGlobalJsonTarget"
		BeforeTargets="PrepareForBuild"
		DependsOnTargets="ResolvePurviewRepoBootstrapModeTarget"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableAutoCopySdkFiles)' != 'true' AND '$(BootstrapGlobalJsonToRepoRoot)' == 'true' AND '$(PurviewRepoBootstrapMode)' != 'Never'"
		Label="Bootstraps a physical global.json at the repo root for SDK/tool resolution."
	>
		<PropertyGroup>
			<_DirectoryBuildPropsDirectory>$([System.IO.Path]::GetDirectoryName('$(DirectoryBuildPropsPath)'))</_DirectoryBuildPropsDirectory>
		</PropertyGroup>
		<Exec
			Command="git -C &quot;$(_DirectoryBuildPropsDirectory)&quot; rev-parse --show-toplevel"
			ConsoleToMSBuild="true"
			IgnoreExitCode="true"
			IgnoreStandardErrorWarningFormat="true"
			StandardErrorImportance="low"
			StandardOutputImportance="low"
			Condition="'$(RepositoryGlobalJsonFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
		>
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitRepositoryRoot" />
		</Exec>
		<PropertyGroup>
			<_GitRepositoryRoot>$([System.String]::Copy('$(_GitRepositoryRoot)').Trim())</_GitRepositoryRoot>
			<_RepositoryProbe0>$(_DirectoryBuildPropsDirectory)</_RepositoryProbe0>
			<_RepositoryProbe1>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe0)\..'))</_RepositoryProbe1>
			<_RepositoryProbe2>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe1)\..'))</_RepositoryProbe2>
			<_RepositoryProbe3>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe2)\..'))</_RepositoryProbe3>
			<_RepositoryProbe4>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe3)\..'))</_RepositoryProbe4>
			<_DetectedRepositoryRoot Condition="'$(_GitRepositoryRoot)' != '' AND Exists('$(_GitRepositoryRoot)')"
				>$(_GitRepositoryRoot)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe0)/.git/HEAD') OR Exists('$(_RepositoryProbe0)/.git'))"
				>$(_RepositoryProbe0)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe1)/.git/HEAD') OR Exists('$(_RepositoryProbe1)/.git'))"
				>$(_RepositoryProbe1)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe2)/.git/HEAD') OR Exists('$(_RepositoryProbe2)/.git'))"
				>$(_RepositoryProbe2)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe3)/.git/HEAD') OR Exists('$(_RepositoryProbe3)/.git'))"
				>$(_RepositoryProbe3)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe4)/.git/HEAD') OR Exists('$(_RepositoryProbe4)/.git'))"
				>$(_RepositoryProbe4)</_DetectedRepositoryRoot>
			<_EffectiveRepositoryGlobalJsonFilePath>$(RepositoryGlobalJsonFilePath)</_EffectiveRepositoryGlobalJsonFilePath>
			<_EffectiveRepositoryGlobalJsonFilePath
				Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' == '' AND '$(_DetectedRepositoryRoot)' != ''"
				>$([System.IO.Path]::Combine('$(_DetectedRepositoryRoot)', 'global.json'))</_EffectiveRepositoryGlobalJsonFilePath>
			<_EffectiveRepositoryGlobalJsonFilePath
				Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
				>$([System.IO.Path]::Combine('$(_DirectoryBuildPropsDirectory)', 'global.json'))</_EffectiveRepositoryGlobalJsonFilePath>
			<_RepositoryGlobalJsonDirectory>$([System.IO.Path]::GetDirectoryName('$(_EffectiveRepositoryGlobalJsonFilePath)'))</_RepositoryGlobalJsonDirectory>
		</PropertyGroup>
		<PropertyGroup>
			<RepositoryGlobalJsonFilePath
				Condition="'$(RepositoryGlobalJsonFilePath)' == '' AND '$(_EffectiveRepositoryGlobalJsonFilePath)' != ''"
				>$(_EffectiveRepositoryGlobalJsonFilePath)</RepositoryGlobalJsonFilePath>
		</PropertyGroup>
		<ItemGroup Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' != ''">
			<_RepositoryGlobalJsonLines Include="{" />
			<_RepositoryGlobalJsonLines Include="  &quot;test&quot;: {" />
			<_RepositoryGlobalJsonLines Include="    &quot;runner&quot;: &quot;Microsoft.Testing.Platform&quot;" />
			<_RepositoryGlobalJsonLines Include="  }," />
			<_RepositoryGlobalJsonLines Include="  &quot;msbuild-sdks&quot;: {" />
			<_RepositoryGlobalJsonLines Include="    &quot;Purview.BuildSdk&quot;: &quot;$(PurviewBuildSdkVersionForGlobalJson)&quot;" />
			<_RepositoryGlobalJsonLines Include="  }" />
			<_RepositoryGlobalJsonLines Include="}" />
		</ItemGroup>
		<SyncPurviewRepositoryFiles
			Mode="WriteFile"
			DestinationFile="$(_EffectiveRepositoryGlobalJsonFilePath)"
			Lines="@(_RepositoryGlobalJsonLines)"
			OverwriteExisting="$(_PurviewRepoBootstrapOverwriteExisting)"
			VerifyExistingContent="$(_PurviewRepoBootstrapVerifyExistingContent)"
			Retries="$(PurviewRepoBootstrapCopyRetries)"
			RetryDelayMilliseconds="$(PurviewRepoBootstrapCopyRetryDelayMilliseconds)"
			TreatFailureAsError="$(PurviewRepoBootstrapCopyFailureAsError)"
			Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' != ''"
		/>
	</Target>

	<Target
		Name="ValidateRootNamespacePrefixTarget"
		BeforeTargets="Compile"
		Label="Validates the NamespacePrefix property is set."
		Condition="'$(DisableNamespacePrefixCheck)' != 'true'"
	>
		<Error
			Text="The NamespacePrefix property has not been set. To fix, set the `NamespacePrefix` in the `PropertyGroup` of either the .csproj file, or a Directory.Build.props file. You can disable this check by setting 'DisableNamespacePrefixCheck' to 'true'."
			ContinueOnError="false"
			Condition="'$(NamespacePrefix)' == ''"
			Code="NamespacePrefixNotSet"
			File="$(MSBuildProjectFile)"
		/>
	</Target>

	<!--<Target
		Name="ValidateTestingFrameworkConfigurationTarget"
		BeforeTargets="PrepareForBuild"
		Label="Validates testing framework configuration values."
		Condition="'$(IsCSharpProject)' == 'true'"
	>
		<PropertyGroup>
			<_AllowedTestingFrameworks>;TUnit;Xunit;None;</_AllowedTestingFrameworks>
			<_AllowedSubstituteFrameworks>;TUnitMocks;NSubstitute;None;</_AllowedSubstituteFrameworks>
			<_AllowedTestDataFrameworks>;Bogus;None;</_AllowedTestDataFrameworks>
		</PropertyGroup>
		<Error
			Text="Invalid TestingFramework '$(TestingFramework)'. Supported values: TUnit, Xunit, None."
			Condition="$([System.String]::Copy('$(_AllowedTestingFrameworks)').Contains(';$(TestingFramework);')) != 'True'"
			Code="PurviewInvalidTestingFramework"
			File="$(MSBuildProjectFile)"
		/>
		<Error
			Text="Invalid SubstituteFramework '$(SubstituteFramework)'. Supported values: TUnitMocks, NSubstitute, None."
			Condition="$([System.String]::Copy('$(_AllowedSubstituteFrameworks)').Contains(';$(SubstituteFramework);')) != 'True'"
			Code="PurviewInvalidSubstituteFramework"
			File="$(MSBuildProjectFile)"
		/>
		<Error
			Text="Invalid TestDataFramework '$(TestDataFramework)'. Supported values: Bogus, None."
			Condition="$([System.String]::Copy('$(_AllowedTestDataFrameworks)').Contains(';$(TestDataFramework);')) != 'True'"
			Code="PurviewInvalidTestDataFramework"
			File="$(MSBuildProjectFile)"
		/>
	</Target>-->

	<Target
		Name="ValidateProjectFileNamingConventionTarget"
		BeforeTargets="PrepareForBuild"
		Label="Validates the physical project directory and file naming convention."
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableProjectFileNamingConventionCheck)' != 'true'"
	>
		<PropertyGroup>
			<_PurviewProjectDirectoryName>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</_PurviewProjectDirectoryName>
			<_PurviewProjectFileNameWithoutExtension>$([System.IO.Path]::GetFileNameWithoutExtension('$(MSBuildProjectFile)'))</_PurviewProjectFileNameWithoutExtension>
		</PropertyGroup>
		<Error
			Text="Project naming convention violation: expected the .csproj filename to match its directory name. Directory '$(_PurviewProjectDirectoryName)' must contain '$(_PurviewProjectDirectoryName).csproj', but found '$(MSBuildProjectFile)'."
			ContinueOnError="false"
			Condition="'$(_PurviewProjectDirectoryName)' != '$(_PurviewProjectFileNameWithoutExtension)'"
			Code="PurviewProjectFileNameMismatch"
			File="$(MSBuildProjectFile)"
		/>
	</Target>

	<!-- =====================================================================
	     INTERNALS VISIBLE TO
	     Generates InternalsVisibleToAttribute for Non-Test Projects based on
	     the defined TestType items so test projects can access internals.
	     Can be disabled by setting DisableAutoInternalsVisibleTo=true.
	     ===================================================================== -->
	<Target
		Name="InternalsVisibleToTarget"
		BeforeTargets="BeforeCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(DisableAutoInternalsVisibleTo)' != 'true'"
		Label="Generates InternalsVisibleToAttribute entries for all TestType variants and SharedTesting projects."
	>
		<ItemGroup>
			<!-- InternalsVisibleTo for each TestType -->
			<!-- Assembly Type... -->
			<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
				<_Parameter1>$(AssemblyName).%(TestType.Identity)Tests</_Parameter1>
			</AssemblyAttribute>
			<!-- Project Type -->
			<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
				<_Parameter1>$(TargetProjectName).%(TestType.Identity)Tests</_Parameter1>
			</AssemblyAttribute>
			<!-- MSBuild project name -->
			<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
				<_Parameter1>$(MSBuildProjectName).%(TestType.Identity)Tests</_Parameter1>
			</AssemblyAttribute>
			<!-- InternalsVisibleTo for all SharedTesting projects -->
			<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
				<_Parameter1
					Condition="'$(EnableAssemblyNameGeneration)' == 'true' AND '$(PurviewNamespacePrefix)' != ''"
					>$(PurviewNamespacePrefix).%(SharedTestingProjectName.Identity)</_Parameter1>
				<_Parameter1
					Condition="'$(EnableAssemblyNameGeneration)' != 'true' OR '$(PurviewNamespacePrefix)' == ''"
					>%(SharedTestingProjectName.Identity)</_Parameter1>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<!-- =====================================================================
	     GENERATE ASSEMBLY INFO CLASS
	     Writes a static AssemblyInfo class to the intermediate output path so
	     projects have compile-time access to version, company, etc.
	     ===================================================================== -->
	<Target
		Name="GenerateAssemblyInfoClassTarget"
		BeforeTargets="BeforeCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableGenerateAssemblyInfoClass)' != 'true'"
	>
		<WriteLinesToFile
			File="$(IntermediateOutputPath)/Properties/$(AutoGeneratedAssemblyInfoFile)"
			Lines="// &lt;auto-generated /&gt;

#if !PURVIEW_SDK_EXCLUDE_EMBEDDED

namespace Microsoft.CodeAnalysis
{
	[global::Microsoft.CodeAnalysis.Embedded]
	[global::System.Runtime.CompilerServices.CompilerGenerated]
	[global::System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage]
	[global::System.CodeDom.Compiler.GeneratedCode(&quot;Purview.BuildSdk&quot;, &quot;$(PackageVersion)&quot;)]
	sealed partial class EmbeddedAttribute : global::System.Attribute
	{
	}
}

#endif

namespace $(RootNamespace)
{
	[global::Microsoft.CodeAnalysis.Embedded]
	[global::System.Runtime.CompilerServices.CompilerGenerated]
	[global::System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage]
	[global::System.CodeDom.Compiler.GeneratedCode(&quot;Purview.BuildSdk&quot;, &quot;$(PackageVersion)&quot;)]
	static partial class AssemblyInfo
	{
		public const string RootNamespace = &quot;$([MSBuild]::Escape('$(RootNamespace)'))&quot;%3B
		public const string AssemblyName = &quot;$([MSBuild]::Escape('$(AssemblyName)'))&quot;%3B
		public const string AssemblyTitle = &quot;$([MSBuild]::Escape('$(AssemblyTitle)'))&quot;%3B
		public const string AssemblyProduct = &quot;$([MSBuild]::Escape('$(AssemblyProduct)'))&quot;%3B
		public const string Version = &quot;$([MSBuild]::Escape('$(Version)'))&quot;%3B
		public const string Company = &quot;$([MSBuild]::Escape('$(Company)'))&quot;%3B
		public const string Copyright = &quot;$([MSBuild]::Escape('$(Copyright)'))&quot;%3B
		public const int Year = $(CurrentYear)%3B

		public static string GetFriendlyName()
		{
			var possibleNames = new[]
			{
				AssemblyProduct,
				AssemblyTitle,
				AssemblyName
			}%3B

			foreach (var name in possibleNames)
			{
				if (!string.IsNullOrWhiteSpace(name))
				{
					return name%3B
				}
			}

			return &quot;$([MSBuild]::Escape('$(MSBuildProjectName)'))&quot;%3B
		}
	}
}
"
			Overwrite="true"
		/>
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)/Properties/$(AutoGeneratedAssemblyInfoFile)" />
		</ItemGroup>
	</Target>
	<!-- =====================================================================
	     ANALYZER CLOSURE VALIDATION (PRSGD0005)
	     Validates that every file in the analyzer closure returned by
	     GetSourceGeneratorAnalyzerFiles is self-contained: each PE AssemblyRef must resolve to
	     another file in the same closure or to a compiler-host-provided assembly. Runs for every
	     Roslyn component because the closure (and therefore the defect) is produced here, including
	     for a code-fix component that references another component without referencing the framework.
	     Implemented without an external metadata reference so it works on both MSBuild flavours.
	     ===================================================================== -->
	<UsingTask
		TaskName="ValidatePurviewAnalyzerClosure"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<PermittedReferences ParameterType="System.String" Required="false" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var permitted = new List<string>();
					if (!string.IsNullOrEmpty(PermittedReferences))
					{
						foreach (var value in PermittedReferences.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
						{
							var trimmed = value.Trim();
							if (trimmed.Length > 0 && !permitted.Contains(trimmed))
								permitted.Add(trimmed);
						}
					}

					var closureNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					foreach (var file in Files)
						closureNames.Add(Path.GetFileNameWithoutExtension(file.ItemSpec));

					foreach (var file in Files)
					{
						if (!File.Exists(file.ItemSpec))
						{
							Log.LogError(null, "PRSGD0005", null, file.ItemSpec, 0, 0, 0, 0,
								"The analyzer closure file '{0}' does not exist.", file.ItemSpec);
							continue;
						}

						foreach (var reference in ReadAssemblyReferenceNames(file.ItemSpec))
						{
							if (closureNames.Contains(reference))
								continue;

							var isPermitted = false;
							foreach (var prefix in permitted)
							{
								if (reference.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
								{
									isPermitted = true;
									break;
								}
							}
							if (isPermitted)
								continue;

							Log.LogError(null, "PRSGD0005", null, file.ItemSpec, 0, 0, 0, 0,
								"The self-contained analyzer '{0}' references '{1}', which is neither part of the returned analyzer closure ({2}) nor a host-provided assembly. Make the referenced Roslyn component an analyzer dependency so its analyzer artifact is returned, or declare the dependency as a SourceGeneratorRuntimeDependency so it is copied beside the analyzer.",
								Path.GetFileName(file.ItemSpec), reference, string.Join(", ", closureNames));
						}
					}

					List<string> ReadAssemblyReferenceNames(string path)
					{
						var names = new List<string>();
						var image = File.ReadAllBytes(path);
						if (image.Length < 0x40)
							return names;

						int peOffset = BitConverter.ToInt32(image, 0x3C);
						int coffOffset = peOffset + 4;
						int sectionCount = BitConverter.ToUInt16(image, coffOffset + 2);
						int optionalHeaderSize = BitConverter.ToUInt16(image, coffOffset + 16);
						int optionalOffset = coffOffset + 20;
						int magic = BitConverter.ToUInt16(image, optionalOffset);
						int directoriesOffset = optionalOffset + (magic == 0x20B ? 112 : 96);
						int cliRva = BitConverter.ToInt32(image, directoriesOffset + (14 * 8));
						int sectionsOffset = optionalOffset + optionalHeaderSize;

						int RvaToOffset(int rva)
						{
							for (int s = 0; s < sectionCount; s++)
							{
								int section = sectionsOffset + (s * 40);
								int virtualSize = (int)BitConverter.ToUInt32(image, section + 8);
								int virtualAddress = BitConverter.ToInt32(image, section + 12);
								int rawSize = BitConverter.ToInt32(image, section + 16);
								int rawPointer = BitConverter.ToInt32(image, section + 20);
								int size = Math.Max(virtualSize, rawSize);
								if (rva >= virtualAddress && rva < virtualAddress + size)
									return rawPointer + (rva - virtualAddress);
							}
							return -1;
						}

						int cliOffset = RvaToOffset(cliRva);
						if (cliOffset < 0)
							return names;

						int metadataOffset = RvaToOffset(BitConverter.ToInt32(image, cliOffset + 8));
						if (metadataOffset < 0 || BitConverter.ToUInt32(image, metadataOffset) != 0x424A5342)
							return names;

						int versionPadded = (BitConverter.ToInt32(image, metadataOffset + 12) + 3) & ~3;
						int streamCount = BitConverter.ToUInt16(image, metadataOffset + 16 + versionPadded + 2);
						int cursor = metadataOffset + 20 + versionPadded;
						int tablesStream = -1;
						int stringsStream = -1;
						for (int i = 0; i < streamCount; i++)
						{
							int relativeOffset = BitConverter.ToInt32(image, cursor);
							int nameStart = cursor + 8;
							int nameEnd = nameStart;
							while (image[nameEnd] != 0)
								nameEnd++;
							var streamName = Encoding.ASCII.GetString(image, nameStart, nameEnd - nameStart);
							if (streamName == "#~" || streamName == "#-")
								tablesStream = metadataOffset + relativeOffset;
							else if (streamName == "#Strings")
								stringsStream = metadataOffset + relativeOffset;
							cursor = nameStart + ((((nameEnd - nameStart) + 1) + 3) & ~3);
						}
						if (tablesStream < 0 || stringsStream < 0)
							return names;

						int heapSizes = image[tablesStream + 6];
						int stringIndexSize = (heapSizes & 0x01) != 0 ? 4 : 2;
						int guidIndexSize = (heapSizes & 0x02) != 0 ? 4 : 2;
						int blobIndexSize = (heapSizes & 0x04) != 0 ? 4 : 2;

						ulong valid = BitConverter.ToUInt64(image, tablesStream + 8);
						var rowCounts = new int[64];
						int rowsCursor = tablesStream + 24;
						for (int t = 0; t < 64; t++)
						{
							if ((valid & (1UL << t)) == 0)
								continue;
							rowCounts[t] = BitConverter.ToInt32(image, rowsCursor);
							rowsCursor += 4;
						}

						int Rid(int table) => rowCounts[table] >= 65536 ? 4 : 2;
						int Coded(int tagBits, int[] tables)
						{
							int max = 0;
							foreach (var t in tables)
							{
								if (rowCounts[t] > max)
									max = rowCounts[t];
							}
							return max >= (1 << (16 - tagBits)) ? 4 : 2;
						}

						int typeDefOrRef = Coded(2, new[] { 0x02, 0x01, 0x1B });
						int hasConstant = Coded(2, new[] { 0x04, 0x08, 0x17 });
						int hasCustomAttribute = Coded(5, new[] { 0x06, 0x04, 0x01, 0x02, 0x08, 0x09, 0x0A, 0x00, 0x0E, 0x17, 0x14, 0x11, 0x1A, 0x1B, 0x20, 0x23, 0x26, 0x27, 0x28, 0x2A, 0x2C, 0x2B });
						int hasFieldMarshal = Coded(1, new[] { 0x04, 0x08 });
						int hasDeclSecurity = Coded(2, new[] { 0x02, 0x06, 0x20 });
						int memberRefParent = Coded(3, new[] { 0x02, 0x01, 0x1A, 0x06, 0x1B });
						int hasSemantics = Coded(1, new[] { 0x14, 0x17 });
						int memberForwarded = Coded(1, new[] { 0x04, 0x06 });
						int customAttributeType = Coded(3, new[] { 0x06, 0x0A });
						int resolutionScope = Coded(2, new[] { 0x00, 0x1A, 0x23, 0x01 });

						int RowSize(int table)
						{
							switch (table)
							{
								case 0x00: return 2 + stringIndexSize + guidIndexSize + guidIndexSize + guidIndexSize;
								case 0x01: return resolutionScope + stringIndexSize + stringIndexSize;
								case 0x02: return 4 + stringIndexSize + stringIndexSize + typeDefOrRef + Rid(0x04) + Rid(0x06);
								case 0x03: return Rid(0x04);
								case 0x04: return 2 + stringIndexSize + blobIndexSize;
								case 0x05: return Rid(0x06);
								case 0x06: return 4 + 2 + 2 + stringIndexSize + blobIndexSize + Rid(0x08);
								case 0x07: return Rid(0x08);
								case 0x08: return 2 + 2 + stringIndexSize;
								case 0x09: return Rid(0x02) + typeDefOrRef;
								case 0x0A: return memberRefParent + stringIndexSize + blobIndexSize;
								case 0x0B: return 2 + hasConstant + blobIndexSize;
								case 0x0C: return hasCustomAttribute + customAttributeType + blobIndexSize;
								case 0x0D: return hasFieldMarshal + blobIndexSize;
								case 0x0E: return 2 + hasDeclSecurity + blobIndexSize;
								case 0x0F: return 2 + 4 + Rid(0x02);
								case 0x10: return 4 + Rid(0x04);
								case 0x11: return blobIndexSize;
								case 0x12: return Rid(0x02) + Rid(0x14);
								case 0x13: return Rid(0x14);
								case 0x14: return 2 + stringIndexSize + typeDefOrRef;
								case 0x15: return Rid(0x02) + Rid(0x17);
								case 0x16: return Rid(0x17);
								case 0x17: return 2 + stringIndexSize + blobIndexSize;
								case 0x18: return 2 + Rid(0x06) + hasSemantics;
								case 0x19: return Rid(0x02) + Rid(0x06) + Rid(0x06);
								case 0x1A: return stringIndexSize;
								case 0x1B: return blobIndexSize;
								case 0x1C: return 2 + memberForwarded + stringIndexSize + Rid(0x1A);
								case 0x1D: return 4 + Rid(0x04);
								case 0x1E: return 4 + 4;
								case 0x1F: return 4;
								case 0x20: return 4 + 2 + 2 + 2 + 2 + 4 + blobIndexSize + stringIndexSize + stringIndexSize;
								case 0x21: return 4;
								case 0x22: return 4 + 4 + 4;
								case 0x23: return 2 + 2 + 2 + 2 + 4 + blobIndexSize + stringIndexSize + stringIndexSize + blobIndexSize;
								default: return 0;
							}
						}

						int assemblyRefOffset = rowsCursor;
						for (int t = 0; t < 0x23; t++)
						{
							if ((valid & (1UL << t)) == 0)
								continue;
							assemblyRefOffset += RowSize(t) * rowCounts[t];
						}

						int assemblyRefRowSize = RowSize(0x23);
						int nameColumnOffset = 12 + blobIndexSize;
						for (int i = 0; i < rowCounts[0x23]; i++)
						{
							int nameColumn = assemblyRefOffset + (i * assemblyRefRowSize) + nameColumnOffset;
							int nameIndex = stringIndexSize == 4 ? BitConverter.ToInt32(image, nameColumn) : BitConverter.ToUInt16(image, nameColumn);
							int stringStart = stringsStream + nameIndex;
							int stringEnd = stringStart;
							while (image[stringEnd] != 0)
								stringEnd++;
							names.Add(Encoding.UTF8.GetString(image, stringStart, stringEnd - stringStart));
						}

						return names;
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="ValidateSourceGeneratorAnalyzerClosure"
		AfterTargets="GetSourceGeneratorAnalyzerFiles"
		Condition="'$(PurviewSourceGeneratorFrameworkAnalyzerValidation)' != 'false' AND '$(IsRoslynComponent)' == 'true' AND '@(_PurviewSourceGeneratorAnalyzerFile)' != ''"
		Label="Validates that every analyzer-closure file is self-contained (PRSGD0005)."
	>
		<ItemGroup>
			<_PurviewAnalyzerClosurePermitted Include="$(PurviewAnalyzerClosurePermittedReferences)" />
			<_PurviewAnalyzerClosurePermitted Include="@(PurviewAnalyzerClosurePermittedReference)" />
		</ItemGroup>
		<ValidatePurviewAnalyzerClosure
			Files="@(_PurviewSourceGeneratorAnalyzerFile)"
			PermittedReferences="@(_PurviewAnalyzerClosurePermitted->'%(Identity)', ';')"
		/>
	</Target>

	<!-- =====================================================================
	     PROJECT-REFERENCE BUILD-TRANSITIVE ASSETS
	     NuGet imports a package's buildTransitive assets for PackageReference consumers only. Every
	     project inside a package repository uses ProjectReference, so a packable project's own
	     CompilerVisibleProperty items are never registered while developing the package itself. This
	     registers those items for any ProjectReference consumer by reading the referenced project's
	     Sdk/buildTransitive/*.props|*.targets.
	     Opt out with <PurviewImportProjectReferenceBuildTransitive>false</PurviewImportProjectReferenceBuildTransitive>.
	     ===================================================================== -->
	<UsingTask
		TaskName="ReadBuildTransitiveCompilerVisibleProperties"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<ProjectDirectories ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<Existing ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<CompilerVisibleProperties ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var includePattern = new Regex("Include\\s*=\\s*[\"'](?<name>[^\"']+)[\"']", RegexOptions.IgnoreCase);
					var elementPattern = new Regex("<CompilerVisibleProperty(?<attrs>[^>]*)>(?<inner>.*?)</CompilerVisibleProperty>", RegexOptions.Singleline | RegexOptions.IgnoreCase);
					var selfClosingPattern = new Regex("<CompilerVisibleProperty(?<attrs>[^>]*)/>", RegexOptions.Singleline | RegexOptions.IgnoreCase);
					var descriptionPattern = new Regex("<Description>(?<desc>.*?)</Description>", RegexOptions.Singleline | RegexOptions.IgnoreCase);

					var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					if (Existing != null)
					{
						foreach (var item in Existing)
							seen.Add(item.ItemSpec);
					}

					var candidateFiles = new List<string>();
					if (ProjectDirectories != null)
					{
						foreach (var directory in ProjectDirectories)
						{
							var buildTransitive = Path.Combine(directory.ItemSpec, "Sdk", "buildTransitive");
							if (!Directory.Exists(buildTransitive))
								continue;

							candidateFiles.AddRange(Directory.GetFiles(buildTransitive, "*.props", SearchOption.AllDirectories));
							candidateFiles.AddRange(Directory.GetFiles(buildTransitive, "*.targets", SearchOption.AllDirectories));
						}
					}

					var results = new List<ITaskItem>();
					foreach (var file in candidateFiles)
					{
							string text;
							try
							{
								text = File.ReadAllText(file);
							}
							catch (Exception)
							{
								continue;
							}

							foreach (Match match in elementPattern.Matches(text))
							{
								var includeMatch = includePattern.Match(match.Groups["attrs"].Value);
								if (!includeMatch.Success)
									continue;

								var name = includeMatch.Groups["name"].Value.Trim();
								if (name.Length == 0 || !seen.Add(name))
									continue;

								var item = new TaskItem(name);
								var descriptionMatch = descriptionPattern.Match(match.Groups["inner"].Value);
								if (descriptionMatch.Success)
								{
									var description = descriptionMatch.Groups["desc"].Value.Trim();
									if (description.Length > 0)
										item.SetMetadata("Description", description);
								}
								results.Add(item);
							}

							foreach (Match match in selfClosingPattern.Matches(text))
							{
								var includeMatch = includePattern.Match(match.Groups["attrs"].Value);
								if (!includeMatch.Success)
									continue;

								var name = includeMatch.Groups["name"].Value.Trim();
								if (name.Length == 0 || !seen.Add(name))
									continue;

								results.Add(new TaskItem(name));
							}
					}

					CompilerVisibleProperties = results.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="ImportProjectReferencedBuildTransitiveAssets"
		BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile"
		Condition="'$(PurviewImportProjectReferenceBuildTransitive)' != 'false'"
		Label="Registers CompilerVisibleProperty items from referenced projects' buildTransitive assets."
	>
		<ItemGroup>
			<!--
				The task enumerates Sdk/buildTransitive from each directory itself: MSBuild expands
				wildcards in literal includes but not in metadata transforms, so a
				"%(Directory)Sdk/buildTransitive/*.props" transform would stay a literal string.
			-->
			<_PurviewBuildTransitiveProjectReference Include="@(ProjectReference)" />
			<_PurviewBuildTransitiveProjectDirectory Include="@(_PurviewBuildTransitiveProjectReference->'%(RootDir)%(Directory)')" />
		</ItemGroup>
		<ReadBuildTransitiveCompilerVisibleProperties
			ProjectDirectories="@(_PurviewBuildTransitiveProjectDirectory)"
			Existing="@(CompilerVisibleProperty)"
			Condition="'@(_PurviewBuildTransitiveProjectDirectory)' != ''"
		>
			<Output TaskParameter="CompilerVisibleProperties" ItemName="_PurviewImportedCompilerVisibleProperty" />
		</ReadBuildTransitiveCompilerVisibleProperties>
		<ItemGroup Condition="'@(_PurviewImportedCompilerVisibleProperty)' != ''">
			<CompilerVisibleProperty Include="@(_PurviewImportedCompilerVisibleProperty)" />
		</ItemGroup>
	</Target>
</Project>
