<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="$(MSBuildThisFileDirectory)Targets/VersionDetection.targets " />

	<PropertyGroup>
		<DefaultTargetFramework Condition="'$(DefaultTargetFramework)' == '' AND '$(TargetFrameworks)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Match('$(TargetFrameworks)', '^[^;]+').Value)</DefaultTargetFramework>
		<DefaultTargetFramework Condition="'$(DefaultTargetFramework)' == '' AND '$(TargetFramework)' != ''"
			>$(TargetFramework)</DefaultTargetFramework>
	</PropertyGroup>

	<!-- =====================================================================
	     SHARED TESTING PROJECT OUTPUT
	     Shared testing projects provide helpers to the test assemblies, so they are
	     helper libraries: compiled, referenced and never executed directly (which is
	     why the SDK also injects TUnit's [Skip] attribute). Their test packages still
	     set IsTestProject/IsTestingPlatformApplication=true and OutputType=Exe from the
	     package props, and those props are imported after Sdk.props. Sdk.targets is
	     imported last, so reassert the documented shape here. A repository that really
	     wants the package-driven test-host shape can opt in with
	     <PurviewSharedTestingOutputType>Exe</PurviewSharedTestingOutputType>; the default
	     'Library' is what keeps shared helpers out of CA1515's Exe-only scope.
	     ===================================================================== -->
	<PropertyGroup
		Label="Shared Testing Project Output"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsSharedTestingProject)' == 'true'"
	>
		<OutputType>$(PurviewSharedTestingOutputType)</OutputType>
		<IsTestProject Condition="'$(PurviewSharedTestingOutputType)' == 'Library'">false</IsTestProject>
		<IsTestingPlatformApplication Condition="'$(PurviewSharedTestingOutputType)' == 'Library'"
			>false</IsTestingPlatformApplication>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'">
		<!-- Microsoft.Managed.Core.targets clears this when emission is disabled; retain the
		     Roslyn-component default so enabling EmitCompilerGeneratedFiles needs no second setting. -->
		<CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''"
			>$(IntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<!-- =====================================================================
	     PACKABLE ROSLYN COMPONENT ANALYZER ASSET
	     Packs the built analyzer/generator assembly (and its PDB) into
	     analyzers/dotnet/cs so consumers receive it as a Roslyn analyzer rather
	     than a lib/ asset. IncludeBuildOutput=false keeps lib/ empty. Gated on
	     single-targeting because TargetPath is a single-TFM path; the SDK clears
	     TargetFrameworks for Roslyn components by default, and a project that
	     explicitly multi-targets opts out of this convenience.
	     ===================================================================== -->
	<ItemGroup
		Label="Packable Roslyn Component Analyzer Asset"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '$(IsPackable)' == 'true' AND '$(TargetFrameworks)' == ''"
	>
		<None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<!-- The PDB ships inside the .nupkg beside the analyzer by default (PurviewPackAnalyzerPdb=true)
		     so symbols are always delivered. NuGet's .snupkg cannot host analyzers/dotnet/cs symbols
		     (symbols flow is gated on IncludeBuildOutput inside the PackTask), so opt out only when
		     symbols are delivered another way. -->
		<None
			Include="$(TargetDir)$(TargetName).pdb"
			Pack="true"
			PackagePath="analyzers/dotnet/cs"
			Visible="false"
			Condition="'$(DebugType)' != 'embedded' AND '$(DebugType)' != 'none' AND '$(PurviewPackAnalyzerPdb)' != 'false'"
		/>
	</ItemGroup>

	<!-- =====================================================================
	     ROSLYN DEV DEPENDENCY DEFAULTS
	     Roslyn packages (Microsoft.CodeAnalysis.*, Microsoft.CodeAnalysis.Analyzers)
	     are development-only dependencies of analyzer/generator projects. When a
	     Roslyn component references them, default PrivateAssets=all (and the
	     analyzer IncludeAssets for Microsoft.CodeAnalysis.Analyzers) so they never
	     leak into the packed nuspec as package dependencies. Update-only: existing
	     references are amended; nothing is added, and explicit metadata is preserved.
	     ===================================================================== -->
	<ItemGroup
		Label="Roslyn Dev Dependency Defaults"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'"
	>
		<PackageReference Update="Microsoft.CodeAnalysis.CSharp">
			<PrivateAssets Condition="'%(PackageReference.PrivateAssets)' == ''">all</PrivateAssets>
		</PackageReference>
		<PackageReference Update="Microsoft.CodeAnalysis.CSharp.Workspaces">
			<PrivateAssets Condition="'%(PackageReference.PrivateAssets)' == ''">all</PrivateAssets>
		</PackageReference>
		<PackageReference Update="Microsoft.CodeAnalysis.Analyzers">
			<PrivateAssets Condition="'%(PackageReference.PrivateAssets)' == ''">all</PrivateAssets>
			<IncludeAssets Condition="'%(PackageReference.IncludeAssets)' == ''"
				>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- =====================================================================
	     VALIDATE ROSLYN COMPONENT COMPILER SETTINGS
	     Ensures packable Roslyn components are always shipped with the standard
	     compiler defaults so every analyzer package is built with latest C#,
	     nullable enable, warnings-as-errors, and extended analyzer rules.
	     Opt out with DisableRoslynCompilerDefaultsValidation=true.
	     ===================================================================== -->
	<Target
		Name="ValidateRoslynComponentCompilerSettings"
		BeforeTargets="Pack"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '$(IsPackable)' == 'true' AND '$(DisableRoslynCompilerDefaultsValidation)' != 'true'"
		Label="Validates Roslyn components are shipped with the standard compiler defaults."
	>
		<Error
			Code="PRSGD0001"
			Text="The Roslyn component '$(MSBuildProjectName)' does not set LangVersion. Source-generator packages must ship with a defined C# language version (default latest)."
			Condition="'$(LangVersion)' == ''"
		/>
		<Error
			Code="PRSGD0002"
			Text="The Roslyn component '$(MSBuildProjectName)' does not set Nullable. Source-generator packages must ship with a defined nullable context (default enable)."
			Condition="'$(Nullable)' == ''"
		/>
		<Error
			Code="PRSGD0003"
			Text="The Roslyn component '$(MSBuildProjectName)' disables TreatWarningsAsErrors. Source-generator packages must ship with warnings-as-errors enabled (default true)."
			Condition="'$(TreatWarningsAsErrors)' != 'true'"
		/>
		<Error
			Code="PRSGD0004"
			Text="The Roslyn component '$(MSBuildProjectName)' disables EnforceExtendedAnalyzerRules. Source-generator packages must ship with extended analyzer rules enabled (default true)."
			Condition="'$(EnforceExtendedAnalyzerRules)' != 'true'"
		/>
	</Target>

	<Target
		Name="CreateRoslynComponentGeneratedFilesDirectory"
		BeforeTargets="CoreCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '$(CompilerGeneratedFilesOutputPath)' != ''"
	>
		<MakeDir Directories="$(CompilerGeneratedFilesOutputPath)" />
	</Target>

	<!-- Analyzer project references need the extended target so runtime dependencies are
	     propagated as well as the generator assembly. Make it the default when omitted. -->
	<Target Name="ConfigureSourceGeneratorProjectReferences" BeforeTargets="AssignProjectConfiguration">
		<ItemGroup>
			<ProjectReference
				Update="@(ProjectReference)"
				Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer' AND '%(ProjectReference.ReferenceOutputAssembly)' == 'false' AND '%(ProjectReference.Targets)' == ''"
			>
				<Targets>GetSourceGeneratorAnalyzerFiles</Targets>
			</ProjectReference>
		</ItemGroup>
	</Target>

	<!-- Visual Studio's project system may retain only the primary output from an analyzer
	     ProjectReference. Resolve the extended target explicitly and add every returned file
	     to the compiler's Analyzer items, including generator runtime dependencies. -->
	<Target Name="ResolveSourceGeneratorProjectReferenceFiles" AfterTargets="ResolveProjectReferences">
		<ItemGroup>
			<_PurviewSourceGeneratorCompilerProjectReference
				Include="@(ProjectReference)"
				Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer' AND '%(ProjectReference.ReferenceOutputAssembly)' == 'false'"
			/>
		</ItemGroup>
		<MSBuild
			Projects="@(_PurviewSourceGeneratorCompilerProjectReference)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewSourceGeneratorCompilerProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewResolvedSourceGeneratorCompilerFile" />
		</MSBuild>

		<!--
			Visual Studio's project system additionally resolves an OutputItemType=Analyzer project
			reference to the referenced project's default target path - the component's *unmerged* bin
			assembly - and adds it to the compiler's analyzers. That copy is not a valid analyzer for a
			merged component: it still references Purview.SourceGeneratorFramework, so loading it makes
			the compiler host look for a framework assembly it does not have (CS8784
			FileNotFoundException) and registers the generators twice.

			Remove the referenced projects' target paths before adding the resolved closure so only the
			merged artifact is handed to Roslyn, and also remove any analyzer whose file name collides
			with a resolved closure file (the merged and unmerged assemblies share a file name).
		-->
		<MSBuild
			Projects="@(_PurviewSourceGeneratorCompilerProjectReference)"
			Targets="GetTargetPath"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewSourceGeneratorCompilerProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewUnmergedSourceGeneratorCompilerFile" />
		</MSBuild>
		<ItemGroup>
			<Analyzer Remove="@(_PurviewUnmergedSourceGeneratorCompilerFile)" />
			<Analyzer Remove="@(_PurviewResolvedSourceGeneratorCompilerFile)" MatchOnMetadata="Filename" />
			<Analyzer Include="@(_PurviewResolvedSourceGeneratorCompilerFile)" />
		</ItemGroup>
	</Target>

	<Target
		Name="CopySourceGeneratorRuntimeDependencies"
		AfterTargets="CopyFilesToOutputDirectory"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true' AND '@(SourceGeneratorRuntimeDependency)' != ''"
	>
		<ItemGroup>
			<_PurviewSourceGeneratorRuntimeDependency Include="@(SourceGeneratorRuntimeDependency)">
				<DestinationPath Condition="'%(SourceGeneratorRuntimeDependency.DestinationSubPath)' != ''"
					>$(TargetDir)%(SourceGeneratorRuntimeDependency.DestinationSubPath)</DestinationPath>
				<DestinationPath Condition="'%(SourceGeneratorRuntimeDependency.DestinationSubPath)' == ''"
					>$(TargetDir)%(SourceGeneratorRuntimeDependency.Filename)%(SourceGeneratorRuntimeDependency.Extension)</DestinationPath>
			</_PurviewSourceGeneratorRuntimeDependency>
		</ItemGroup>
		<Copy
			SourceFiles="@(_PurviewSourceGeneratorRuntimeDependency)"
			DestinationFiles="@(_PurviewSourceGeneratorRuntimeDependency->'%(DestinationPath)')"
			SkipUnchangedFiles="true"
		/>
	</Target>

	<!-- Analyzer project references can request this target to receive the built generator
	     assembly. Generator-specific packages may override it to append runtime dependencies. -->
	<Target
		Name="GetSourceGeneratorAnalyzerFiles"
		Returns="@(_PurviewSourceGeneratorAnalyzerFile)"
		DependsOnTargets="Build;GetTargetPathWithTargetPlatformMoniker"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'"
	>
		<ItemGroup>
			<_PurviewSourceGeneratorAnalyzerFileRaw Include="@(TargetPathWithTargetPlatformMoniker)" />
			<!-- Roslyn resolves analyzer dependencies beside the analyzer assembly. Return the
			     copies in TargetDir, rather than their original NuGet/package locations. -->
			<_PurviewSourceGeneratorAnalyzerFileRaw
				Include="$(TargetDir)%(SourceGeneratorRuntimeDependency.DestinationSubPath)"
				Condition="'@(SourceGeneratorRuntimeDependency)' != '' AND '%(SourceGeneratorRuntimeDependency.DestinationSubPath)' != ''"
			/>
			<_PurviewSourceGeneratorAnalyzerFileRaw
				Include="$(TargetDir)%(SourceGeneratorRuntimeDependency.Filename)%(SourceGeneratorRuntimeDependency.Extension)"
				Condition="'@(SourceGeneratorRuntimeDependency)' != '' AND '%(SourceGeneratorRuntimeDependency.DestinationSubPath)' == ''"
			/>
		</ItemGroup>

		<!--
			A component that references another Roslyn component has a genuine runtime dependency on
			it (for example a code-fix component that shares the generator's diagnostic identity). The
			referenced component's *analyzer artifact* therefore belongs to this component's closure so
			Roslyn can load both. Its own merged, self-contained assembly is returned: the referenced
			component is never IL-merged into this one, which would duplicate its types (including
			InternalsVisibleTo-visible internals) inside a second analyzer in the same host.

			Non-component project references are harmless: the referenced project's
			GetSourceGeneratorAnalyzerFiles target is skipped by its own IsRoslynComponent condition
			and returns nothing.
		-->
		<ItemGroup>
			<_PurviewComponentReferenceProjectReference
				Include="@(ProjectReference)"
				Condition="'$(PurviewIncludeComponentReferenceAnalyzerClosure)' != 'false' AND '%(ProjectReference.ReferenceOutputAssembly)' != 'false' AND '%(ProjectReference.OutputItemType)' != 'Analyzer'"
			/>
		</ItemGroup>
		<MSBuild
			Projects="@(_PurviewComponentReferenceProjectReference)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewComponentReferenceProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewComponentReferenceAnalyzerFile" />
		</MSBuild>
		<ItemGroup Condition="'@(_PurviewComponentReferenceAnalyzerFile)' != ''">
			<_PurviewSourceGeneratorAnalyzerFileRaw Include="@(_PurviewComponentReferenceAnalyzerFile)" />
		</ItemGroup>

		<RemoveDuplicates Inputs="@(_PurviewSourceGeneratorAnalyzerFileRaw)">
			<Output TaskParameter="Filtered" ItemName="_PurviewSourceGeneratorAnalyzerFile" />
		</RemoveDuplicates>

		<Error
			Code="PSGF0001"
			Condition="'@(_PurviewSourceGeneratorAnalyzerFile)' == ''"
			Text="The Roslyn component '$(MSBuildProjectName)' did not produce a source-generator analyzer assembly. Ensure IsRoslynComponent is true and the project builds successfully."
		/>
		<Error
			Code="PSGF0001"
			Condition="!Exists('%(_PurviewSourceGeneratorAnalyzerFile.Identity)')"
			Text="Source-generator analyzer file '%(_PurviewSourceGeneratorAnalyzerFile.Identity)' was not produced. Runtime dependencies must be declared as SourceGeneratorRuntimeDependency items so they can be copied beside the generator."
		/>
	</Target>

	<UsingTask
		TaskName="DeduplicateSourceGeneratorPackageFiles"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<DeduplicatedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					var results = new List<ITaskItem>();
					foreach (var file in Files ?? Array.Empty<ITaskItem>())
					{
						// Two analyzer projects can share a runtime dependency (for example a shared
						// support assembly). NuGet fails the pack on duplicate target paths, so keep
						// only the first file for each resolved analyzers/dotnet/cs package path.
						// The calling target re-applies PackagePath metadata afterwards.
						var packagePath = "analyzers/dotnet/cs/" + Path.GetFileName(file.ItemSpec);
						if (!seen.Add(packagePath))
							continue;

						results.Add(new TaskItem(file.ItemSpec));
					}
					DeduplicatedFiles = results.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="IncludeProjectReferencedSourceGenerators"
		Condition="'$(PackProjectReferencedSourceGenerators)' == 'true' AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Packs analyzer project references and their runtime dependencies automatically."
	>
		<ItemGroup>
			<_PurviewSourceGeneratorProjectReference
				Include="@(ProjectReference)"
				Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer' AND '%(ProjectReference.ReferenceOutputAssembly)' == 'false' AND '%(ProjectReference.Pack)' != 'false'"
			/>
		</ItemGroup>

		<MSBuild
			Projects="@(_PurviewSourceGeneratorProjectReference)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			BuildInParallel="$(BuildInParallel)"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
			Condition="'@(_PurviewSourceGeneratorProjectReference)' != ''"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewSourceGeneratorPackageFile" />
		</MSBuild>

		<DeduplicateSourceGeneratorPackageFiles
			Files="@(_PurviewSourceGeneratorPackageFile)"
			Condition="'@(_PurviewSourceGeneratorPackageFile)' != ''"
		>
			<Output TaskParameter="DeduplicatedFiles" ItemName="_PurviewDeduplicatedSourceGeneratorPackageFile" />
		</DeduplicateSourceGeneratorPackageFiles>

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_PurviewDeduplicatedSourceGeneratorPackageFile)">
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<NoDefaultExcludes Condition="'$(NoDefaultExcludes)' == '' AND '$(PurviewAutoSdkPack)' == 'true'"
			>true</NoDefaultExcludes>
	</PropertyGroup>

	<!-- =====================================================================
	     RESOLVE PURVIEW SKILL SOURCES
	     Maps every restored NuGet package that ships skills to the git source
	     and commit the skills CLI needs to install them.

	     There is deliberately no custom skills.json manifest. A package that
	     ships skills already carries both halves of the mapping:

	       * '.agents/skills/<name>/' in the package says which skills it has,
	         which is the same folder the agent-folder mirror already reads, and
	       * the nuspec's <repository url="..." commit="..." /> element - written
	         by SourceLink for every package built by this SDK - says which git
	         repository and which exact commit produced them.

	     That makes version compatibility exact by construction: the commit
	     resolved is the commit the restored package was built from, so a
	     project on an older package version gets that version's skills rather
	     than whatever is on the default branch. A package with no repository
	     metadata cannot be pinned, and is reported rather than guessed at.

	     Returns one item per package, with the skill names as metadata, for an
	     explicit install target to act on. Resolution never runs during a
	     normal build.
	     ===================================================================== -->
	<UsingTask
		TaskName="ResolvePurviewSkillSources"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<ProjectAssetsFile ParameterType="System.String" Required="true" />
			<NuGetPackageFolders ParameterType="System.String" Required="false" />
			<SkillSources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
			<Unresolvable ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var resolved = new List<ITaskItem>();
					var unresolved = new List<ITaskItem>();

					if (File.Exists(ProjectAssetsFile))
					{
						var roots = (NuGetPackageFolders ?? string.Empty)
							.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
							.Select(root => root.TrimEnd('\\', '/'))
							.Where(root => root.Length > 0)
							.ToArray();

						// Same "libraries" shape DiscoverAgentPackageFolders reads; the version is the
						// segment after the id, and is reported so a diagnostic can name it.
						var json = File.ReadAllText(ProjectAssetsFile);
						var libraryPattern = new Regex(
							"\"(?<id>[^\"/]+)/(?<version>[^\"]+)\"\\s*:\\s*\\{[^{}]*?\"type\"\\s*:\\s*\"package\"[^{}]*?\"path\"\\s*:\\s*\"(?<path>[^\"]+)\"",
							RegexOptions.Singleline
						);
						// NuGet writes the repository element on one line; url and commit may appear in
						// either order, so match the element then pull each attribute out of it.
						var repositoryElementPattern = new Regex("<repository\\b[^>]*/?>", RegexOptions.IgnoreCase);
						var urlPattern = new Regex("\\burl\\s*=\\s*\"(?<url>[^\"]*)\"", RegexOptions.IgnoreCase);
						var commitPattern = new Regex("\\bcommit\\s*=\\s*\"(?<commit>[^\"]*)\"", RegexOptions.IgnoreCase);

						foreach (Match match in libraryPattern.Matches(json))
						{
							var libraryPath = match.Groups["path"].Value;
							if (string.IsNullOrEmpty(libraryPath))
								continue;

							var packageId = match.Groups["id"].Value;
							var packageVersion = match.Groups["version"].Value;
							var normalizedPath = libraryPath.Replace('/', Path.DirectorySeparatorChar);

							foreach (var root in roots)
							{
								var packageRoot = Path.Combine(root, normalizedPath);
								var skillsFolder = Path.Combine(packageRoot, ".agents", "skills");
								if (!Directory.Exists(skillsFolder))
									continue;

								// Only a folder holding a SKILL.md is a skill; a 'references' or
								// 'scripts' folder beside one is part of it, not another skill.
								var skillNames = Directory.GetDirectories(skillsFolder)
									.Where(dir => File.Exists(Path.Combine(dir, "SKILL.md")))
									.Select(dir => Path.GetFileName(dir))
									.OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
									.ToArray();

								if (skillNames.Length == 0)
									break;

								var repositoryUrl = string.Empty;
								var repositoryCommit = string.Empty;
								var nuspecFiles = Directory.GetFiles(packageRoot, "*.nuspec");
								if (nuspecFiles.Length > 0)
								{
									var nuspec = File.ReadAllText(nuspecFiles[0]);
									var element = repositoryElementPattern.Match(nuspec);
									if (element.Success)
									{
										var urlMatch = urlPattern.Match(element.Value);
										if (urlMatch.Success)
											repositoryUrl = urlMatch.Groups["url"].Value;

										var commitMatch = commitPattern.Match(element.Value);
										if (commitMatch.Success)
											repositoryCommit = commitMatch.Groups["commit"].Value;
									}
								}

								// The skills CLI addresses GitHub as 'owner/repo'; a trailing slash or a
								// '.git' suffix is normal in nuspec metadata and must be trimmed off.
								var source = string.Empty;
								if (repositoryUrl.Length > 0)
								{
									var gitHubMatch = Regex.Match(
										repositoryUrl,
										"github\\.com[/:](?<owner>[^/]+)/(?<repo>[^/]+?)(?:\\.git)?/?$",
										RegexOptions.IgnoreCase
									);
									if (gitHubMatch.Success)
										source = gitHubMatch.Groups["owner"].Value + "/" + gitHubMatch.Groups["repo"].Value;
								}

								var item = new TaskItem(packageId);
								item.SetMetadata("PackageId", packageId);
								item.SetMetadata("PackageVersion", packageVersion);
								item.SetMetadata("Skills", string.Join(";", skillNames));
								item.SetMetadata("SkillCount", skillNames.Length.ToString());
								item.SetMetadata("PackageSkillsFolder", skillsFolder);
								item.SetMetadata("RepositoryUrl", repositoryUrl);
								item.SetMetadata("RepositoryCommit", repositoryCommit);
								item.SetMetadata("Source", source);

								if (source.Length > 0 && repositoryCommit.Length > 0)
								{
									// '<owner>/<repo>#<commit>' is the CLI's pinned-source syntax, and the
									// commit is recorded in its lockfile so a restore is reproducible.
									item.SetMetadata("SourceWithRef", source + "#" + repositoryCommit);
									resolved.Add(item);
								}
								else
								{
									item.SetMetadata(
										"Reason",
										source.Length == 0
											? "the package's nuspec has no GitHub <repository url=\"...\" /> metadata"
											: "the package's nuspec <repository /> element has no commit attribute"
									);
									unresolved.Add(item);
								}

								break;
							}
						}
					}

					SkillSources = resolved.ToArray();
					Unresolvable = unresolved.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     EVALUATE LOCAL SKILL STATE
	     Joins the skills a restored package ships against the skills the
	     repository actually has installed, and classifies every one of them.

	     Both halves are local, so this runs offline and spawns no process:

	       * the restore graph says which packages are referenced, at which
	         version, and which commit each was built from, and
	       * 'skills-lock.json' - written by the skills CLI itself - says
	         which skills are installed, from which source, at which ref.

	     Reading the CLI's own lockfile is deliberate. Its JSON listing is
	     machine-readable but omits the ref, and the ref is the whole
	     question: without it there is nothing to compare a package's commit
	     against. The lockfile carries it, costs no Node tooling, and this
	     SDK therefore needs no competing manifest of its own.

	     Classification, per skill:

	       Satisfied  - installed from the same source at the same commit the
	                    referenced package was built from.
	       Missing    - the package ships it and the lockfile has no entry.
	       Drifted    - installed from the same source at a *different* ref.
	                    The installed skill describes some other version of
	                    the library than the one referenced.
	       Unknown    - installed with no ref recorded, installed from a
	                    different source under the same name, or shipped by a
	                    package that cannot be pinned at all.
	       Orphaned   - in the lockfile, under an owner this project does
	                    reference, but from a repository it no longer does.

	     Orphan detection is deliberately owner-scoped. A lockfile cannot say
	     who asked for an entry, so anything outside the owners the project
	     references is treated as the developer's own and left alone.
	     ===================================================================== -->
	<UsingTask
		TaskName="EvaluatePurviewSkillState"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<SkillSources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<UnresolvableSkillSources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<LockFilePath ParameterType="System.String" Required="false" />
			<StampPath ParameterType="System.String" Required="false" />
			<RespectStamp ParameterType="System.Boolean" Required="false" />
			<Agents ParameterType="System.String" Required="false" />
			<CommandPrefix ParameterType="System.String" Required="false" />
			<RepositoryRoot ParameterType="System.String" Required="false" />
			<AgentSkillDirectoriesFound ParameterType="System.Boolean" Output="true" />
			<Missing ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
			<Drifted ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
			<Unknown ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
			<Satisfied ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
			<Orphaned ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
			<LockFileFound ParameterType="System.Boolean" Output="true" />
			<ShouldReport ParameterType="System.Boolean" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Using Namespace="System.Text" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var sources = SkillSources ?? new ITaskItem[0];
					var unpinnable = UnresolvableSkillSources ?? new ITaskItem[0];
					var agents = string.IsNullOrEmpty(Agents) ? "*" : Agents;
					// How the repository launches the CLI - 'npx skills', 'pnpm dlx skills', and so on.
					var cli = string.IsNullOrEmpty(CommandPrefix) ? "npx skills" : CommandPrefix;

					// ---- Read the CLI's lockfile -------------------------------------------------
					// Entries are flat objects, so one regex over the 'skills' object is enough. A
					// shape this does not understand degrades to "not installed", which only ever
					// produces advice, never a failure.
					var lockedSource = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
					var lockedRef = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

					LockFileFound = !string.IsNullOrEmpty(LockFilePath) && File.Exists(LockFilePath);
					if (LockFileFound)
					{
						var lockText = string.Empty;
						try { lockText = File.ReadAllText(LockFilePath); }
						catch (IOException) { LockFileFound = false; }
						catch (UnauthorizedAccessException) { LockFileFound = false; }

						var skillsKey = lockText.IndexOf("\"skills\"", StringComparison.Ordinal);
						var open = skillsKey < 0 ? -1 : lockText.IndexOf('{', skillsKey);
						if (open >= 0)
						{
							// Walk to the matching brace rather than regexing the whole document, so a
							// sibling key that happens to contain braces cannot be swept in.
							var depth = 0;
							var inString = false;
							var escaped = false;
							var close = -1;
							for (var index = open; index < lockText.Length; index++)
							{
								var character = lockText[index];
								if (escaped) { escaped = false; continue; }
								if (character == '\\' && inString) { escaped = true; continue; }
								if (character == '"') { inString = !inString; continue; }
								if (inString) continue;
								if (character == '{') depth++;
								else if (character == '}')
								{
									depth--;
									if (depth == 0) { close = index; break; }
								}
							}

							if (close > open)
							{
								var body = lockText.Substring(open, close - open + 1);
								var entryPattern = new Regex("\"(?<name>[^\"]+)\"\\s*:\\s*\\{(?<entry>[^{}]*)\\}", RegexOptions.Singleline);
								// '"source"' cannot match '"sourceType"': the closing quote differs.
								var sourcePattern = new Regex("\"source\"\\s*:\\s*\"(?<value>[^\"]*)\"");
								var refPattern = new Regex("\"ref\"\\s*:\\s*\"(?<value>[^\"]*)\"");

								foreach (Match entry in entryPattern.Matches(body))
								{
									var name = entry.Groups["name"].Value;
									var text = entry.Groups["entry"].Value;
									var sourceMatch = sourcePattern.Match(text);
									var refMatch = refPattern.Match(text);
									lockedSource[name] = sourceMatch.Success ? sourceMatch.Groups["value"].Value : string.Empty;
									lockedRef[name] = refMatch.Success ? refMatch.Groups["value"].Value : string.Empty;
								}
							}
						}
					}

					// ---- Has the lockfile ever been restored here? -------------------------------
					// A lockfile is a record of an install, not proof of one: a fresh clone carries a
					// committed skills-lock.json and no installed skills at all. Rather than hard-code
					// the agent directories - which the CLI owns, and which change independently of
					// this SDK - look for any dot-folder at the repository root holding a 'skills'
					// folder.
					//
					// '.agents' is deliberately *included* in that scan. It used to be excluded,
					// because the SDK's own mirror wrote there and finding it proved nothing. The
					// mirror is gone, so '.agents/skills/' is now unambiguously the CLI's universal
					// install location - excluding it would report PRSKL0014 ("no agent skill
					// directory exists") against a repository whose skills are correctly installed.
					AgentSkillDirectoriesFound = false;
					if (!string.IsNullOrEmpty(RepositoryRoot) && Directory.Exists(RepositoryRoot))
					{
						// Neither of these is ever an agent directory, and '.purview' is this SDK's own.
						var ignored = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
						{
							".git",
							".purview",
						};

						foreach (var directory in Directory.GetDirectories(RepositoryRoot, ".*"))
						{
							if (ignored.Contains(Path.GetFileName(directory)))
								continue;

							if (Directory.Exists(Path.Combine(directory, "skills")))
							{
								AgentSkillDirectoriesFound = true;
								break;
							}
						}
					}

					// ---- Classify ----------------------------------------------------------------
					var missing = new List<ITaskItem>();
					var drifted = new List<ITaskItem>();
					var unknown = new List<ITaskItem>();
					var satisfied = new List<ITaskItem>();
					var orphaned = new List<ITaskItem>();

					var knownSources = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					var knownOwners = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					var claimedNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

					foreach (var item in sources.Concat(unpinnable))
					{
						var source = item.GetMetadata("Source") ?? string.Empty;
						if (source.Length == 0)
							continue;

						knownSources.Add(source);
						var slash = source.IndexOf('/');
						if (slash > 0)
							knownOwners.Add(source.Substring(0, slash));
					}

					foreach (var item in sources)
					{
						var packageId = item.GetMetadata("PackageId");
						var packageVersion = item.GetMetadata("PackageVersion");
						var source = item.GetMetadata("Source");
						var commit = item.GetMetadata("RepositoryCommit");
						var sourceWithRef = item.GetMetadata("SourceWithRef");

						var names = (item.GetMetadata("Skills") ?? string.Empty)
							.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
							.OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
							.ToArray();

						var missingNames = new List<string>();
						var driftedNames = new List<string>();
						var unknownNames = new List<string>();
						var unknownReasons = new List<string>();
						var satisfiedNames = new List<string>();

						foreach (var name in names)
						{
							claimedNames.Add(name);

							string installedSource;
							if (!lockedSource.TryGetValue(name, out installedSource))
							{
								missingNames.Add(name);
								continue;
							}

							// Same name, different repository: somebody installed their own skill under
							// this name. Reporting it as drift would be wrong, and overwriting it is not
							// this SDK's call, so it is surfaced as unknown and left alone.
							if (!string.Equals(installedSource, source, StringComparison.OrdinalIgnoreCase))
							{
								unknownNames.Add(name);
								unknownReasons.Add(name + " is installed from '" + installedSource + "', not '" + source + "'");
								continue;
							}

							var installedRef = lockedRef[name];
							if (installedRef.Length == 0)
							{
								unknownNames.Add(name);
								unknownReasons.Add(name + " is installed with no ref recorded, so it cannot be matched to a package version");
							}
							else if (string.Equals(installedRef, commit, StringComparison.OrdinalIgnoreCase))
								satisfiedNames.Add(name);
							else
								driftedNames.Add(name);
						}

						// The install command names each skill explicitly and repeats the flag: the CLI
						// matches nothing when given one comma-separated value.
						var commandFor = new Func<List<string>, string>(selected =>
							cli + " add \"" + sourceWithRef + "\" --skill \""
								+ string.Join("\" --skill \"", selected) + "\" --agent \"" + agents + "\" -y");

						var addItem = new Func<List<ITaskItem>, List<string>, ITaskItem>((bucket, selected) =>
						{
							var created = new TaskItem(packageId);
							created.SetMetadata("PackageId", packageId);
							created.SetMetadata("PackageVersion", packageVersion);
							created.SetMetadata("Source", source);
							created.SetMetadata("SourceWithRef", sourceWithRef);
							created.SetMetadata("RepositoryCommit", commit);
							created.SetMetadata("Skills", string.Join(";", selected));
							created.SetMetadata("SkillCount", selected.Count.ToString());
							created.SetMetadata("Command", commandFor(selected));
							bucket.Add(created);
							return created;
						});

						if (missingNames.Count > 0)
							addItem(missing, missingNames);

						if (driftedNames.Count > 0)
						{
							var driftedItem = addItem(drifted, driftedNames);
							driftedItem.SetMetadata(
								"InstalledRefs",
								string.Join(";", driftedNames.Select(name => name + "@" + lockedRef[name]))
							);
						}

						if (unknownNames.Count > 0)
						{
							var unknownItem = addItem(unknown, unknownNames);
							unknownItem.SetMetadata("Reason", string.Join("; ", unknownReasons));
						}

						if (satisfiedNames.Count > 0)
							addItem(satisfied, satisfiedNames);
					}

					// A package that ships skills but carries no pinnable git identity is unknown
					// rather than missing: there is no ref to compare against and none to install from.
					foreach (var item in unpinnable)
					{
						foreach (var name in (item.GetMetadata("Skills") ?? string.Empty)
							.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
						{
							claimedNames.Add(name);
						}

						var created = new TaskItem(item.GetMetadata("PackageId"));
						created.SetMetadata("PackageId", item.GetMetadata("PackageId"));
						created.SetMetadata("PackageVersion", item.GetMetadata("PackageVersion"));
						created.SetMetadata("Source", item.GetMetadata("Source"));
						created.SetMetadata("Skills", item.GetMetadata("Skills"));
						created.SetMetadata("SkillCount", item.GetMetadata("SkillCount"));
						created.SetMetadata("Reason", item.GetMetadata("Reason"));
						created.SetMetadata("Command", string.Empty);
						unknown.Add(created);
					}

					// ---- Orphans -----------------------------------------------------------------
					foreach (var entry in lockedSource.OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase))
					{
						var installedSource = entry.Value;
						var slash = installedSource.IndexOf('/');
						if (slash <= 0 || claimedNames.Contains(entry.Key))
							continue;

						// Outside the owners this project references, an entry is the developer's own.
						if (!knownOwners.Contains(installedSource.Substring(0, slash)) || knownSources.Contains(installedSource))
							continue;

						var created = new TaskItem(entry.Key);
						created.SetMetadata("Skill", entry.Key);
						created.SetMetadata("Source", installedSource);
						created.SetMetadata("Ref", lockedRef[entry.Key]);
						created.SetMetadata("Command", cli + " remove \"" + entry.Key + "\"");
						orphaned.Add(created);
					}

					Missing = missing.ToArray();
					Drifted = drifted.ToArray();
					Unknown = unknown.ToArray();
					Satisfied = satisfied.ToArray();
					Orphaned = orphaned.ToArray();

					// ---- Deduplicate -------------------------------------------------------------
					// A solution has many projects and they share one repository, so the same advice
					// would otherwise be printed once per project, and again on every rebuild. The
					// stamp holds a fingerprint of the exact state last reported: advice repeats only
					// when the state actually changes.
					var fingerprint = new StringBuilder();
					foreach (var pair in new[]
					{
						new KeyValuePair<string, List<ITaskItem>>("missing", missing),
						new KeyValuePair<string, List<ITaskItem>>("drifted", drifted),
						new KeyValuePair<string, List<ITaskItem>>("unknown", unknown),
						new KeyValuePair<string, List<ITaskItem>>("orphaned", orphaned),
					})
					{
						foreach (var line in pair.Value
							.Select(item => pair.Key + "|" + item.GetMetadata("PackageId") + "|"
								+ item.GetMetadata("PackageVersion") + "|" + item.GetMetadata("Skills")
								+ item.GetMetadata("Skill") + "|" + item.GetMetadata("RepositoryCommit"))
							.OrderBy(line => line, StringComparer.Ordinal))
						{
							fingerprint.Append(line).Append('\n');
						}
					}

					// An unrestored lockfile is its own state: restoring it must end the advice.
					if (LockFileFound && !AgentSkillDirectoriesFound && lockedSource.Count > 0)
						fingerprint.Append("needs-restore\n");

					var current = fingerprint.ToString();
					ShouldReport = true;

					if (RespectStamp && !string.IsNullOrEmpty(StampPath))
					{
						var previous = string.Empty;
						try { if (File.Exists(StampPath)) previous = File.ReadAllText(StampPath); }
						catch (IOException) { }
						catch (UnauthorizedAccessException) { }

						ShouldReport = !string.Equals(previous, current, StringComparison.Ordinal);

						// A stamp that cannot be written costs a repeated message, never a failed
						// build: a read-only or concurrently-built tree must still build.
						if (ShouldReport)
						{
							try
							{
								Directory.CreateDirectory(Path.GetDirectoryName(StampPath));
								File.WriteAllText(StampPath, current);
							}
							catch (IOException) { }
							catch (UnauthorizedAccessException) { }
						}
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     VALIDATE AUTHORED SKILLS
	     A malformed skill fails quietly where it hurts most: the skills CLI
	     skips a SKILL.md whose frontmatter it cannot parse, so the skill simply
	     never appears, and a consumer has no way to tell that from a skill that
	     was never written. The package would ship it regardless.

	     So the shape is checked at pack time, where the repository that owns
	     the skill is the one that sees the failure:

	       * every folder under the skills root has a SKILL.md,
	       * that file opens with YAML frontmatter carrying 'name' and
	         'description' - the two fields the CLI requires,
	       * 'name' matches the folder name, because the CLI addresses a skill
	         by the name in the frontmatter while a human reads the folder, and
	       * every 'references/...' path the body links to exists.

	     Deliberately not checked: prose quality, and whether an agent obeys the
	     skill. A build can only check that a skill is well formed.
	     ===================================================================== -->
	<UsingTask
		TaskName="ValidatePurviewSkillFolders"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<SkillsRoot ParameterType="System.String" Required="true" />
			<SkillNames ParameterType="System.String" Required="false" />
			<Failures ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var failures = new List<ITaskItem>();
					var seenNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

					if (Directory.Exists(SkillsRoot))
					{
						var selected = (SkillNames ?? string.Empty)
							.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
							.Select(name => name.Trim())
							.Where(name => name.Length > 0)
							.ToArray();

						foreach (var skillDirectory in Directory.GetDirectories(SkillsRoot).OrderBy(dir => dir, StringComparer.Ordinal))
						{
							var folderName = Path.GetFileName(skillDirectory);
							if (selected.Length > 0 && Array.IndexOf(selected, folderName) < 0)
								continue;

							var skillFile = Path.Combine(skillDirectory, "SKILL.md");
							if (!File.Exists(skillFile))
							{
								failures.Add(new TaskItem(folderName + ": no SKILL.md. A skill folder without one is invisible to the skills CLI."));
								continue;
							}

							var text = File.ReadAllText(skillFile);
							var normalized = text.Replace("\r\n", "\n");
							if (!normalized.StartsWith("---\n", StringComparison.Ordinal))
							{
								failures.Add(new TaskItem(folderName + ": SKILL.md does not open with YAML frontmatter ('---' on the first line)."));
								continue;
							}

							var end = normalized.IndexOf("\n---", 3, StringComparison.Ordinal);
							if (end < 0)
							{
								failures.Add(new TaskItem(folderName + ": SKILL.md frontmatter is not terminated by a closing '---'."));
								continue;
							}

							var frontmatter = normalized.Substring(4, end - 3);
							var body = normalized.Substring(end);

							// 'name: value' on its own line. The value is required; a bare key is not a name.
							var nameMatch = Regex.Match(frontmatter, "(?m)^name:[ \\t]*(?<value>\\S.*?)[ \\t]*$");
							if (!nameMatch.Success)
								failures.Add(new TaskItem(folderName + ": SKILL.md frontmatter has no 'name'. The skills CLI requires it."));
							else
							{
								var declaredName = nameMatch.Groups["value"].Value.Trim().Trim('"', '\'');
								if (!string.Equals(declaredName, folderName, StringComparison.Ordinal))
								{
									failures.Add(new TaskItem(
										folderName + ": frontmatter name is '" + declaredName + "' but the folder is '" + folderName
											+ "'. The CLI installs by frontmatter name, so they must match."
									));
								}

								string firstSeenIn;
								if (seenNames.TryGetValue(declaredName, out firstSeenIn))
									failures.Add(new TaskItem(folderName + ": skill name '" + declaredName + "' is already used by '" + firstSeenIn + "'."));
								else
									seenNames[declaredName] = folderName;
							}

							// A description may be inline or a YAML block scalar ('>-' then indented lines),
							// so an empty inline value is only a failure when nothing is indented beneath it.
							var descriptionMatch = Regex.Match(frontmatter, "(?m)^description:[ \\t]*(?<value>.*)$");
							if (!descriptionMatch.Success)
								failures.Add(new TaskItem(folderName + ": SKILL.md frontmatter has no 'description'. It is the activation trigger."));
							else
							{
								var inline = descriptionMatch.Groups["value"].Value.Trim();
								var hasBlock = Regex.IsMatch(
									frontmatter.Substring(descriptionMatch.Index + descriptionMatch.Length),
									"^\\n[ \\t]+\\S"
								);
								if ((inline.Length == 0 || inline == ">-" || inline == ">" || inline == "|" || inline == "|-") && !hasBlock)
									failures.Add(new TaskItem(folderName + ": SKILL.md 'description' is empty. It is the activation trigger."));
							}

							// Every references/... path the body links to has to exist, or progressive
							// disclosure sends the agent to a file that is not there.
							foreach (Match reference in Regex.Matches(body, "references/(?<file>[A-Za-z0-9._-]+\\.md)"))
							{
								var referencePath = Path.Combine(skillDirectory, "references", reference.Groups["file"].Value);
								if (!File.Exists(referencePath))
									failures.Add(new TaskItem(folderName + ": SKILL.md links to 'references/" + reference.Groups["file"].Value + "', which does not exist."));
							}
						}
					}

					Failures = failures.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     DETECT THE SKILLS CLI
	     Installation shells out to the skills CLI, which is Node tooling and is
	     therefore not guaranteed to be present on a machine that can build .NET.
	     Without detection the failure surfaces as a shell error - exit code 1,
	     or "'npx' is not recognized" - which says nothing about what to install.

	     Two ways to run it, preferred in this order:

	       1. 'skills' already on PATH (a global install, or a repository that
	          has it as a local dependency). No download, works offline.
	       2. 'npx', which fetches the CLI on demand.

	     PATH is probed directly rather than by spawning a version check: probing
	     is deterministic, costs no process, cannot hang on a cold npx download,
	     and gives the resolved path to report. PATHEXT is honoured on Windows,
	     where both commands are .cmd shims rather than executables.
	     ===================================================================== -->
	<UsingTask
		TaskName="DetectPurviewSkillsCli"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<CommandNames ParameterType="System.String" Required="true" />
			<FoundCommand ParameterType="System.String" Output="true" />
			<FoundPath ParameterType="System.String" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					FoundCommand = string.Empty;
					FoundPath = string.Empty;

					var isWindows = Path.DirectorySeparatorChar == '\\';
					var extensions = new List<string> { string.Empty };
					if (isWindows)
					{
						// An empty PATHEXT is not a realistic machine, but defaulting keeps the probe
						// working rather than silently finding nothing.
						var pathExt = Environment.GetEnvironmentVariable("PATHEXT");
						if (string.IsNullOrEmpty(pathExt))
							pathExt = ".COM;.EXE;.BAT;.CMD";

						foreach (var ext in pathExt.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
							extensions.Add(ext.Trim());
					}

					var pathDirectories = (Environment.GetEnvironmentVariable("PATH") ?? string.Empty)
						.Split(new[] { Path.PathSeparator }, StringSplitOptions.RemoveEmptyEntries);

					foreach (var commandName in CommandNames.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
					{
						var trimmedCommand = commandName.Trim();
						if (trimmedCommand.Length == 0)
							continue;

						foreach (var pathDirectory in pathDirectories)
						{
							// A malformed PATH entry is common and must not abort the probe.
							string directory;
							try
							{
								directory = pathDirectory.Trim().Trim('"');
								if (directory.Length == 0)
									continue;
							}
							catch
							{
								continue;
							}

							foreach (var extension in extensions)
							{
								string candidate;
								try
								{
									candidate = Path.Combine(directory, trimmedCommand + extension);
								}
								catch
								{
									continue;
								}

								if (!File.Exists(candidate))
									continue;

								FoundCommand = trimmedCommand;
								FoundPath = candidate;
								break;
							}

							if (FoundCommand.Length > 0)
								break;
						}

						if (FoundCommand.Length > 0)
							break;
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     SHARED REPOSITORY DESTINATION COPY RETRIES
	     .agents content, .editorconfig and global.json are written by every
	     project in a solution, so several projects legitimately race for the
	     same destination and the built-in copy task's retry notice (MSB3026)
	     is pure noise. Retries still happen and a copy that never succeeds is
	     still reported - as an error by default, or a warning when the relevant
	     *FailureAsError property is false. Set PurviewSuppressCopyRetryWarnings
	     to false (project body or Directory.Build.props) to see every retry.

	     This lives in Sdk.targets rather than Sdk.props because targets are
	     imported after the project body, so the toggle honours values set in
	     the project file as well as earlier imports.
	     ===================================================================== -->
	<PropertyGroup Label="Shared repository copy retry diagnostics">
		<PurviewSuppressCopyRetryWarnings Condition="'$(PurviewSuppressCopyRetryWarnings)' == ''"
			>true</PurviewSuppressCopyRetryWarnings>
		<MSBuildWarningsAsMessages
			Condition="'$(PurviewSuppressCopyRetryWarnings)' != 'false' AND !$([System.String]::Copy('$(MSBuildWarningsAsMessages)').Contains('MSB3026'))"
			>$(MSBuildWarningsAsMessages);MSB3026</MSBuildWarningsAsMessages>
	</PropertyGroup>

	<!-- =====================================================================
	     REPOSITORY FILE SYNC
	     Copies SDK/package-provided files into shared repository locations
	     (.agents content, .editorconfig, global.json) without the failure modes
	     of the built-in Copy task:

	       * retry attempts are logged as low-importance messages instead of
	         MSB3026 warnings, and only the terminal failure is surfaced - as an
	         error by default, or a warning when the caller opts out,
	       * writes are staged into a temporary file in the destination directory
	         and renamed into place, so a reader never observes a partial file and
	         concurrent writers cannot interleave,
	       * unchanged content is skipped using a portable content fingerprint
	         (FNV-1a over raw bytes) recorded in a repository manifest, so a
	         republished package that keeps the same version still re-syncs,
	       * bootstrap files (WriteFile mode) are only written when missing by
	         default, which makes a lost race between parallel projects a no-op
	         instead of a build failure.

	     The copy logic deliberately avoids crypto, JSON and LINQ APIs so the
	     inline task compiles on both MSBuild flavours (Visual Studio's .NET
	     Framework MSBuild and the .NET SDK MSBuild) on Windows, Linux and macOS.
	     ===================================================================== -->
	<UsingTask
		TaskName="SyncPurviewRepositoryFiles"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<DestinationFile ParameterType="System.String" Required="false" />
			<SourceFile ParameterType="System.String" Required="false" />
			<Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<OverwriteExisting ParameterType="System.Boolean" Required="false" />
			<VerifyExistingContent ParameterType="System.Boolean" Required="false" />
			<!--
				When set, a destination whose first non-empty line starts with this prefix is treated as a
				file the SDK wrote, and is refreshed when that line no longer matches the source's. A
				destination without the prefix is the developer's and is never overwritten.
			-->
			<VersionMarkerPrefix ParameterType="System.String" Required="false" />
			<Retries ParameterType="System.Int32" Required="false" />
			<RetryDelayMilliseconds ParameterType="System.Int32" Required="false" />
			<TreatFailureAsError ParameterType="System.Boolean" Required="false" />
			<UpToDate ParameterType="System.Boolean" Output="true" />
			<CopiedCount ParameterType="System.Int32" Output="true" />
			<SkippedCount ParameterType="System.Int32" Output="true" />
			<FailedCount ParameterType="System.Int32" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.Diagnostics" />
			<Using Namespace="System.Globalization" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Using Namespace="System.Threading" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var attemptLimit = Retries > 0 ? Retries : 3;
					var retryDelay = RetryDelayMilliseconds > 0 ? RetryDelayMilliseconds : 500;
					var pathComparison = Path.DirectorySeparatorChar == '\\'
						? StringComparison.OrdinalIgnoreCase
						: StringComparison.Ordinal;

					var copied = 0;
					var skipped = 0;
					var failed = 0;
					var upToDate = false;

					bool IsTransient(Exception exception) =>
						exception is IOException || exception is UnauthorizedAccessException;

					bool IsPermanent(Exception exception) =>
						exception is ArgumentException
						|| exception is NotSupportedException
						|| exception is PathTooLongException
						|| exception is DirectoryNotFoundException;


					ulong ComputeHash(byte[] bytes)
					{
						unchecked
						{
							// FNV-1a: dependency-free and identical on every platform, which
							// matters because the manifest outlives a single operating system.
							var hash = 14695981039346656037UL;
							foreach (var value in bytes)
							{
								hash ^= value;
								hash *= 1099511628211UL;
							}
							return hash;
						}
					}

					string ComputeFileHash(string path) =>
						ComputeHash(File.ReadAllBytes(path)).ToString("x16", CultureInfo.InvariantCulture);

					void ClearReadOnlyAttribute(string path)
					{
						try
						{
							var attributes = File.GetAttributes(path);
							if ((attributes & FileAttributes.ReadOnly) == FileAttributes.ReadOnly)
								File.SetAttributes(path, attributes & ~FileAttributes.ReadOnly);
						}
						catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
						{
							// Reported by the retry loop when the write itself fails.
						}
					}

					bool FilesMatch(string first, string second)
					{
						var firstInfo = new FileInfo(first);
						var secondInfo = new FileInfo(second);
						if (!secondInfo.Exists || firstInfo.Length != secondInfo.Length)
							return false;

						return ComputeFileHash(first) == ComputeFileHash(second);
					}

					bool TextMatches(string first, string second)
					{
						try
						{
							// Line endings differ between checkouts (core.autocrlf, .gitattributes),
							// so drift detection compares normalized text.
							var firstText = File.ReadAllText(first).Replace("\r\n", "\n");
							var secondText = File.ReadAllText(second).Replace("\r\n", "\n");
							return string.Equals(firstText, secondText, StringComparison.Ordinal);
						}
						catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
						{
							return false;
						}
					}

					void WriteAtomically(string destination, Action<string> writeTemporary)
					{
						var directory = Path.GetDirectoryName(destination);
						if (!string.IsNullOrEmpty(directory))
							Directory.CreateDirectory(directory);

						var temporary = destination + "." + Guid.NewGuid().ToString("N") + ".tmp";
						try
						{
							writeTemporary(temporary);

							if (File.Exists(destination))
							{
								ClearReadOnlyAttribute(destination);
								try
								{
									File.Replace(temporary, destination, null);
								}
								catch (Exception e) when (e is PlatformNotSupportedException || e is IOException)
								{
									// Some file systems reject Replace; overwrite in place instead
									// and let the retry loop report a genuinely locked destination.
									File.Copy(temporary, destination, true);
								}
							}
							else
							{
								File.Move(temporary, destination);
							}
						}
						finally
						{
							if (File.Exists(temporary))
							{
								try
								{
									File.Delete(temporary);
								}
								catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
								{
									// A leftover temp file is harmless; the next build reuses the name.
								}
							}
						}
					}

					void ReportFailure(string source, string destination, int attempts, string message)
					{
						failed++;
						if (TreatFailureAsError)
						{
							Log.LogError(
								"The Purview SDK could not copy '{0}' to '{1}' after {2} attempt(s): {3}",
								source,
								destination,
								attempts,
								message
							);
						}
						else
						{
							Log.LogWarning(
								"The Purview SDK could not copy '{0}' to '{1}' after {2} attempt(s): {3}",
								source,
								destination,
								attempts,
								message
							);
						}
					}

					bool Finish()
					{
						UpToDate = upToDate;
						CopiedCount = copied;
						SkippedCount = skipped;
						FailedCount = failed;
						return !Log.HasLoggedErrors;
					}

					// The first non-empty line, trimmed. A marker on line one survives an editor that
					// adds or strips a leading blank line.
					string FirstLine(string path)
					{
						try
						{
							foreach (var line in File.ReadLines(path))
							{
								if (!string.IsNullOrWhiteSpace(line))
								{
									return line.Trim();
								}
							}
						}
						catch (IOException)
						{
							// Unreadable means "not recognisably ours", which is the safe answer.
						}
						catch (UnauthorizedAccessException)
						{
						}

						return string.Empty;
					}

					bool IsManagedByMarker(string path, string prefix) =>
						FirstLine(path).StartsWith(prefix, StringComparison.Ordinal);

					var destinationFile = DestinationFile ?? string.Empty;
					if (string.IsNullOrEmpty(destinationFile))
					{
						upToDate = true;
						return Finish();
					}

					if (File.Exists(destinationFile))
					{
						// A destination carrying the SDK's own version marker is a file the SDK wrote,
						// so it is refreshed when the version moves on. A destination without the
						// marker belongs to the developer and is never touched, whatever the version
						// says - which is what makes deleting the marker line a supported way to take
						// ownership of the file.
						var managedUpdate =
							!OverwriteExisting
							&& !string.IsNullOrEmpty(VersionMarkerPrefix)
							&& !string.IsNullOrEmpty(SourceFile)
							&& File.Exists(SourceFile)
							&& IsManagedByMarker(destinationFile, VersionMarkerPrefix)
							&& !string.Equals(
								FirstLine(destinationFile),
								FirstLine(SourceFile),
								StringComparison.Ordinal
							);

						if (managedUpdate)
						{
							Log.LogMessage(
								MessageImportance.Normal,
								"Updating '{0}' from '{1}': the SDK-managed version marker changed from '{2}' to '{3}'.",
								destinationFile,
								SourceFile,
								FirstLine(destinationFile),
								FirstLine(SourceFile)
							);
						}

						if (!OverwriteExisting && !managedUpdate)
						{
							// Bootstraps are user-owned: an existing file is never touched, which
							// turns a lost race between parallel projects into a no-op.
							if (
								VerifyExistingContent
								&& !string.IsNullOrEmpty(SourceFile)
								&& File.Exists(SourceFile)
								&& !TextMatches(destinationFile, SourceFile)
							)
							{
								Log.LogWarning(
									"'{0}' already exists and was left untouched, but it differs from the SDK-provided '{1}'. Set PurviewRepoBootstrapMode=Always to overwrite it.",
									destinationFile,
									SourceFile
								);
							}

							skipped++;
							upToDate = true;
							return Finish();
						}

						if (!string.IsNullOrEmpty(SourceFile) && File.Exists(SourceFile) && FilesMatch(SourceFile, destinationFile))
						{
							skipped++;
							upToDate = true;
							return Finish();
						}
					}

					byte[] content;
					var lineItems = Lines ?? Array.Empty<ITaskItem>();
					var sourceDescription = string.IsNullOrEmpty(SourceFile) ? "generated content" : SourceFile;
					if (!string.IsNullOrEmpty(SourceFile) && File.Exists(SourceFile))
					{
						content = File.ReadAllBytes(SourceFile);
					}
					else if (lineItems.Length > 0)
					{
						var builder = new StringBuilder();
						foreach (var line in lineItems)
							builder.Append(line.ItemSpec).Append(Environment.NewLine);
						content = new UTF8Encoding(false).GetBytes(builder.ToString());
					}
					else if (!string.IsNullOrEmpty(SourceFile))
					{
						ReportFailure(sourceDescription, destinationFile, attemptLimit, "the source file does not exist");
						return Finish();
					}
					else
					{
						upToDate = true;
						return Finish();
					}

					for (var attempt = 1; attempt <= attemptLimit; attempt++)
					{
						try
						{
							WriteAtomically(destinationFile, temporary => File.WriteAllBytes(temporary, content));
							copied++;
							upToDate = true;
							break;
						}
						catch (Exception e) when (IsTransient(e))
						{
							if (attempt < attemptLimit)
							{
								Log.LogMessage(
									MessageImportance.Low,
									"Retrying bootstrap write of '{0}' (attempt {1} of {2}): {3}",
									destinationFile,
									attempt + 1,
									attemptLimit,
									e.Message
								);
								Thread.Sleep(retryDelay + ((attempt - 1) * 100));
							}
							else
							{
								ReportFailure(sourceDescription, destinationFile, attempt, e.Message);
							}
						}
						catch (Exception e) when (IsPermanent(e))
						{
							ReportFailure(sourceDescription, destinationFile, attempt, e.Message);
							break;
						}
					}

					Log.LogMessage(
						MessageImportance.Low,
						"Purview repository bootstrap: '{0}' {1}, {2} skipped, {3} failed.",
						destinationFile,
						copied > 0 ? "written" : "unchanged",
						skipped,
						failed
					);

					// This fragment deliberately ends without a return statement: the code task
					// factory appends its own success return, so ending on a return here would
					// make that generated statement unreachable (CS0162). Logged errors still
					// fail the target, and the explicit check below keeps the task contract.
					Finish();
					if (Log.HasLoggedErrors)
					{
						return false;
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     FIX ROOT NAMESPACE
	     Strips known suffixes from RootNamespace. @(NamespaceRemoveSuffix) only
	     expands inside a Target (after static item evaluation), so the regex
	     cannot be computed in a static PropertyGroup.

	     A RootNamespace the project declared itself is left alone. This target
	     runs after the project body, so it cannot tell an author's value apart
	     from a derived one - the declaration is recorded in Sdk.props. Without
	     that guard an explicit <RootNamespace>Foo.CodeFixers</RootNamespace>
	     was silently rewritten to Foo, and every file in it then failed
	     IDE0130 against a namespace the author never asked for.
	     ===================================================================== -->
	<Target
		Name="FixRootNamespaceTarget"
		BeforeTargets="GenerateAssemblyInfoClassTarget;GenerateGlobalUsings"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(_PurviewProjectDeclaresRootNamespace)' != 'true'"
		Label="Strips known suffixes from RootNamespace."
	>
		<PropertyGroup>
			<_NsRemovePattern>@(NamespaceRemoveSuffix, '|')</_NsRemovePattern>
			<_FixedRootNamespace>$([System.Text.RegularExpressions.Regex]::Replace('$(RootNamespace)', '\.(?:$(_NsRemovePattern))(?=\.|$)', ''))</_FixedRootNamespace>
		</PropertyGroup>
		<ItemGroup Condition="'$(RootNamespace)' != '$(_FixedRootNamespace)'">
			<Using Remove="$(RootNamespace)" />
			<Using Include="$(_FixedRootNamespace)" />
		</ItemGroup>
		<PropertyGroup Condition="'$(RootNamespace)' != '$(_FixedRootNamespace)'">
			<RootNamespace>$(_FixedRootNamespace)</RootNamespace>
		</PropertyGroup>
	</Target>

	<!-- =====================================================================
	     VALIDATE NAMESPACE PREFIX
	     Errors the build if NamespacePrefix is not set.
	     Disable with <DisableNamespacePrefixCheck>true</DisableNamespacePrefixCheck>.
	     ===================================================================== -->
	<Target
		Name="ResolvePurviewRepoBootstrapModeTarget"
		Label="Maps PurviewRepoBootstrapMode onto the repository file sync overwrite and drift-check switches."
	>
		<PropertyGroup>
			<_PurviewRepoBootstrapOverwriteExisting Condition="'$(PurviewRepoBootstrapMode)' == 'Always'"
				>true</_PurviewRepoBootstrapOverwriteExisting>
			<_PurviewRepoBootstrapVerifyExistingContent Condition="'$(PurviewRepoBootstrapMode)' == 'WarnOnDrift'"
				>true</_PurviewRepoBootstrapVerifyExistingContent>
			<_PurviewRepoBootstrapOverwriteExisting Condition="'$(_PurviewRepoBootstrapOverwriteExisting)' == ''"
				>false</_PurviewRepoBootstrapOverwriteExisting>
			<_PurviewRepoBootstrapVerifyExistingContent
				Condition="'$(_PurviewRepoBootstrapVerifyExistingContent)' == ''"
				>false</_PurviewRepoBootstrapVerifyExistingContent>
		</PropertyGroup>
	</Target>

	<Target
		Name="EnsureRepositoryEditorConfigTarget"
		BeforeTargets="PrepareForBuild"
		DependsOnTargets="ResolvePurviewRepoBootstrapModeTarget"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableAutoCopySdkFiles)' != 'true' AND '$(BootstrapEditorConfigToRepoRoot)' == 'true' AND '$(PurviewRepoBootstrapMode)' != 'Never' AND Exists('$(EditorConfigFilePath)')"
		Label="Bootstraps a physical .editorconfig at the repo root for external tooling."
	>
		<PropertyGroup>
			<_DirectoryBuildPropsDirectory>$([System.IO.Path]::GetDirectoryName('$(DirectoryBuildPropsPath)'))</_DirectoryBuildPropsDirectory>
			<!--
				Only a .editorconfig the SDK wrote carries this marker, and only such a file is refreshed
				when the SDK version changes. Leaving the prefix empty turns the refresh off entirely and
				restores the original behaviour: an existing file is never touched.
			-->
			<_PurviewEditorConfigVersionMarkerPrefix Condition="'$(PurviewEditorConfigAutoUpdate)' != 'false'"
				>$(PurviewEditorConfigVersionMarker)</_PurviewEditorConfigVersionMarkerPrefix>
		</PropertyGroup>
		<Exec
			Command="git -C &quot;$(_DirectoryBuildPropsDirectory)&quot; rev-parse --show-toplevel"
			ConsoleToMSBuild="true"
			IgnoreExitCode="true"
			IgnoreStandardErrorWarningFormat="true"
			StandardErrorImportance="low"
			StandardOutputImportance="low"
			Condition="'$(PurviewRepositoryRootStrategy)' == 'Git' AND '$(RepositoryEditorConfigFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
		>
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitRepositoryRoot" />
		</Exec>
		<PropertyGroup>
			<_GitRepositoryRoot>$([System.String]::Copy('$(_GitRepositoryRoot)').Trim())</_GitRepositoryRoot>
			<_RepositoryProbe0>$(_DirectoryBuildPropsDirectory)</_RepositoryProbe0>
			<_RepositoryProbe1>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe0)\..'))</_RepositoryProbe1>
			<_RepositoryProbe2>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe1)\..'))</_RepositoryProbe2>
			<_RepositoryProbe3>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe2)\..'))</_RepositoryProbe3>
			<_RepositoryProbe4>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe3)\..'))</_RepositoryProbe4>
			<_DetectedRepositoryRoot Condition="'$(_GitRepositoryRoot)' != '' AND Exists('$(_GitRepositoryRoot)')"
				>$(_GitRepositoryRoot)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe0)/.git/HEAD') OR Exists('$(_RepositoryProbe0)/.git'))"
				>$(_RepositoryProbe0)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe1)/.git/HEAD') OR Exists('$(_RepositoryProbe1)/.git'))"
				>$(_RepositoryProbe1)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe2)/.git/HEAD') OR Exists('$(_RepositoryProbe2)/.git'))"
				>$(_RepositoryProbe2)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe3)/.git/HEAD') OR Exists('$(_RepositoryProbe3)/.git'))"
				>$(_RepositoryProbe3)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe4)/.git/HEAD') OR Exists('$(_RepositoryProbe4)/.git'))"
				>$(_RepositoryProbe4)</_DetectedRepositoryRoot>
			<_EffectiveRepositoryEditorConfigFilePath>$(RepositoryEditorConfigFilePath)</_EffectiveRepositoryEditorConfigFilePath>
			<_EffectiveRepositoryEditorConfigFilePath
				Condition="'$(_EffectiveRepositoryEditorConfigFilePath)' == '' AND '$(_DetectedRepositoryRoot)' != ''"
				>$([System.IO.Path]::Combine('$(_DetectedRepositoryRoot)', '.editorconfig'))</_EffectiveRepositoryEditorConfigFilePath>
			<_EffectiveRepositoryEditorConfigFilePath
				Condition="'$(_EffectiveRepositoryEditorConfigFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
				>$([System.IO.Path]::Combine('$(_DirectoryBuildPropsDirectory)', '.editorconfig'))</_EffectiveRepositoryEditorConfigFilePath>
			<_RepositoryEditorConfigDirectory>$([System.IO.Path]::GetDirectoryName('$(_EffectiveRepositoryEditorConfigFilePath)'))</_RepositoryEditorConfigDirectory>
		</PropertyGroup>
		<PropertyGroup>
			<RepositoryEditorConfigFilePath
				Condition="'$(RepositoryEditorConfigFilePath)' == '' AND '$(_EffectiveRepositoryEditorConfigFilePath)' != ''"
				>$(_EffectiveRepositoryEditorConfigFilePath)</RepositoryEditorConfigFilePath>
		</PropertyGroup>
		<!--
			Decide whether there is anything to do *before* invoking SyncPurviewRepositoryFiles, because
			invoking it at all is the expensive part: it is a RoslynCodeTaskFactory task, which MSBuild
			compiles on first use. Measured at roughly 680ms per build, and it was paid on every build of
			every project even when the task went on to decide the file was already correct.

			Everything below is MSBuild property functions, so the common case (file present and current)
			now costs two file reads instead of a task compilation.
		-->
		<PropertyGroup>
			<_PurviewEditorConfigDestinationExists Condition="'$(_EffectiveRepositoryEditorConfigFilePath)' != ''"
				>$([System.IO.File]::Exists('$(_EffectiveRepositoryEditorConfigFilePath)'))</_PurviewEditorConfigDestinationExists>
			<_PurviewEditorConfigDestinationFirstLine
				Condition="'$(_PurviewEditorConfigDestinationExists)' == 'true' AND '$(_PurviewEditorConfigVersionMarkerPrefix)' != ''"
				>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_EffectiveRepositoryEditorConfigFilePath)')), `^[^\r\n]*`).Value)</_PurviewEditorConfigDestinationFirstLine>
			<_PurviewEditorConfigSourceFirstLine Condition="'$(_PurviewEditorConfigDestinationFirstLine)' != ''"
				>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(EditorConfigFilePath)')), `^[^\r\n]*`).Value)</_PurviewEditorConfigSourceFirstLine>

			<!-- Missing destination: the bootstrap's whole purpose. -->
			<_PurviewEditorConfigNeedsSync Condition="'$(_PurviewEditorConfigDestinationExists)' != 'true'"
				>true</_PurviewEditorConfigNeedsSync>
			<!-- Always overwrites; WarnOnDrift has to compare the content to report drift. -->
			<_PurviewEditorConfigNeedsSync
				Condition="'$(PurviewRepoBootstrapMode)' == 'Always' OR '$(PurviewRepoBootstrapMode)' == 'WarnOnDrift'"
				>true</_PurviewEditorConfigNeedsSync>
			<!--
				A managed file whose version marker has moved on. A destination without the marker is the
				developer's and is deliberately not matched here, exactly as the task would not touch it.
			-->
			<_PurviewEditorConfigNeedsSync
				Condition="
					'$(_PurviewEditorConfigDestinationFirstLine)' != ''
					AND $(_PurviewEditorConfigDestinationFirstLine.StartsWith('$(_PurviewEditorConfigVersionMarkerPrefix)'))
					AND '$(_PurviewEditorConfigDestinationFirstLine)' != '$(_PurviewEditorConfigSourceFirstLine)'"
				>true</_PurviewEditorConfigNeedsSync>
		</PropertyGroup>
		<SyncPurviewRepositoryFiles
			DestinationFile="$(_EffectiveRepositoryEditorConfigFilePath)"
			SourceFile="$(EditorConfigFilePath)"
			OverwriteExisting="$(_PurviewRepoBootstrapOverwriteExisting)"
			VerifyExistingContent="$(_PurviewRepoBootstrapVerifyExistingContent)"
			VersionMarkerPrefix="$(_PurviewEditorConfigVersionMarkerPrefix)"
			Retries="$(PurviewRepoBootstrapCopyRetries)"
			RetryDelayMilliseconds="$(PurviewRepoBootstrapCopyRetryDelayMilliseconds)"
			TreatFailureAsError="$(PurviewRepoBootstrapCopyFailureAsError)"
			Condition="'$(_EffectiveRepositoryEditorConfigFilePath)' != '' AND '$(_PurviewEditorConfigNeedsSync)' == 'true'"
		/>
	</Target>

	<!-- =====================================================================
	     FIND THE REPOSITORY ROOT
	     Walks up from a project looking for the markers that identify a
	     repository root. An inline task rather than MSBuild's intrinsic
	     because GetDirectoryNameOfFileAbove matches *files only* - it returns
	     nothing for '.git/', '.github/', '.agents/' or '.claude/', which are
	     four of the markers that matter most.

     Two passes, because neither pure priority nor pure proximity is right
	     on its own:

	       1. The *first* marker in the list is definitive, and is searched
	          all the way up. '.git/' is the repository root by definition, so
	          a project inside a monorepo package resolves to the repository
	          rather than to the nearer folder holding a 'package.json'.
	       2. Otherwise the nearest ancestor holding any marker wins, with
	          list order breaking ties within that one directory.

	     Pass 2 is nearest-first on purpose. Searching each remaining marker
	     to the top would let a stray '.claude/' in a developer's home
	     directory outrank the 'package.json' at the actual repository root,
	     and quietly scatter a lockfile and an agent directory outside the
	     repository. Only the definitive marker is allowed to reach that far.

	     PurviewRepositoryRootMarkers overrides the list, and its first entry
	     is whatever that list makes definitive.
	     ===================================================================== -->
	<UsingTask
		TaskName="FindPurviewRepositoryRoot"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<StartDirectory ParameterType="System.String" Required="true" />
			<Markers ParameterType="System.String" Required="true" />
			<RepositoryRoot ParameterType="System.String" Output="true" />
			<MatchedMarker ParameterType="System.String" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					RepositoryRoot = string.Empty;
					MatchedMarker = string.Empty;

					if (!string.IsNullOrEmpty(StartDirectory) && Directory.Exists(StartDirectory))
					{
						// The ancestor chain is built once and reused for every marker, because each
						// marker is searched over the whole chain before the next one is considered.
						//
						// The home directory and everything above it are excluded as candidates. A
						// repository root is never your home directory, and a '.claude/' or '.github/'
						// commonly sits there - without this bound a project outside any repository
						// would resolve to '~' and scatter a lockfile and an agent directory into it.
						// A repository *inside* the home directory is unaffected: it is below it.
						var excluded = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
						try
						{
							var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
							if (!string.IsNullOrEmpty(home))
							{
								for (var directory = new DirectoryInfo(Path.GetFullPath(home));
									directory != null;
									directory = directory.Parent)
								{
									excluded.Add(directory.FullName.TrimEnd('/', '\\'));
								}
							}
						}
						catch (ArgumentException) { }
						catch (PathTooLongException) { }

						var ancestors = new List<string>();
						try
						{
							for (var directory = new DirectoryInfo(Path.GetFullPath(StartDirectory));
								directory != null;
								directory = directory.Parent)
							{
								if (!excluded.Contains(directory.FullName.TrimEnd('/', '\\')))
									ancestors.Add(directory.FullName);
							}
						}
						catch (ArgumentException) { }
						catch (PathTooLongException) { }
						catch (IOException) { }

						// A trailing slash means "directory". It still matches a file of that name,
						// because '.git' is a directory in a clone but a file in a worktree or a
						// submodule, and both identify a repository root.
						var markers = Markers
							.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
							.Select(entry => entry.Trim())
							.Where(entry => entry.TrimEnd('/', '\\').Length > 0)
							.Select(entry => new KeyValuePair<string, bool>(
								entry,
								entry.EndsWith("/", StringComparison.Ordinal) || entry.EndsWith("\\", StringComparison.Ordinal)
							))
							.ToArray();

						var matches = new Func<string, KeyValuePair<string, bool>, bool>((directory, marker) =>
						{
							string candidate;
							try { candidate = Path.Combine(directory, marker.Key.TrimEnd('/', '\\')); }
							catch (ArgumentException) { return false; }

							return marker.Value
								? (Directory.Exists(candidate) || File.Exists(candidate))
								: File.Exists(candidate);
						});

						// Pass 1: the definitive marker, searched all the way up.
						if (markers.Length > 0)
						{
							foreach (var ancestor in ancestors)
							{
								if (!matches(ancestor, markers[0]))
									continue;

								RepositoryRoot = ancestor;
								MatchedMarker = markers[0].Key;
								break;
							}
						}

						// Pass 2: nearest ancestor holding any remaining marker, list order breaking
						// ties inside that one directory.
						if (RepositoryRoot.Length == 0)
						{
							foreach (var ancestor in ancestors)
							{
								foreach (var marker in markers)
								{
									if (!matches(ancestor, marker))
										continue;

									RepositoryRoot = ancestor;
									MatchedMarker = marker.Key;
									break;
								}

								if (RepositoryRoot.Length > 0)
									break;
							}
						}
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- =====================================================================
	     SKILLS REPOSITORY ROOT
	     Everything the skills CLI writes - 'skills-lock.json' and the agent
	     directories - belongs to the repository, not to a project. A solution
	     has many projects and exactly one of each of those, so every skill
	     target runs from the repository root, always.

	     Resolution order:

	       1. PurviewSkillsInstallRoot      - an explicit override.
	       2. PurviewSkillsRepoRoot         - only when the *user* set it.
	       3. the PurviewRepositoryRootMarkers walk.
	       4. PurviewSkillsRepoRoot/RepoRoot as this SDK guessed them.
	       5. the CI workspace variables.
	       6. the git source root SourceLink reports.

	     The marker walk deliberately outranks the evaluation-time guess at
	     PurviewSkillsRepoRoot, which only knows RepoRoot and an AGENTS.md
	     walk-up. An AGENTS.md can legitimately sit in a subdirectory, and
	     resolving to it would put a lockfile and an agent directory somewhere
	     that is not the repository. A value the user set explicitly is a
	     different matter and still wins.

	     There is deliberately no fall back to the project directory. Running
	     from a project folder would scatter a lockfile and an agent directory
	     through the tree, one per project, which is exactly the thing being
	     prevented - so an unresolved root is reported instead.
	     ===================================================================== -->
	<Target
		Name="ResolvePurviewSkillsRepositoryRoot"
		DependsOnTargets="InitializeSourceControlInformation"
		Label="Resolves the repository root every skill target runs from."
	>
		<ItemGroup>
			<_PurviewSkillsSourceRoot Include="@(SourceRoot -> WithMetadataValue('SourceControl', 'git'))" />
		</ItemGroup>

		<PropertyGroup>
			<_PurviewSkillsRepositoryRoot Condition="'$(PurviewSkillsInstallRoot)' != ''"
				>$(PurviewSkillsInstallRoot)</_PurviewSkillsRepositoryRoot>
			<_PurviewSkillsRepositoryRoot
				Condition="'$(_PurviewSkillsRepositoryRoot)' == '' AND '$(_PurviewSkillsRepoRootWasSpecified)' == 'true'"
				>$(PurviewSkillsRepoRoot)</_PurviewSkillsRepositoryRoot>
		</PropertyGroup>

		<FindPurviewRepositoryRoot
			Condition="'$(_PurviewSkillsRepositoryRoot)' == '' AND '$(PurviewRepositoryRootMarkers)' != ''"
			StartDirectory="$(MSBuildProjectDirectory)"
			Markers="$(PurviewRepositoryRootMarkers)"
		>
			<Output TaskParameter="RepositoryRoot" PropertyName="_PurviewSkillsRepositoryRoot" />
			<Output TaskParameter="MatchedMarker" PropertyName="_PurviewSkillsRepositoryRootMarker" />
		</FindPurviewRepositoryRoot>

		<Message
			Importance="Low"
			Condition="'$(_PurviewSkillsRepositoryRootMarker)' != ''"
			Text="Purview Skills: repository root '$(_PurviewSkillsRepositoryRoot)' found by marker '$(_PurviewSkillsRepositoryRootMarker)'."
		/>

		<PropertyGroup>
			<!-- Below the marker walk: these are guesses, and a marker is the better one. -->
			<_PurviewSkillsRepositoryRoot
				Condition="'$(_PurviewSkillsRepositoryRoot)' == '' AND '$(PurviewSkillsRepoRoot)' != ''"
				>$(PurviewSkillsRepoRoot)</_PurviewSkillsRepositoryRoot>
			<_PurviewSkillsRepositoryRoot Condition="'$(_PurviewSkillsRepositoryRoot)' == '' AND '$(RepoRoot)' != ''"
				>$(RepoRoot)</_PurviewSkillsRepositoryRoot>

			<!-- A CI agent often checks out without the markers above being reachable from the
			     project, but always says where the workspace is. -->
			<_PurviewSkillsRepositoryRoot
				Condition="'$(_PurviewSkillsRepositoryRoot)' == '' AND '$(GITHUB_WORKSPACE)' != '' AND Exists('$(GITHUB_WORKSPACE)')"
				>$(GITHUB_WORKSPACE)</_PurviewSkillsRepositoryRoot>
			<_PurviewSkillsRepositoryRoot
				Condition="'$(_PurviewSkillsRepositoryRoot)' == '' AND '$(BUILD_SOURCESDIRECTORY)' != '' AND Exists('$(BUILD_SOURCESDIRECTORY)')"
				>$(BUILD_SOURCESDIRECTORY)</_PurviewSkillsRepositoryRoot>
			<_PurviewSkillsRepositoryRoot
				Condition="'$(_PurviewSkillsRepositoryRoot)' == '' AND '$(CI_PROJECT_DIR)' != '' AND Exists('$(CI_PROJECT_DIR)')"
				>$(CI_PROJECT_DIR)</_PurviewSkillsRepositoryRoot>

			<_PurviewSkillsRepositoryRoot Condition="'$(_PurviewSkillsRepositoryRoot)' == ''"
				>@(_PurviewSkillsSourceRoot)</_PurviewSkillsRepositoryRoot>
		</PropertyGroup>
	</Target>

	<!-- =====================================================================
	     SKILLS CLI LAUNCHER
	     The CLI is published to npm, and a repository standardises on one
	     package runner. Each runner spells "run this npm package" its own way,
	     so the SDK maps a runner name to a launcher rather than assuming npx:

	       npx    npx -y skills@1          (ships with Node; the default)
	       bunx   bunx skills@1
	       bun    bun x skills@1
	       pnpm   pnpm dlx skills@1
	       yarn   yarn dlx skills@1        (Yarn 2+; Yarn 1 has no 'dlx')
	       deno   deno run -A npm:skills@1
	       skills skills                   (already on PATH; no download)

	     A runner this SDK does not know is still usable: it falls through to
	     '<runner> <package>', which is the form most new runners adopt.

	     Two launchers are produced on purpose. The executed one pins the CLI
	     to a major so a breaking release cannot change what the install target
	     does; the displayed one drops the pin, because a recommendation is a
	     command for a person to run and 'npx skills add' is the form they know.
	     ===================================================================== -->
	<ItemGroup>
		<PurviewSkillsRunnerLauncher Include="skills">
			<Exec>skills</Exec>
			<Display>skills</Display>
		</PurviewSkillsRunnerLauncher>
		<PurviewSkillsRunnerLauncher Include="npx">
			<Exec>npx -y $(PurviewSkillsPackage)</Exec>
			<Display>npx skills</Display>
		</PurviewSkillsRunnerLauncher>
		<PurviewSkillsRunnerLauncher Include="bunx">
			<Exec>bunx $(PurviewSkillsPackage)</Exec>
			<Display>bunx skills</Display>
		</PurviewSkillsRunnerLauncher>
		<PurviewSkillsRunnerLauncher Include="bun">
			<Exec>bun x $(PurviewSkillsPackage)</Exec>
			<Display>bun x skills</Display>
		</PurviewSkillsRunnerLauncher>
		<PurviewSkillsRunnerLauncher Include="pnpm">
			<Exec>pnpm dlx $(PurviewSkillsPackage)</Exec>
			<Display>pnpm dlx skills</Display>
		</PurviewSkillsRunnerLauncher>
		<PurviewSkillsRunnerLauncher Include="yarn">
			<Exec>yarn dlx $(PurviewSkillsPackage)</Exec>
			<Display>yarn dlx skills</Display>
		</PurviewSkillsRunnerLauncher>
		<PurviewSkillsRunnerLauncher Include="deno">
			<Exec>deno run -A npm:$(PurviewSkillsPackage)</Exec>
			<Display>deno run -A npm:skills</Display>
		</PurviewSkillsRunnerLauncher>
	</ItemGroup>

	<!-- =====================================================================
	     EXPLICIT SKILL INSTALLATION
	     Neither target has BeforeTargets/AfterTargets, so neither runs during
	     restore, build, a design-time build or a test run. Installing agent
	     content is a thing a person asks for:

	       dotnet msbuild <project> -t:ListPurviewSkills
	       dotnet msbuild <project> -t:InstallPurviewSkills

	     Installation itself is delegated to the skills CLI rather than
	     reimplemented. The CLI owns the agent-specific destinations and their
	     discovery conventions, which differ per agent and change independently
	     of this SDK; it also owns skills-lock.json, so a repository can restore
	     the same skills later with 'npx skills experimental_install'.
	     ===================================================================== -->
	<Target
		Name="ResolvePurviewSkillsTarget"
		Condition="'$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)'"
		Label="Resolves the skills shipped by restored packages to their git source and commit."
	>
		<!-- An explicit PurviewSkillsSource does not come from the restore graph, so it must not
		     require one: installing from a named repository works in a project that has never
		     been restored. -->
		<Error
			Code="PRSKL0001"
			Condition="!Exists('$(ProjectAssetsFile)') AND '$(PurviewSkillsSource)' == ''"
			Text="Cannot resolve Purview skills because '$(ProjectAssetsFile)' does not exist. Run 'dotnet restore' first - skill resolution reads the restore graph and deliberately does not trigger a restore of its own."
		/>
		<ResolvePurviewSkillSources
			Condition="Exists('$(ProjectAssetsFile)')"
			ProjectAssetsFile="$(ProjectAssetsFile)"
			NuGetPackageFolders="$(NuGetPackageFolders)"
		>
			<Output TaskParameter="SkillSources" ItemName="PurviewSkillSource" />
			<Output TaskParameter="Unresolvable" ItemName="PurviewUnresolvableSkillSource" />
		</ResolvePurviewSkillSources>
	</Target>

	<Target
		Name="ListPurviewSkills"
		DependsOnTargets="ResolvePurviewSkillsRepositoryRoot;ResolvePurviewSkillsTarget"
		Label="Lists the skills shipped by every restored package, without installing anything."
	>
		<Message
			Importance="High"
			Condition="'@(PurviewSkillSource)' == '' AND '@(PurviewUnresolvableSkillSource)' == ''"
			Text="No restored package ships agent skills."
		/>
		<Message
			Importance="High"
			Condition="'@(PurviewSkillSource)' != ''"
			Text="%(PurviewSkillSource.PackageId) %(PurviewSkillSource.PackageVersion) -> %(PurviewSkillSource.SourceWithRef) [%(PurviewSkillSource.SkillCount) skill(s): %(PurviewSkillSource.Skills)]"
		/>
		<!-- A package whose skills cannot be pinned is reported, never silently installed from a
		     default branch that may not match the restored package version. -->
		<Warning
			Code="PRSKL0002"
			Condition="'@(PurviewUnresolvableSkillSource)' != ''"
			Text="%(PurviewUnresolvableSkillSource.PackageId) %(PurviewUnresolvableSkillSource.PackageVersion) ships %(PurviewUnresolvableSkillSource.SkillCount) skill(s) that cannot be installed reproducibly because %(PurviewUnresolvableSkillSource.Reason). Install them explicitly with a pinned ref, or ask the package author to publish it with repository metadata."
		/>

		<!-- Report whether installing would work, so the answer is known before committing to it.
		     This target installs nothing, so a missing CLI is reported here, never an error. -->
		<DetectPurviewSkillsCli
			CommandNames="skills;$(PurviewSkillsRunner);$(PurviewSkillsRunnerCandidates)"
			Condition="'$(PurviewSkillsCommand)' == ''"
		>
			<Output TaskParameter="FoundCommand" PropertyName="_PurviewSkillsCliCommand" />
			<Output TaskParameter="FoundPath" PropertyName="_PurviewSkillsCliPath" />
		</DetectPurviewSkillsCli>
		<Message
			Importance="High"
			Condition="'$(_PurviewSkillsCliPath)' != ''"
			Text="Skills CLI: '$(_PurviewSkillsCliCommand)' found at $(_PurviewSkillsCliPath). Run -t:InstallPurviewSkills to install."
		/>
		<Message
			Importance="High"
			Condition="'$(PurviewSkillsCommand)' == '' AND '$(_PurviewSkillsCliPath)' == ''"
			Text="Skills CLI: no runner found on PATH. Installing needs one of 'skills', '$(PurviewSkillsRunner)' or '$(PurviewSkillsRunnerCandidates)'."
		/>
		<Message
			Importance="High"
			Condition="'$(_PurviewSkillsRepositoryRoot)' != ''"
			Text="Skills are installed from the repository root: $(_PurviewSkillsRepositoryRoot)"
		/>
	</Target>

	<Target
		Name="InstallPurviewSkills"
		DependsOnTargets="ResolvePurviewSkillsRepositoryRoot;ResolvePurviewSkillsTarget"
		Label="Installs the skills shipped by restored packages into the agent directories, via the skills CLI."
	>
		<PropertyGroup>
			<!-- '*' installs to every agent the CLI detects. Narrow it with
			     -p:PurviewSkillsAgents=claude-code,codex for a single agent. -->
			<PurviewSkillsAgents Condition="'$(PurviewSkillsAgents)' == ''">*</PurviewSkillsAgents>
			<!-- A failed install is a failed install: the caller asked for it explicitly, so it is
			     reported rather than swallowed. Set true to continue past one package's failure. -->
			<PurviewSkillsContinueOnError Condition="'$(PurviewSkillsContinueOnError)' == ''"
				>false</PurviewSkillsContinueOnError>
		</PropertyGroup>

		<!-- PurviewSkillsSource installs straight from a git source, bypassing package resolution:
		       -t:InstallPurviewSkills -p:PurviewSkillsSource=purview-dev/engineering-playbook
		     Useful for a repository that wants a Purview skill it has no PackageReference for. The
		     caller owns the ref in that case; append '#<ref>' to pin it. -->
		<ItemGroup Condition="'$(PurviewSkillsSource)' != ''">
			<PurviewSkillSource Include="$(PurviewSkillsSource)">
				<SourceWithRef>$(PurviewSkillsSource)</SourceWithRef>
				<Skills>*</Skills>
				<PackageId>(explicit source)</PackageId>
			</PurviewSkillSource>
		</ItemGroup>

		<Message
			Importance="High"
			Condition="'@(PurviewSkillSource)' == ''"
			Text="No restored package ships installable agent skills. Run -t:ListPurviewSkills for detail."
		/>

		<!-- Detect before invoking, so a missing runner is an actionable message rather than a shell
		     error. Only when there is actually something to install: resolving nothing must not
		     require Node to be present.

		     'skills' on PATH is tried first because it needs no download at all, then the configured
		     runner, then the remaining candidates - so a machine with bun but no Node still installs
		     rather than reporting that nothing was found. -->
		<DetectPurviewSkillsCli
			CommandNames="skills;$(PurviewSkillsRunner);$(PurviewSkillsRunnerCandidates)"
			Condition="'@(PurviewSkillSource)' != '' AND '$(PurviewSkillsCommand)' == ''"
		>
			<Output TaskParameter="FoundCommand" PropertyName="_PurviewSkillsCliCommand" />
			<Output TaskParameter="FoundPath" PropertyName="_PurviewSkillsCliPath" />
		</DetectPurviewSkillsCli>

		<!-- The runner that was actually found wins over the configured preference: it is the one
		     this machine can really run. A runner with no entry in the map falls through to
		     '<runner> <package>', so a runner this SDK has never heard of is still honoured. -->
		<PropertyGroup Condition="'$(PurviewSkillsCommand)' == '' AND '$(_PurviewSkillsCliCommand)' != ''">
			<PurviewSkillsCommand>@(PurviewSkillsRunnerLauncher->WithMetadataValue('Identity', '$(_PurviewSkillsCliCommand)')->'%(Exec)')</PurviewSkillsCommand>
			<PurviewSkillsCommand Condition="'$(PurviewSkillsCommand)' == ''"
				>$(_PurviewSkillsCliCommand) $(PurviewSkillsPackage)</PurviewSkillsCommand>
		</PropertyGroup>

		<Message
			Importance="High"
			Condition="'@(PurviewSkillSource)' != '' AND '$(_PurviewSkillsCliPath)' != ''"
			Text="Using the skills CLI via '$(PurviewSkillsCommand)' ($(_PurviewSkillsCliPath))."
		/>

		<Error
			Code="PRSKL0004"
			Condition="'@(PurviewSkillSource)' != '' AND '$(PurviewSkillsCommand)' == ''"
			Text="Cannot install agent skills: none of 'skills', '$(PurviewSkillsRunner)' or '$(PurviewSkillsRunnerCandidates)' was found on PATH. Install Node.js (which provides npx), or any of bun, pnpm, yarn or deno, or install the CLI globally with 'npm install -g skills', then re-run this target. To resolve and report skills without installing, use -t:ListPurviewSkills, which needs no Node tooling. To choose a runner, set -p:PurviewSkillsRunner=&lt;npx|bunx|pnpm|yarn|deno&gt;; to override the launcher entirely, set -p:PurviewSkillsCommand=&lt;command&gt;."
		/>

		<!-- One invocation per package. '-y' keeps it non-interactive, and re-running is idempotent:
		     the CLI skips a skill already installed from the same source and ref.

		     The skills are named explicitly rather than installed with '*', so a source repository
		     that also holds skills this package does not ship contributes only what was resolved.
		     The skill flag must be *repeated*: the CLI does not split a comma-separated value, it
		     matches nothing and reports "No matching skills found". So the ';' separating the
		     resolved names is rewritten into a further skill flag. -->
		<!-- The lockfile and the agent directories belong to the repository, so the CLI always runs
		     from the repository root. Installing from a project folder would scatter one of each
		     through the tree, so an unresolved root is reported rather than guessed at. -->
		<Error
			Code="PRSKL0003"
			Condition="'@(PurviewSkillSource)' != '' AND '$(_PurviewSkillsRepositoryRoot)' == ''"
			Text="Cannot install agent skills: the repository root could not be resolved. The skills CLI writes skills-lock.json and the agent directories, and both belong to the repository rather than to a project, so this target will not fall back to the project folder. Set -p:PurviewSkillsInstallRoot=&lt;path&gt; (or RepoRoot), or add an AGENTS.md at the repository root."
		/>

		<Exec
			Condition="'@(PurviewSkillSource)' != '' AND '$(_PurviewSkillsRepositoryRoot)' != ''"
			Command="$(PurviewSkillsCommand) add &quot;%(PurviewSkillSource.SourceWithRef)&quot; --skill &quot;$([System.String]::Copy('%(PurviewSkillSource.Skills)').Replace(';', '&quot; --skill &quot;'))&quot; --agent &quot;$(PurviewSkillsAgents)&quot; -y"
			WorkingDirectory="$(_PurviewSkillsRepositoryRoot)"
			ContinueOnError="$(PurviewSkillsContinueOnError)"
			StandardOutputImportance="High"
		/>

		<Warning
			Code="PRSKL0002"
			Condition="'@(PurviewUnresolvableSkillSource)' != ''"
			Text="%(PurviewUnresolvableSkillSource.PackageId) %(PurviewUnresolvableSkillSource.PackageVersion) ships %(PurviewUnresolvableSkillSource.SkillCount) skill(s) that cannot be installed reproducibly because %(PurviewUnresolvableSkillSource.Reason). Install them explicitly with a pinned ref, or ask the package author to publish it with repository metadata."
		/>
	</Target>

	<!-- =====================================================================
	     SKILL RECOMMENDATIONS
	     The one skill feature that runs during an ordinary build. It reads
	     the restore graph and the skills CLI's own lockfile, both local, so
	     it stays offline; it recommends commands and never runs them; and it
	     never fails a build, because a missing skill is advice, not a defect.

	     Three things keep it quiet:

	       * a design-time build, a CI build and a non-default TFM pass are
	         all skipped outright,
	       * a repository-level stamp means a given state is reported once,
	         not once per project and again on every rebuild, and
	       * a correctly installed set produces no output at all.

	     Severity splits on what the developer can act on. A missing or
	     version-drifted skill is something they can fix with one command, so
	     it is a warning. An unverifiable or orphaned one usually is not -
	     a package without SourceLink metadata cannot be pinned by anybody -
	     so it is a message, and no amount of it can break a build that
	     treats warnings as errors.
	     ===================================================================== -->
	<Target
		Name="_ResolvePurviewSkillRecommendationPaths"
		DependsOnTargets="ResolvePurviewSkillsRepositoryRoot"
		Label="Resolves the repository-level lockfile and stamp paths skill recommendations read."
	>
		<PropertyGroup>
			<!-- Everything read here is repository-scoped, so there is no project-directory fallback:
			     an unresolved root means the recommendation pass simply says nothing, because a build
			     is never a place to fail over optional advice. -->
			<_PurviewSkillRecommendationRoot Condition="'$(_PurviewSkillRecommendationRoot)' == ''"
				>$(_PurviewSkillsRepositoryRoot)</_PurviewSkillRecommendationRoot>
			<!-- Where the CLI writes it for a project-scope install: beside the repository root. -->
			<PurviewSkillsLockFile
				Condition="'$(PurviewSkillsLockFile)' == '' AND '$(_PurviewSkillRecommendationRoot)' != ''"
				>$([MSBuild]::NormalizePath('$(_PurviewSkillRecommendationRoot)', 'skills-lock.json'))</PurviewSkillsLockFile>
			<PurviewSkillRecommendationStampPath
				Condition="'$(PurviewSkillRecommendationStampPath)' == '' AND '$(_PurviewSkillRecommendationRoot)' != ''"
				>$([MSBuild]::NormalizePath('$(_PurviewSkillRecommendationRoot)', '.purview', 'skill-recommendations.cache'))</PurviewSkillRecommendationStampPath>
			<!-- The explicit target always reports; only the build hook honours the stamp. -->
			<_PurviewSkillRespectStamp Condition="'$(_PurviewSkillRespectStamp)' == ''"
				>false</_PurviewSkillRespectStamp>
			<PurviewSkillsAgents Condition="'$(PurviewSkillsAgents)' == ''">*</PurviewSkillsAgents>
			<!-- Recommendation text is written against the *configured* runner, not a detected one:
			     advice costs no PATH probe, and the command a developer copies should be the one
			     their repository standardised on. -->
			<_PurviewSkillsCommandDisplay>@(PurviewSkillsRunnerLauncher->WithMetadataValue('Identity', '$(PurviewSkillsRunner)')->'%(Display)')</_PurviewSkillsCommandDisplay>
			<_PurviewSkillsCommandDisplay Condition="'$(_PurviewSkillsCommandDisplay)' == ''"
				>$(PurviewSkillsRunner) skills</_PurviewSkillsCommandDisplay>
		</PropertyGroup>
	</Target>

	<Target
		Name="RecommendPurviewSkills"
		DependsOnTargets="_ResolvePurviewSkillRecommendationPaths;ResolvePurviewSkillsTarget"
		Condition="'$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)'"
		Label="Reports which Purview skills are missing, drifted or unverifiable, and how to fix each."
	>
		<!-- The unresolved-root guard is on the task, not on the target: a target's Condition is
		     evaluated before its DependsOnTargets run, so a property one of them computes is still
		     empty there. An unresolved root simply reports nothing - a build never fails over advice. -->
		<EvaluatePurviewSkillState
			Condition="'$(_PurviewSkillRecommendationRoot)' != ''"
			CommandPrefix="$(_PurviewSkillsCommandDisplay)"
			SkillSources="@(PurviewSkillSource)"
			UnresolvableSkillSources="@(PurviewUnresolvableSkillSource)"
			LockFilePath="$(PurviewSkillsLockFile)"
			StampPath="$(PurviewSkillRecommendationStampPath)"
			RespectStamp="$(_PurviewSkillRespectStamp)"
			Agents="$(PurviewSkillsAgents)"
			RepositoryRoot="$(_PurviewSkillRecommendationRoot)"
		>
			<Output TaskParameter="Missing" ItemName="PurviewMissingSkill" />
			<Output TaskParameter="Drifted" ItemName="PurviewDriftedSkill" />
			<Output TaskParameter="Unknown" ItemName="PurviewUnverifiableSkill" />
			<Output TaskParameter="Satisfied" ItemName="PurviewSatisfiedSkill" />
			<Output TaskParameter="Orphaned" ItemName="PurviewOrphanedSkill" />
			<Output TaskParameter="LockFileFound" PropertyName="_PurviewSkillsLockFileFound" />
			<Output TaskParameter="AgentSkillDirectoriesFound" PropertyName="_PurviewAgentSkillDirectoriesFound" />
			<Output TaskParameter="ShouldReport" PropertyName="_PurviewSkillStateChanged" />
		</EvaluatePurviewSkillState>

		<!-- One warning per package, carrying the exact command that fixes it. -->
		<Warning
			Code="PRSKL0010"
			Condition="'$(_PurviewSkillStateChanged)' == 'true' AND '@(PurviewMissingSkill)' != ''"
			Text="Purview Skills: %(PurviewMissingSkill.PackageId) %(PurviewMissingSkill.PackageVersion) ships %(PurviewMissingSkill.SkillCount) agent skill(s) that are not installed: %(PurviewMissingSkill.Skills). Install them with: %(PurviewMissingSkill.Command)"
		/>

		<!-- Drift is the compatible-update case, and the command is pinned on purpose.
		     'npx skills update' installs the newest published skill, which is only correct when
		     the newest skill happens to describe the referenced package version - something that
		     cannot be known offline, and is false for any project that is not on the latest
		     package. Recommending it here would be exactly the "blindly recommended update" the
		     design forbids, so the referenced package's own commit is named instead. -->
		<Warning
			Code="PRSKL0011"
			Condition="'$(_PurviewSkillStateChanged)' == 'true' AND '@(PurviewDriftedSkill)' != ''"
			Text="Purview Skills: %(PurviewDriftedSkill.PackageId) %(PurviewDriftedSkill.PackageVersion) was built from commit %(PurviewDriftedSkill.RepositoryCommit), but these skills are installed from a different ref: %(PurviewDriftedSkill.InstalledRefs). They may describe a different version of the library than the one referenced. Install the matching skills with: %(PurviewDriftedSkill.Command). Prefer this over '$(_PurviewSkillsCommandDisplay) update', which installs the newest published skill regardless of which package version this project references."
		/>

		<!-- Not actionable by the consumer in the common case, so it never becomes a warning. -->
		<Message
			Importance="High"
			Condition="'$(_PurviewSkillStateChanged)' == 'true' AND '@(PurviewUnverifiableSkill)' != ''"
			Text="PRSKL0012: Purview Skills: compatibility of %(PurviewUnverifiableSkill.SkillCount) skill(s) from %(PurviewUnverifiableSkill.PackageId) %(PurviewUnverifiableSkill.PackageVersion) cannot be verified because %(PurviewUnverifiableSkill.Reason). Inspect what is installed with: $(_PurviewSkillsCommandDisplay) list"
		/>

		<!-- Owner-scoped, so a skill the developer installed themselves is never named. -->
		<Message
			Importance="High"
			Condition="'$(_PurviewSkillStateChanged)' == 'true' AND '@(PurviewOrphanedSkill)' != ''"
			Text="PRSKL0013: Purview Skills: '%(PurviewOrphanedSkill.Skill)' is installed from '%(PurviewOrphanedSkill.Source)', which this project no longer references. Remove it if it is no longer wanted: %(PurviewOrphanedSkill.Command)"
		/>

		<!-- A committed lockfile with nothing restored beside it: the one case experimental_install
		     is actually for. It is a suggestion, never run automatically, and it is flagged as
		     experimental because the CLI flags it that way. -->
		<Message
			Importance="High"
			Condition="'$(_PurviewSkillStateChanged)' == 'true' AND '$(_PurviewSkillsLockFileFound)' == 'true' AND '$(_PurviewAgentSkillDirectoriesFound)' != 'true'"
			Text="PRSKL0014: Purview Skills: '$(PurviewSkillsLockFile)' lists installed skills, but no agent skill directory exists in this repository. Restore them with: $(_PurviewSkillsCommandDisplay) experimental_install (experimental; '$(_PurviewSkillsCommandDisplay) add' is the supported fallback)."
		/>
	</Target>

	<Target
		Name="_PurviewSkillRecommendationBuildSetup"
		Label="Opts the build-time recommendation pass into stamp-based deduplication."
	>
		<PropertyGroup>
			<_PurviewSkillRespectStamp>true</_PurviewSkillRespectStamp>
		</PropertyGroup>
	</Target>

	<!-- Build integration lives in its own target so RecommendPurviewSkills itself keeps no
	     BeforeTargets/AfterTargets, and a consumer can still invoke it explicitly with none of
	     this gating applied. Nothing here installs: this is the recommendation half only, and
	     InstallPurviewSkills remains a thing a person asks for by name. -->
	<Target
		Name="RecommendPurviewSkillsOnBuild"
		AfterTargets="Build"
		DependsOnTargets="_PurviewSkillRecommendationBuildSetup;RecommendPurviewSkills"
		Condition="'$(EnablePurviewSkillRecommendations)' == 'true'
			AND '$(DesignTimeBuild)' != 'true'
			AND '$(BuildingProject)' == 'true'
			AND Exists('$(ProjectAssetsFile)')
			AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')
			AND ('$(PurviewSkillRecommendationsInCI)' == 'true'
				OR ('$(ContinuousIntegrationBuild)' != 'true' AND '$(TF_BUILD)' != 'true'
					AND '$(GITHUB_ACTIONS)' != 'true' AND '$(CI)' != 'true'))"
		Label="Reports skill recommendations after an ordinary, interactive build."
	/>

	<Target
		Name="IncludeLinkedSdkFiles"
		Condition="'$(PurviewAutoSdkPack)' == 'true' AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Packs external files linked beneath Sdk/ using the same paths as physical Sdk files."
	>
		<ItemGroup>
			<_PurviewLinkedSdkFile
				Include="@(None)"
				Condition="$([System.String]::Copy('%(None.Link)').StartsWith('Sdk\')) OR $([System.String]::Copy('%(None.Link)').StartsWith('Sdk/'))"
			>
				<PackagePath>$([System.String]::Copy('%(None.Link)').Substring(4).Replace('\', '/'))</PackagePath>
			</_PurviewLinkedSdkFile>
			<TfmSpecificPackageFile Include="@(_PurviewLinkedSdkFile)" />
		</ItemGroup>
	</Target>

	<!-- =====================================================================
	     VALIDATE REPOSITORY SKILLS
	     Skills are authored at the repository root in skills/<name>/SKILL.md
	     and published only through the skills CLI, which clones the git
	     repository. Nothing is packed into the NuGet package - see the
	     Repository Skills Folder block in Sdk.props.

	     This target is what keeps a malformed skill from reaching the CLI: it
	     runs at pack time in the repository that owns the skills, so the
	     failure lands on the author rather than silently producing a skill the
	     CLI skips.
	     ===================================================================== -->
	<Target
		Name="ValidatePurviewSkills"
		BeforeTargets="Pack"
		Condition="'$(PurviewSkillsSourceFolder)' != '' AND Exists('$(PurviewSkillsSourceFolder)')"
		Label="Validates that every authored skill is well formed."
	>
		<ValidatePurviewSkillFolders SkillsRoot="$(PurviewSkillsSourceFolder)">
			<Output TaskParameter="Failures" ItemName="_PurviewSkillValidationFailure" />
		</ValidatePurviewSkillFolders>
		<Error
			Code="PRSKL0005"
			Condition="'@(_PurviewSkillValidationFailure)' != ''"
			Text="%(_PurviewSkillValidationFailure.Identity)"
		/>
		<Message
			Importance="Low"
			Condition="'@(_PurviewSkillValidationFailure)' == ''"
			Text="Authored skills in '$(PurviewSkillsSourceFolder)' are well formed."
		/>
	</Target>

	<!-- =====================================================================
	     REPOSITORY README PACKAGING
	     Packs the repository-root README for packable projects when the file
	     exists and PackageReadmeFile has not been explicitly configured.
	     Skips when a README-named file is already being packed so no duplicate
	     packed README items are produced.
	     ===================================================================== -->
	<Target
		Name="IncludeRepoReadmeInPackage"
		DependsOnTargets="IncludeLinkedSdkFiles"
		Condition="'$(IsPackable)' == 'true' AND '$(PackageReadmeFile)' == 'README.md' AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Packs a project's own README, or the repository-root one, when PackageReadmeFile is unset."
	>
		<ItemGroup>
			<_PurviewPackedReadme
				Include="@(None)"
				Condition="'%(None.Pack)' == 'true' AND $([System.String]::Copy('%(None.Filename)').ToLowerInvariant()) == 'readme'"
			/>
			<_PurviewPackedReadme
				Include="@(None)"
				Condition="($([System.String]::Copy('%(None.Link)').ToLowerInvariant()) == 'sdk/readme.md' OR $([System.String]::Copy('%(None.Link)').ToLowerInvariant()) == 'sdk\readme.md')"
			/>
			<_PurviewPackedReadme
				Include="@(TfmSpecificPackageFile)"
				Condition="$([System.String]::Copy('%(TfmSpecificPackageFile.Filename)').ToLowerInvariant()) == 'readme'"
			/>
		</ItemGroup>
		<!-- A project's own README wins over the repository's. A repository that produces several
		     packages has several stories to tell, and shipping the repository README in every one
		     tells the reader about the other packages instead of the one they installed. The
		     repository README stays the fallback for a single-package repository, where the two
		     are the same document. -->
		<PropertyGroup Condition="'@(_PurviewPackedReadme)' == ''">
			<_PurviewReadmeToPack Condition="Exists('$(MSBuildProjectDirectory)/README.md')"
				>$(MSBuildProjectDirectory)/README.md</_PurviewReadmeToPack>
			<_PurviewReadmeToPack
				Condition="'$(_PurviewReadmeToPack)' == '' AND '$(RepoRoot)' != '' AND Exists('$(RepoRoot)/README.md')"
				>$(RepoRoot)/README.md</_PurviewReadmeToPack>
		</PropertyGroup>
		<ItemGroup Condition="'$(_PurviewReadmeToPack)' != ''">
			<TfmSpecificPackageFile Include="$(_PurviewReadmeToPack)">
				<PackagePath>/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!-- 
		VALIDATE Testing Framework.
	-->
	<Target Name="ValidateTestingFramework" BeforeTargets="Build;Restore;Pack">
		<Error
			Condition="
				'$(_TestingFrameworkNormalized)' != '' AND
				'$(_TestingFrameworkNormalized)' != 'none' AND
				'$(_TestingFrameworkNormalized)' != 'tunit' AND
				'$(_TestingFrameworkNormalized)' != 'xunit'"
			Text="Invalid TestingFramework value '$(TestingFramework)'. Supported values are: None, Xunit, and TUnit (default)."
		/>
	</Target>

	<!-- 
		VALIDATE Substitution Framework.
	-->
	<Target Name="ValidateSubstituteFramework" BeforeTargets="Build;Restore;Pack">
		<Error
			Condition="
				'$(_SubstituteFrameworkNormalized)' != '' AND
				'$(_SubstituteFrameworkNormalized)' != 'none' AND
				'$(_SubstituteFrameworkNormalized)' != 'nsubstitute' AND
				'$(_SubstituteFrameworkNormalized)' != 'tunitmocks'"
			Text="Invalid SubstituteFramework value '$(SubstituteFramework)'. Supported values are: None, NSubstitute, and TUnitMocks (default)."
		/>
	</Target>

	<!-- 
		VALIDATE Testing Data Framework.
	-->
	<Target Name="ValidateTestingDataFramework" BeforeTargets="Build;Restore;Pack">
		<Error
			Condition="
				'$(_TestDataFrameworkNormalized)' != '' AND
				'$(_TestDataFrameworkNormalized)' != 'none' AND
				'$(_TestDataFrameworkNormalized)' != 'bogus'"
			Text="Invalid TestDataFramework value '$(TestDataFramework)'. Supported values are: None, and Bogus (default)."
		/>
	</Target>

	<!-- =====================================================================
	     STYLE POLICY VALIDATION (PRSGD0006-PRSGD0009)
	     The modifier/visibility policy ('dotnet_style_require_accessibility_modifiers =
	     omit_if_default', plus IDE0040/CA1515/CA1852/CA1034 and the api-surface rules) and the
	     field-naming policy (private instance fields are '_camelCase', never 'camelCase') are part of
	     the SDK's code-style contract. Repositories must not neuter them by overriding the options,
	     disabling the rules, disabling the Style category in bulk, or adding the rules to NoWarn:
	     everything the policy reports is fixed, not suppressed (a declared modifier that matches the
	     language default is removed, a field is renamed to '_name', and so on).
	     Opt out with DisablePurviewStylePolicyValidation=true. Entries the SDK injects itself for a
	     project shape (currently CA1515 for Aspire hosts and CLI apps, whose nested public options
	     types are framework-mandated) are passed in through AllowedNoWarn and do not fail PRSGD0008.
	     ===================================================================== -->
	<UsingTask
		TaskName="ValidatePurviewStylePolicy"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<ProjectDirectory ParameterType="System.String" Required="true" />
			<NoWarn ParameterType="System.String" Required="false" />
			<AllowedNoWarn ParameterType="System.String" Required="false" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					// Purview accessibility policy validation (PRSGD0006-PRSGD0008).
					var policyRules = new[]
					{
						"IDE0040", "CA1515", "CA1852", "CA1034", "CA1012", "CA1047", "CA1050", "CA1051",
						"CA1062", "CA1064", "CA1707"
					};
					var mustStayAtWarning = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
					{
						"IDE0040", "CA1515", "CA1852", "CA1034"
					};
					var hiddenSeverities = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
					{
						"none", "silent", "suggestion"
					};
					var offSeverities = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
					{
						"none", "silent"
					};

					// Entries the SDK itself injects for a project shape (for example CA1515 for Aspire
					// hosts and CLI apps, where nested public options types are mandated by the
					// framework) are exempt from the 'no policy rule in NoWarn' rule. Repository-authored
					// entries still fail: the allowed list only contains what the SDK appended.
					var sdkInjectedNoWarn = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					if (!string.IsNullOrEmpty(AllowedNoWarn))
					{
						foreach (var raw in AllowedNoWarn.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries))
						{
							var injectedId = raw.Trim();
							if (injectedId.Length > 0)
								sdkInjectedNoWarn.Add(injectedId);
						}
					}

					if (!string.IsNullOrEmpty(NoWarn))
					{
						foreach (var raw in NoWarn.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries))
						{
							var id = raw.Trim();
							if (id.Length == 0 || sdkInjectedNoWarn.Contains(id))
								continue;

							foreach (var rule in policyRules)
							{
								if (!string.Equals(id, rule, StringComparison.OrdinalIgnoreCase))
									continue;

								Log.LogError(null, "PRSGD0008", null, null, 0, 0, 0, 0,
									"The project silences the accessibility rule '{0}' through NoWarn. Accessibility modifier and visibility rules are part of the Purview.BuildSdk policy and must be fixed rather than suppressed; remove '{0}' from NoWarn, or set DisablePurviewStylePolicyValidation=true to opt out of this validation.", id);
							}
						}
					}

					// Walk the .editorconfig chain the way the compiler does: the nearest file wins,
					// later entries beat earlier ones, and the walk stops at a file declaring 'root = true'.
					var chain = new List<string>();
					var directory = ProjectDirectory;
					while (!string.IsNullOrEmpty(directory) && Directory.Exists(directory))
					{
						var candidate = Path.Combine(directory, ".editorconfig");
						if (File.Exists(candidate))
						{
							chain.Add(candidate);
							if (DeclaresRoot(candidate))
								break;
						}

						var trimmed = directory.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
						var parent = Path.GetDirectoryName(trimmed);
						if (string.IsNullOrEmpty(parent) || string.Equals(parent, directory, StringComparison.OrdinalIgnoreCase))
							break;

						directory = parent;
					}

					chain.Reverse();

					var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
					var sources = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
					foreach (var file in chain)
						MergeEditorConfig(file, values, sources);

					string optionValue;
					if (values.TryGetValue("dotnet_style_require_accessibility_modifiers", out optionValue))
					{
						if (!string.Equals(optionValue.Split(':')[0].Trim(), "omit_if_default", StringComparison.OrdinalIgnoreCase))
						{
							Log.LogError(null, "PRSGD0006", null, sources["dotnet_style_require_accessibility_modifiers"], 0, 0, 0, 0,
								"This repository overrides 'dotnet_style_require_accessibility_modifiers' with '{0}'. The Purview.BuildSdk modifier policy requires 'omit_if_default': a declared accessibility modifier that matches the language default is noise and must be removed. Remove the override, or set DisablePurviewStylePolicyValidation=true to opt out of this validation.", optionValue);
						}
					}

					string ide0040;
					if (values.TryGetValue("dotnet_diagnostic.IDE0040.severity", out ide0040))
					{
						if (hiddenSeverities.Contains(ide0040.Split(':')[0].Trim()))
						{
							Log.LogError(null, "PRSGD0007", null, sources["dotnet_diagnostic.IDE0040.severity"], 0, 0, 0, 0,
								"This repository sets 'dotnet_diagnostic.IDE0040.severity' to '{0}'. The accessibility modifier policy cannot be turned off or hidden; remove the override, or set DisablePurviewStylePolicyValidation=true to opt out of this validation.", ide0040);
						}
					}
					else if (IsHidden(values, "dotnet_analyzer_diagnostic.category-Style.severity") || IsHidden(values, "dotnet_analyzer_diagnostic.severity"))
					{
						Log.LogError(null, "PRSGD0007", null, chain.Count > 0 ? chain[chain.Count - 1] : null, 0, 0, 0, 0,
							"This repository disables analyzer rules in bulk, which hides IDE0040 ('dotnet_analyzer_diagnostic.*'). Configure the Style category (or all analyzers) to a visible severity, or set DisablePurviewStylePolicyValidation=true to opt out of this validation.");
					}

					foreach (var rule in policyRules)
					{
						var key = "dotnet_diagnostic." + rule + ".severity";
						string ruleSeverity;
						if (!values.TryGetValue(key, out ruleSeverity))
							continue;

						var forbidden = mustStayAtWarning.Contains(rule) ? hiddenSeverities : offSeverities;
						if (!forbidden.Contains(ruleSeverity.Split(':')[0].Trim()))
							continue;

						Log.LogError(null, "PRSGD0007", null, sources[key], 0, 0, 0, 0,
							"This repository sets '{0}' to '{1}'. The accessibility policy requires '{0}' to stay at warning or above; remove the override, or set DisablePurviewStylePolicyValidation=true to opt out of this validation.", key, ruleSeverity);
					}

					// Field-naming policy: private instance fields must be '_camelCase', and the naming
					// diagnostic that reports the violation must stay visible.
					var namingSeverityKey = "dotnet_diagnostic.IDE1006.severity";
					string namingSeverity;
					if (values.TryGetValue(namingSeverityKey, out namingSeverity))
					{
						if (hiddenSeverities.Contains(namingSeverity.Split(':')[0].Trim()))
						{
							Log.LogError(null, "PRSGD0009", null, sources[namingSeverityKey], 0, 0, 0, 0,
								"This repository sets '{0}' to '{1}', which hides every naming rule - including the '_'-prefixed private instance field rule. Keep it at warning or above (a stale bootstrapped .editorconfig can be refreshed with PurviewRepoBootstrapMode=Always), or set DisablePurviewStylePolicyValidation=true to opt out of this validation.", namingSeverityKey, namingSeverity);
						}
					}

					var fieldNamingRuleKey = "dotnet_naming_rule.private_instance_fields_must_be_camel_case_with_underscore_prefix.severity";
					string fieldNamingSeverity;
					if (values.TryGetValue(fieldNamingRuleKey, out fieldNamingSeverity))
					{
						if (hiddenSeverities.Contains(fieldNamingSeverity.Split(':')[0].Trim()))
						{
							Log.LogError(null, "PRSGD0009", null, sources[fieldNamingRuleKey], 0, 0, 0, 0,
								"This repository sets '{0}' to '{1}'. Private instance fields must be named '_camelCase' so field access never needs the noisy 'this.' qualifier; keep the rule at warning or above, or set DisablePurviewStylePolicyValidation=true to opt out of this validation.", fieldNamingRuleKey, fieldNamingSeverity);
						}
					}

					var fieldNamingPrefixKey = "dotnet_naming_style.camel_case_underscore_style.required_prefix";
					string fieldNamingPrefix;
					if (
						values.TryGetValue(fieldNamingPrefixKey, out fieldNamingPrefix)
						&& !string.Equals(fieldNamingPrefix.Trim(), "_", StringComparison.Ordinal)
					)
					{
						Log.LogError(null, "PRSGD0009", null, sources[fieldNamingPrefixKey], 0, 0, 0, 0,
							"This repository sets '{0}' to '{1}'. Private instance fields must keep the '_' prefix ('_name', never 'name'); restore the prefix, or set DisablePurviewStylePolicyValidation=true to opt out of this validation.", fieldNamingPrefixKey, fieldNamingPrefix);
					}

					bool DeclaresRoot(string file)
					{
						string[] lines;
						try
						{
							lines = File.ReadAllLines(file);
						}
						catch (Exception)
						{
							return false;
						}

						foreach (var line in lines)
						{
							var text = StripComment(line).Trim();
							if (text.Length == 0 || text[0] == '[')
								continue;

							var separator = text.IndexOf('=');
							if (separator <= 0)
								continue;

							if (!string.Equals(text.Substring(0, separator).Trim(), "root", StringComparison.OrdinalIgnoreCase))
								continue;

							if (string.Equals(text.Substring(separator + 1).Trim(), "true", StringComparison.OrdinalIgnoreCase))
								return true;
						}

						return false;
					}

					void MergeEditorConfig(string file, Dictionary<string, string> target, Dictionary<string, string> targetSources)
					{
						string[] lines;
						try
						{
							lines = File.ReadAllLines(file);
						}
						catch (Exception)
						{
							return;
						}

						var section = string.Empty;
						foreach (var line in lines)
						{
							var text = StripComment(line).Trim();
							if (text.Length == 0)
								continue;

							if (text[0] == '[')
							{
								var end = text.IndexOf(']');
								section = end > 0 ? text.Substring(0, end + 1) : text;
								continue;
							}

							var separator = text.IndexOf('=');
							if (separator <= 0 || !SectionAppliesToCSharp(section))
								continue;

							var key = text.Substring(0, separator).Trim();
							target[key] = text.Substring(separator + 1).Trim();
							targetSources[key] = file;
						}
					}

					string StripComment(string line)
					{
						var index = line.IndexOf('#');
						return index < 0 ? line : line.Substring(0, index);
					}

					bool SectionAppliesToCSharp(string section)
					{
						if (section.Length == 0 || string.Equals(section, "[*]", StringComparison.OrdinalIgnoreCase))
							return true;

						return section.IndexOf(".cs", StringComparison.OrdinalIgnoreCase) >= 0;
					}

					bool IsHidden(Dictionary<string, string> source, string key)
					{
						string value;
						if (!source.TryGetValue(key, out value))
							return false;

						return hiddenSeverities.Contains(value.Split(':')[0].Trim());
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="ValidatePurviewStylePolicy"
		BeforeTargets="CoreCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisablePurviewStylePolicyValidation)' != 'true' AND '$(DesignTimeBuild)' != 'true'"
		Label="Ensures the modifier/visibility and field-naming policy is not silenced (PRSGD0006-PRSGD0009)."
	>
		<ValidatePurviewStylePolicy
			ProjectDirectory="$(MSBuildProjectDirectory)"
			NoWarn="$(NoWarn)"
			AllowedNoWarn="$(PurviewPolicyExemptNoWarn)"
		/>
	</Target>

	<Target
		Name="EnsureRepositoryGlobalJsonTarget"
		BeforeTargets="PrepareForBuild"
		DependsOnTargets="ResolvePurviewRepoBootstrapModeTarget"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableAutoCopySdkFiles)' != 'true' AND '$(BootstrapGlobalJsonToRepoRoot)' == 'true' AND '$(PurviewRepoBootstrapMode)' != 'Never'"
		Label="Bootstraps a physical global.json at the repo root for SDK/tool resolution."
	>
		<PropertyGroup>
			<_DirectoryBuildPropsDirectory>$([System.IO.Path]::GetDirectoryName('$(DirectoryBuildPropsPath)'))</_DirectoryBuildPropsDirectory>
		</PropertyGroup>
		<Exec
			Command="git -C &quot;$(_DirectoryBuildPropsDirectory)&quot; rev-parse --show-toplevel"
			ConsoleToMSBuild="true"
			IgnoreExitCode="true"
			IgnoreStandardErrorWarningFormat="true"
			StandardErrorImportance="low"
			StandardOutputImportance="low"
			Condition="'$(PurviewRepositoryRootStrategy)' == 'Git' AND '$(RepositoryGlobalJsonFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
		>
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitRepositoryRoot" />
		</Exec>
		<PropertyGroup>
			<_GitRepositoryRoot>$([System.String]::Copy('$(_GitRepositoryRoot)').Trim())</_GitRepositoryRoot>
			<_RepositoryProbe0>$(_DirectoryBuildPropsDirectory)</_RepositoryProbe0>
			<_RepositoryProbe1>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe0)\..'))</_RepositoryProbe1>
			<_RepositoryProbe2>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe1)\..'))</_RepositoryProbe2>
			<_RepositoryProbe3>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe2)\..'))</_RepositoryProbe3>
			<_RepositoryProbe4>$([System.IO.Path]::GetFullPath('$(_RepositoryProbe3)\..'))</_RepositoryProbe4>
			<_DetectedRepositoryRoot Condition="'$(_GitRepositoryRoot)' != '' AND Exists('$(_GitRepositoryRoot)')"
				>$(_GitRepositoryRoot)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe0)/.git/HEAD') OR Exists('$(_RepositoryProbe0)/.git'))"
				>$(_RepositoryProbe0)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe1)/.git/HEAD') OR Exists('$(_RepositoryProbe1)/.git'))"
				>$(_RepositoryProbe1)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe2)/.git/HEAD') OR Exists('$(_RepositoryProbe2)/.git'))"
				>$(_RepositoryProbe2)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe3)/.git/HEAD') OR Exists('$(_RepositoryProbe3)/.git'))"
				>$(_RepositoryProbe3)</_DetectedRepositoryRoot>
			<_DetectedRepositoryRoot
				Condition="'$(_DetectedRepositoryRoot)' == '' AND (Exists('$(_RepositoryProbe4)/.git/HEAD') OR Exists('$(_RepositoryProbe4)/.git'))"
				>$(_RepositoryProbe4)</_DetectedRepositoryRoot>
			<_EffectiveRepositoryGlobalJsonFilePath>$(RepositoryGlobalJsonFilePath)</_EffectiveRepositoryGlobalJsonFilePath>
			<_EffectiveRepositoryGlobalJsonFilePath
				Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' == '' AND '$(_DetectedRepositoryRoot)' != ''"
				>$([System.IO.Path]::Combine('$(_DetectedRepositoryRoot)', 'global.json'))</_EffectiveRepositoryGlobalJsonFilePath>
			<_EffectiveRepositoryGlobalJsonFilePath
				Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' == '' AND '$(_DirectoryBuildPropsDirectory)' != ''"
				>$([System.IO.Path]::Combine('$(_DirectoryBuildPropsDirectory)', 'global.json'))</_EffectiveRepositoryGlobalJsonFilePath>
			<_RepositoryGlobalJsonDirectory>$([System.IO.Path]::GetDirectoryName('$(_EffectiveRepositoryGlobalJsonFilePath)'))</_RepositoryGlobalJsonDirectory>
		</PropertyGroup>
		<PropertyGroup>
			<RepositoryGlobalJsonFilePath
				Condition="'$(RepositoryGlobalJsonFilePath)' == '' AND '$(_EffectiveRepositoryGlobalJsonFilePath)' != ''"
				>$(_EffectiveRepositoryGlobalJsonFilePath)</RepositoryGlobalJsonFilePath>
		</PropertyGroup>
		<ItemGroup Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' != ''">
			<_RepositoryGlobalJsonLines Include="{" />
			<_RepositoryGlobalJsonLines Include="  &quot;test&quot;: {" />
			<_RepositoryGlobalJsonLines Include="    &quot;runner&quot;: &quot;Microsoft.Testing.Platform&quot;" />
			<_RepositoryGlobalJsonLines Include="  }," />
			<_RepositoryGlobalJsonLines Include="  &quot;msbuild-sdks&quot;: {" />
			<_RepositoryGlobalJsonLines Include="    &quot;Purview.BuildSdk&quot;: &quot;$(PurviewBuildSdkVersionForGlobalJson)&quot;" />
			<_RepositoryGlobalJsonLines Include="  }" />
			<_RepositoryGlobalJsonLines Include="}" />
		</ItemGroup>
		<!--
			Same reasoning as the .editorconfig bootstrap: invoking the task is what costs, because MSBuild
			compiles it on first use. global.json carries no version marker, so an existing file is only
			revisited when the mode asks for it.
		-->
		<PropertyGroup>
			<_PurviewGlobalJsonDestinationExists Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' != ''"
				>$([System.IO.File]::Exists('$(_EffectiveRepositoryGlobalJsonFilePath)'))</_PurviewGlobalJsonDestinationExists>
			<_PurviewGlobalJsonNeedsSync Condition="'$(_PurviewGlobalJsonDestinationExists)' != 'true'"
				>true</_PurviewGlobalJsonNeedsSync>
			<_PurviewGlobalJsonNeedsSync
				Condition="'$(PurviewRepoBootstrapMode)' == 'Always' OR '$(PurviewRepoBootstrapMode)' == 'WarnOnDrift'"
				>true</_PurviewGlobalJsonNeedsSync>
		</PropertyGroup>
		<SyncPurviewRepositoryFiles
			DestinationFile="$(_EffectiveRepositoryGlobalJsonFilePath)"
			Lines="@(_RepositoryGlobalJsonLines)"
			OverwriteExisting="$(_PurviewRepoBootstrapOverwriteExisting)"
			VerifyExistingContent="$(_PurviewRepoBootstrapVerifyExistingContent)"
			Retries="$(PurviewRepoBootstrapCopyRetries)"
			RetryDelayMilliseconds="$(PurviewRepoBootstrapCopyRetryDelayMilliseconds)"
			TreatFailureAsError="$(PurviewRepoBootstrapCopyFailureAsError)"
			Condition="'$(_EffectiveRepositoryGlobalJsonFilePath)' != '' AND '$(_PurviewGlobalJsonNeedsSync)' == 'true'"
		/>
	</Target>

	<Target
		Name="ValidateRootNamespacePrefixTarget"
		BeforeTargets="Compile"
		Label="Validates the NamespacePrefix property is set."
		Condition="'$(DisableNamespacePrefixCheck)' != 'true'"
	>
		<Error
			Text="The NamespacePrefix property has not been set. To fix, set the `NamespacePrefix` in the `PropertyGroup` of either the .csproj file, or a Directory.Build.props file. You can disable this check by setting 'DisableNamespacePrefixCheck' to 'true'."
			ContinueOnError="false"
			Condition="'$(NamespacePrefix)' == ''"
			Code="NamespacePrefixNotSet"
			File="$(MSBuildProjectFile)"
		/>
	</Target>

	<!--<Target
		Name="ValidateTestingFrameworkConfigurationTarget"
		BeforeTargets="PrepareForBuild"
		Label="Validates testing framework configuration values."
		Condition="'$(IsCSharpProject)' == 'true'"
	>
		<PropertyGroup>
			<_AllowedTestingFrameworks>;TUnit;Xunit;None;</_AllowedTestingFrameworks>
			<_AllowedSubstituteFrameworks>;TUnitMocks;NSubstitute;None;</_AllowedSubstituteFrameworks>
			<_AllowedTestDataFrameworks>;Bogus;None;</_AllowedTestDataFrameworks>
		</PropertyGroup>
		<Error
			Text="Invalid TestingFramework '$(TestingFramework)'. Supported values: TUnit, Xunit, None."
			Condition="$([System.String]::Copy('$(_AllowedTestingFrameworks)').Contains(';$(TestingFramework);')) != 'True'"
			Code="PurviewInvalidTestingFramework"
			File="$(MSBuildProjectFile)"
		/>
		<Error
			Text="Invalid SubstituteFramework '$(SubstituteFramework)'. Supported values: TUnitMocks, NSubstitute, None."
			Condition="$([System.String]::Copy('$(_AllowedSubstituteFrameworks)').Contains(';$(SubstituteFramework);')) != 'True'"
			Code="PurviewInvalidSubstituteFramework"
			File="$(MSBuildProjectFile)"
		/>
		<Error
			Text="Invalid TestDataFramework '$(TestDataFramework)'. Supported values: Bogus, None."
			Condition="$([System.String]::Copy('$(_AllowedTestDataFrameworks)').Contains(';$(TestDataFramework);')) != 'True'"
			Code="PurviewInvalidTestDataFramework"
			File="$(MSBuildProjectFile)"
		/>
	</Target>-->

	<Target
		Name="ValidateProjectFileNamingConventionTarget"
		BeforeTargets="PrepareForBuild"
		Label="Validates the physical project directory and file naming convention."
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableProjectFileNamingConventionCheck)' != 'true'"
	>
		<PropertyGroup>
			<_PurviewProjectDirectoryName>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</_PurviewProjectDirectoryName>
			<_PurviewProjectFileNameWithoutExtension>$([System.IO.Path]::GetFileNameWithoutExtension('$(MSBuildProjectFile)'))</_PurviewProjectFileNameWithoutExtension>
		</PropertyGroup>
		<Error
			Text="Project naming convention violation: expected the .csproj filename to match its directory name. Directory '$(_PurviewProjectDirectoryName)' must contain '$(_PurviewProjectDirectoryName).csproj', but found '$(MSBuildProjectFile)'."
			ContinueOnError="false"
			Condition="'$(_PurviewProjectDirectoryName)' != '$(_PurviewProjectFileNameWithoutExtension)'"
			Code="PurviewProjectFileNameMismatch"
			File="$(MSBuildProjectFile)"
		/>
	</Target>

	<!-- =====================================================================
	     CURATED TARGET FRAMEWORK SET VALIDATION

	     An unrecognised set name would otherwise resolve to nothing and fall through to the generic
	     single-TFM default, so a typo would silently drop every target the author asked for.
	     ===================================================================== -->
	<Target
		Name="PurviewValidateTargetFrameworkSet"
		BeforeTargets="PrepareForBuild"
		Label="Validates PurviewTargetFrameworkSet names the SDK recognises."
		Condition="'$(IsCSharpProject)' == 'true' AND '$(PurviewTargetFrameworkSet)' != ''"
	>
		<Error
			Code="PurviewInvalidTargetFrameworkSet"
			File="$(MSBuildProjectFile)"
			Text="PurviewTargetFrameworkSet '$(PurviewTargetFrameworkSet)' is not recognised. Use Current, Latest, Supported, Broad or All, or set TargetFramework/TargetFrameworks directly. Redefine a set with PurviewTargetFrameworks&lt;Set&gt; (for example PurviewTargetFrameworksSupported)."
			Condition="'$(PurviewTargetFrameworkSet)' != 'Latest' AND '$(PurviewTargetFrameworkSet)' != 'Current' AND '$(PurviewTargetFrameworkSet)' != 'Supported' AND '$(PurviewTargetFrameworkSet)' != 'Broad' AND '$(PurviewTargetFrameworkSet)' != 'All'"
		/>
		<!-- Only when the component asked for a set itself. A repository-wide selection in
		     Directory.Build.props is inherited by every project including the components, which is the
		     normal arrangement - warning about it would fire on every well-configured repository. -->
		<Warning
			Code="PurviewTargetFrameworkSetIgnored"
			File="$(MSBuildProjectFile)"
			Text="'$(MSBuildProjectName)' is a Roslyn component, so the PurviewTargetFrameworkSet '$(PurviewTargetFrameworkSet)' it declares was ignored. A component targets netstandard2.0 so every compiler host can load it; remove the set, or set TargetFramework explicitly if you really intend to multi-target."
			Condition="'$(IsRoslynComponent)' == 'true' AND '$(_PurviewProjectDeclaresTargetFrameworkSet)' == 'true'"
		/>
	</Target>

	<!-- =====================================================================
	     UNCONDITIONAL PROJECT DECLARATION VALIDATION

	     This SDK is imported before the project body is evaluated, so a handful of properties have to be
	     read straight out of the project XML (see the detection block in Sdk.props). A `Condition` on one
	     of those declarations cannot be evaluated that early, so the declaration is not seen, and the SDK
	     silently applies its own default instead. The failure is quiet and the symptom is remote - most
	     damagingly, a Roslyn component whose conditioned TargetFramework never fires resolves to the
	     generic .NET default and ships an analyzer the IDE cannot load.

	     Declaring these properties unconditionally is therefore a requirement, not a style preference, and
	     it is reported here rather than left to be discovered downstream.
	     Opt out with DisableUnconditionalProjectDeclarationCheck=true.
	     ===================================================================== -->
	<Target
		Name="PurviewValidateUnconditionalProjectDeclarations"
		BeforeTargets="PrepareForBuild"
		Label="Warns when an SDK-detected property is declared with a Condition the SDK cannot evaluate."
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableUnconditionalProjectDeclarationCheck)' != 'true'"
	>
		<PropertyGroup>
			<_PurviewConditionedDeclaration>$([System.Text.RegularExpressions.Regex]::Match($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText(`$(MSBuildProjectFullPath)`)), `(?s)&lt;!--.*?--&gt;`, ``)), `(?is)&lt;(?&lt;decl&gt;TargetFrameworks?|IsRoslynComponent|IsRoslynComponentOnly|IsPackable|PurviewTargetFrameworkSet|RootNamespace)\s+[A-Za-z][\w:.-]*\s*=`).Groups['decl'].Value)</_PurviewConditionedDeclaration>
			<!--
				A conditioned declaration is only a problem when it is the *only* declaration. Declaring a
				property unconditionally and then augmenting it under a condition is a correct, common
				pattern - for example an unconditional TargetFrameworks list followed by
				'<TargetFrameworks Condition="...IsOSPlatform(`Windows`)">net48;$(TargetFrameworks)'. The
				SDK sees the unconditional declaration, so nothing is misread and there is nothing to warn
				about.
			-->
			<_PurviewConditionedDeclarationIsOnlyForm
				Condition="'$(_PurviewConditionedDeclaration)' != '' AND !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText(`$(MSBuildProjectFullPath)`)), `(?s)&lt;!--.*?--&gt;`, ``)), `(?is)&lt;$(_PurviewConditionedDeclaration)\s*&gt;`))"
				>true</_PurviewConditionedDeclarationIsOnlyForm>
		</PropertyGroup>
		<Warning
			Text="'$(MSBuildProjectName)' declares '$(_PurviewConditionedDeclaration)' only with a Condition. Purview.BuildSdk reads this property from the project XML before the project body is evaluated, so it cannot evaluate the Condition and will not see the declaration - the SDK default applies instead. Declare '$(_PurviewConditionedDeclaration)' unconditionally (a conditional declaration alongside an unconditional one is fine), or set it in a file imported before this SDK. Suppress with DisableUnconditionalProjectDeclarationCheck=true."
			Condition="'$(_PurviewConditionedDeclarationIsOnlyForm)' == 'true'"
			Code="PurviewConditionedProjectDeclaration"
			File="$(MSBuildProjectFile)"
		/>
	</Target>

	<!-- =====================================================================
	     INTERNALS VISIBLE TO
	     Generates InternalsVisibleToAttribute for Non-Test Projects based on
	     the defined TestType items so test projects can access internals.
	     Can be disabled by setting DisableAutoInternalsVisibleTo=true.
	     ===================================================================== -->
	<Target
		Name="InternalsVisibleToTarget"
		BeforeTargets="BeforeCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(DisableAutoInternalsVisibleTo)' != 'true'"
		Label="Generates InternalsVisibleToAttribute entries for all TestType variants and SharedTesting projects."
	>
		<ItemGroup>
			<!--
				One grant per *distinct, non-empty* project-name source, for each TestType.

				Each of the three sources is guarded two ways. An empty guard is required because
				TargetProjectName has no default: without it every TestType produced a malformed grant
				with an empty assembly name ('.UnitTests', '.IntegrationTests', ...), which is not a
				valid assembly identity and can never match a real test project. An equality guard
				against the earlier sources is required because AssemblyName, TargetProjectName and
				MSBuildProjectName are usually the same string, so the same grant was emitted up to
				three times.

				Together these took a shipped Purview assembly from 168 InternalsVisibleTo attributes
				(53 of them malformed) down to one per real candidate name.
			-->
			<!-- Assembly Type... -->
			<AssemblyAttribute
				Include="System.Runtime.CompilerServices.InternalsVisibleTo"
				Condition="'$(AssemblyName)' != ''"
			>
				<_Parameter1>$(AssemblyName).%(TestType.Identity)Tests</_Parameter1>
			</AssemblyAttribute>
			<!-- Project Type -->
			<AssemblyAttribute
				Include="System.Runtime.CompilerServices.InternalsVisibleTo"
				Condition="'$(TargetProjectName)' != '' AND '$(TargetProjectName)' != '$(AssemblyName)'"
			>
				<_Parameter1>$(TargetProjectName).%(TestType.Identity)Tests</_Parameter1>
			</AssemblyAttribute>
			<!-- MSBuild project name -->
			<AssemblyAttribute
				Include="System.Runtime.CompilerServices.InternalsVisibleTo"
				Condition="'$(MSBuildProjectName)' != '' AND '$(MSBuildProjectName)' != '$(AssemblyName)' AND '$(MSBuildProjectName)' != '$(TargetProjectName)'"
			>
				<_Parameter1>$(MSBuildProjectName).%(TestType.Identity)Tests</_Parameter1>
			</AssemblyAttribute>
			<!-- InternalsVisibleTo for all SharedTesting projects -->
			<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
				<_Parameter1
					Condition="'$(EnableAssemblyNameGeneration)' == 'true' AND '$(PurviewNamespacePrefix)' != ''"
					>$(PurviewNamespacePrefix).%(SharedTestingProjectName.Identity)</_Parameter1>
				<_Parameter1
					Condition="'$(EnableAssemblyNameGeneration)' != 'true' OR '$(PurviewNamespacePrefix)' == ''"
					>%(SharedTestingProjectName.Identity)</_Parameter1>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<!-- =====================================================================
	     GENERATE ASSEMBLY INFO CLASS
	     Writes a static AssemblyInfo class to the intermediate output path so
	     projects have compile-time access to version, company, etc.
	     ===================================================================== -->
	<Target
		Name="GenerateAssemblyInfoClassTarget"
		BeforeTargets="BeforeCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(DisableGenerateAssemblyInfoClass)' != 'true'"
	>
		<PropertyGroup>
			<_AssemblyInfoOutputFile>$(IntermediateOutputPath)Properties/$(AutoGeneratedAssemblyInfoFile)</_AssemblyInfoOutputFile>
		</PropertyGroup>

		<WriteLinesToFile
			File="$(_AssemblyInfoOutputFile)"
			Lines="// &lt;auto-generated /&gt;

#if !PURVIEW_SDK_EXCLUDE_EMBEDDED

namespace Microsoft.CodeAnalysis
{
	[global::Microsoft.CodeAnalysis.Embedded]
	[global::System.Runtime.CompilerServices.CompilerGenerated]
	[global::System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage]
	[global::System.CodeDom.Compiler.GeneratedCode(&quot;Purview.BuildSdk&quot;, &quot;$(PackageVersion)&quot;)]
	sealed partial class EmbeddedAttribute : global::System.Attribute
	{
	}
}

#endif

namespace $(RootNamespace)
{
	[global::Microsoft.CodeAnalysis.Embedded]
	[global::System.Runtime.CompilerServices.CompilerGenerated]
	[global::System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage]
	[global::System.CodeDom.Compiler.GeneratedCode(&quot;Purview.BuildSdk&quot;, &quot;$(PackageVersion)&quot;)]
	static partial class AssemblyInfo
	{
		public const string RootNamespace = &quot;$([MSBuild]::Escape('$(RootNamespace)'))&quot;%3B
		public const string AssemblyName = &quot;$([MSBuild]::Escape('$(AssemblyName)'))&quot;%3B
		public const string AssemblyTitle = &quot;$([MSBuild]::Escape('$(AssemblyTitle)'))&quot;%3B
		public const string AssemblyProduct = &quot;$([MSBuild]::Escape('$(AssemblyProduct)'))&quot;%3B
		public const string Version = &quot;$([MSBuild]::Escape('$(Version)'))&quot;%3B
		public const string Company = &quot;$([MSBuild]::Escape('$(Company)'))&quot;%3B
		public const string Copyright = &quot;$([MSBuild]::Escape('$(Copyright)'))&quot;%3B
		public const int Year = $(CurrentYear)%3B

		public static string GetFriendlyName()
		{
			var possibleNames = new[]
			{
				AssemblyProduct,
				AssemblyTitle,
				AssemblyName
			}%3B

			foreach (var name in possibleNames)
			{
				if (!string.IsNullOrWhiteSpace(name))
				{
					return name%3B
				}
			}

			return &quot;$([MSBuild]::Escape('$(MSBuildProjectName)'))&quot;%3B
		}
	}
}
"
			Overwrite="true"
		/>
		<ItemGroup>
			<Compile Include="$(_AssemblyInfoOutputFile)" />
		</ItemGroup>
	</Target>

	<!-- =====================================================================
	     GENERATE ASSEMBLY IDENTIFIER CLASS
	     Writes an empty marker class to the intermediate output path so
	     architecture tests have a stable compile-time handle on the assembly
	     (typeof(MyProjectAssembly).Assembly) instead of matching it by string.

	     The class sits in the global namespace deliberately: a test project
	     referencing several assemblies should not need a using per marker. It
	     is only generated for production projects - a test assembly is the one
	     doing the asserting, so it has nothing to identify.
	     ===================================================================== -->
	<Target
		Name="GenerateAssemblyIdentifierClassTarget"
		BeforeTargets="BeforeCompile"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(DisableGenerateAssemblyIdentifierClass)' != 'true'"
		Label="Writes the assembly identifier marker class used by architecture tests."
	>
		<PropertyGroup>
			<!--
				Strip the namespace prefix from the project name, then every remaining
				non-identifier character, so Purview.ChangeOps.Core.Abstractions and
				Core.Abstractions both land on CoreAbstractionsAssembly.
			-->
			<_AssemblyIdentifierSourceName Condition="'$(_PurviewEscapedNamespacePrefix)' != ''"
				>$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '^$(_PurviewEscapedNamespacePrefix)($|\.)', ''))</_AssemblyIdentifierSourceName>
			<!-- No prefix configured, or the project name is exactly the prefix. -->
			<_AssemblyIdentifierSourceName Condition="'$(_AssemblyIdentifierSourceName)' == ''"
				>$(MSBuildProjectName)</_AssemblyIdentifierSourceName>
			<AssemblyIdentifierClassName Condition="'$(AssemblyIdentifierClassName)' == ''"
				>$([System.Text.RegularExpressions.Regex]::Replace('$(_AssemblyIdentifierSourceName)', '[^\w]', ''))Assembly</AssemblyIdentifierClassName>
			<_AssemblyIdentifierOutputFile>$(IntermediateOutputPath)Properties/$(AutoGeneratedAssemblyIdentifierFile)</_AssemblyIdentifierOutputFile>
		</PropertyGroup>

		<WriteLinesToFile
			File="$(_AssemblyIdentifierOutputFile)"
			Lines="// &lt;auto-generated /&gt;

/// &lt;summary&gt;
/// Identifies the &lt;c&gt;$([MSBuild]::Escape('$(AssemblyName)'))&lt;/c&gt; assembly to architecture tests.
/// &lt;/summary&gt;
[global::System.Runtime.CompilerServices.CompilerGenerated]
[global::System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage]
[global::System.CodeDom.Compiler.GeneratedCode(&quot;Purview.BuildSdk&quot;, &quot;$(PackageVersion)&quot;)]
public static partial class $(AssemblyIdentifierClassName)
{
}
"
			Overwrite="true"
		/>
		<ItemGroup>
			<Compile Include="$(_AssemblyIdentifierOutputFile)" />
		</ItemGroup>
	</Target>

	<!-- =====================================================================
	     ANALYZER CLOSURE VALIDATION (PRSGD0005)
	     Validates that every file in the analyzer closure returned by
	     GetSourceGeneratorAnalyzerFiles is self-contained: each PE AssemblyRef must resolve to
	     another file in the same closure or to a compiler-host-provided assembly. Runs for every
	     Roslyn component because the closure (and therefore the defect) is produced here, including
	     for a code-fix component that references another component without referencing the framework.
	     Implemented without an external metadata reference so it works on both MSBuild flavours.
	     ===================================================================== -->
	<UsingTask
		TaskName="ValidatePurviewAnalyzerClosure"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<PermittedReferences ParameterType="System.String" Required="false" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var permitted = new List<string>();
					if (!string.IsNullOrEmpty(PermittedReferences))
					{
						foreach (var value in PermittedReferences.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
						{
							var trimmed = value.Trim();
							if (trimmed.Length > 0 && !permitted.Contains(trimmed))
								permitted.Add(trimmed);
						}
					}

					var closureNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					foreach (var file in Files)
						closureNames.Add(Path.GetFileNameWithoutExtension(file.ItemSpec));

					foreach (var file in Files)
					{
						if (!File.Exists(file.ItemSpec))
						{
							Log.LogError(null, "PRSGD0005", null, file.ItemSpec, 0, 0, 0, 0,
								"The analyzer closure file '{0}' does not exist.", file.ItemSpec);
							continue;
						}

						foreach (var reference in ReadAssemblyReferenceNames(file.ItemSpec))
						{
							if (closureNames.Contains(reference))
								continue;

							var isPermitted = false;
							foreach (var prefix in permitted)
							{
								if (reference.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
								{
									isPermitted = true;
									break;
								}
							}
							if (isPermitted)
								continue;

							Log.LogError(null, "PRSGD0005", null, file.ItemSpec, 0, 0, 0, 0,
								"The self-contained analyzer '{0}' references '{1}', which is neither part of the returned analyzer closure ({2}) nor a host-provided assembly. Make the referenced Roslyn component an analyzer dependency so its analyzer artifact is returned, or declare the dependency as a SourceGeneratorRuntimeDependency so it is copied beside the analyzer.",
								Path.GetFileName(file.ItemSpec), reference, string.Join(", ", closureNames));
						}
					}

					List<string> ReadAssemblyReferenceNames(string path)
					{
						var names = new List<string>();
						var image = File.ReadAllBytes(path);
						if (image.Length < 0x40)
							return names;

						int peOffset = BitConverter.ToInt32(image, 0x3C);
						int coffOffset = peOffset + 4;
						int sectionCount = BitConverter.ToUInt16(image, coffOffset + 2);
						int optionalHeaderSize = BitConverter.ToUInt16(image, coffOffset + 16);
						int optionalOffset = coffOffset + 20;
						int magic = BitConverter.ToUInt16(image, optionalOffset);
						int directoriesOffset = optionalOffset + (magic == 0x20B ? 112 : 96);
						int cliRva = BitConverter.ToInt32(image, directoriesOffset + (14 * 8));
						int sectionsOffset = optionalOffset + optionalHeaderSize;

						int RvaToOffset(int rva)
						{
							for (int s = 0; s < sectionCount; s++)
							{
								int section = sectionsOffset + (s * 40);
								int virtualSize = (int)BitConverter.ToUInt32(image, section + 8);
								int virtualAddress = BitConverter.ToInt32(image, section + 12);
								int rawSize = BitConverter.ToInt32(image, section + 16);
								int rawPointer = BitConverter.ToInt32(image, section + 20);
								int size = Math.Max(virtualSize, rawSize);
								if (rva >= virtualAddress && rva < virtualAddress + size)
									return rawPointer + (rva - virtualAddress);
							}
							return -1;
						}

						int cliOffset = RvaToOffset(cliRva);
						if (cliOffset < 0)
							return names;

						int metadataOffset = RvaToOffset(BitConverter.ToInt32(image, cliOffset + 8));
						if (metadataOffset < 0 || BitConverter.ToUInt32(image, metadataOffset) != 0x424A5342)
							return names;

						int versionPadded = (BitConverter.ToInt32(image, metadataOffset + 12) + 3) & ~3;
						int streamCount = BitConverter.ToUInt16(image, metadataOffset + 16 + versionPadded + 2);
						int cursor = metadataOffset + 20 + versionPadded;
						int tablesStream = -1;
						int stringsStream = -1;
						for (int i = 0; i < streamCount; i++)
						{
							int relativeOffset = BitConverter.ToInt32(image, cursor);
							int nameStart = cursor + 8;
							int nameEnd = nameStart;
							while (image[nameEnd] != 0)
								nameEnd++;
							var streamName = Encoding.ASCII.GetString(image, nameStart, nameEnd - nameStart);
							if (streamName == "#~" || streamName == "#-")
								tablesStream = metadataOffset + relativeOffset;
							else if (streamName == "#Strings")
								stringsStream = metadataOffset + relativeOffset;
							cursor = nameStart + ((((nameEnd - nameStart) + 1) + 3) & ~3);
						}
						if (tablesStream < 0 || stringsStream < 0)
							return names;

						int heapSizes = image[tablesStream + 6];
						int stringIndexSize = (heapSizes & 0x01) != 0 ? 4 : 2;
						int guidIndexSize = (heapSizes & 0x02) != 0 ? 4 : 2;
						int blobIndexSize = (heapSizes & 0x04) != 0 ? 4 : 2;

						ulong valid = BitConverter.ToUInt64(image, tablesStream + 8);
						var rowCounts = new int[64];
						int rowsCursor = tablesStream + 24;
						for (int t = 0; t < 64; t++)
						{
							if ((valid & (1UL << t)) == 0)
								continue;
							rowCounts[t] = BitConverter.ToInt32(image, rowsCursor);
							rowsCursor += 4;
						}

						int Rid(int table) => rowCounts[table] >= 65536 ? 4 : 2;
						int Coded(int tagBits, int[] tables)
						{
							int max = 0;
							foreach (var t in tables)
							{
								if (rowCounts[t] > max)
									max = rowCounts[t];
							}
							return max >= (1 << (16 - tagBits)) ? 4 : 2;
						}

						int typeDefOrRef = Coded(2, new[] { 0x02, 0x01, 0x1B });
						int hasConstant = Coded(2, new[] { 0x04, 0x08, 0x17 });
						int hasCustomAttribute = Coded(5, new[] { 0x06, 0x04, 0x01, 0x02, 0x08, 0x09, 0x0A, 0x00, 0x0E, 0x17, 0x14, 0x11, 0x1A, 0x1B, 0x20, 0x23, 0x26, 0x27, 0x28, 0x2A, 0x2C, 0x2B });
						int hasFieldMarshal = Coded(1, new[] { 0x04, 0x08 });
						int hasDeclSecurity = Coded(2, new[] { 0x02, 0x06, 0x20 });
						int memberRefParent = Coded(3, new[] { 0x02, 0x01, 0x1A, 0x06, 0x1B });
						int hasSemantics = Coded(1, new[] { 0x14, 0x17 });
						int memberForwarded = Coded(1, new[] { 0x04, 0x06 });
						int customAttributeType = Coded(3, new[] { 0x06, 0x0A });
						int resolutionScope = Coded(2, new[] { 0x00, 0x1A, 0x23, 0x01 });

						int RowSize(int table)
						{
							switch (table)
							{
								case 0x00: return 2 + stringIndexSize + guidIndexSize + guidIndexSize + guidIndexSize;
								case 0x01: return resolutionScope + stringIndexSize + stringIndexSize;
								case 0x02: return 4 + stringIndexSize + stringIndexSize + typeDefOrRef + Rid(0x04) + Rid(0x06);
								case 0x03: return Rid(0x04);
								case 0x04: return 2 + stringIndexSize + blobIndexSize;
								case 0x05: return Rid(0x06);
								case 0x06: return 4 + 2 + 2 + stringIndexSize + blobIndexSize + Rid(0x08);
								case 0x07: return Rid(0x08);
								case 0x08: return 2 + 2 + stringIndexSize;
								case 0x09: return Rid(0x02) + typeDefOrRef;
								case 0x0A: return memberRefParent + stringIndexSize + blobIndexSize;
								case 0x0B: return 2 + hasConstant + blobIndexSize;
								case 0x0C: return hasCustomAttribute + customAttributeType + blobIndexSize;
								case 0x0D: return hasFieldMarshal + blobIndexSize;
								case 0x0E: return 2 + hasDeclSecurity + blobIndexSize;
								case 0x0F: return 2 + 4 + Rid(0x02);
								case 0x10: return 4 + Rid(0x04);
								case 0x11: return blobIndexSize;
								case 0x12: return Rid(0x02) + Rid(0x14);
								case 0x13: return Rid(0x14);
								case 0x14: return 2 + stringIndexSize + typeDefOrRef;
								case 0x15: return Rid(0x02) + Rid(0x17);
								case 0x16: return Rid(0x17);
								case 0x17: return 2 + stringIndexSize + blobIndexSize;
								case 0x18: return 2 + Rid(0x06) + hasSemantics;
								case 0x19: return Rid(0x02) + Rid(0x06) + Rid(0x06);
								case 0x1A: return stringIndexSize;
								case 0x1B: return blobIndexSize;
								case 0x1C: return 2 + memberForwarded + stringIndexSize + Rid(0x1A);
								case 0x1D: return 4 + Rid(0x04);
								case 0x1E: return 4 + 4;
								case 0x1F: return 4;
								case 0x20: return 4 + 2 + 2 + 2 + 2 + 4 + blobIndexSize + stringIndexSize + stringIndexSize;
								case 0x21: return 4;
								case 0x22: return 4 + 4 + 4;
								case 0x23: return 2 + 2 + 2 + 2 + 4 + blobIndexSize + stringIndexSize + stringIndexSize + blobIndexSize;
								default: return 0;
							}
						}

						int assemblyRefOffset = rowsCursor;
						for (int t = 0; t < 0x23; t++)
						{
							if ((valid & (1UL << t)) == 0)
								continue;
							assemblyRefOffset += RowSize(t) * rowCounts[t];
						}

						int assemblyRefRowSize = RowSize(0x23);
						int nameColumnOffset = 12 + blobIndexSize;
						for (int i = 0; i < rowCounts[0x23]; i++)
						{
							int nameColumn = assemblyRefOffset + (i * assemblyRefRowSize) + nameColumnOffset;
							int nameIndex = stringIndexSize == 4 ? BitConverter.ToInt32(image, nameColumn) : BitConverter.ToUInt16(image, nameColumn);
							int stringStart = stringsStream + nameIndex;
							int stringEnd = stringStart;
							while (image[stringEnd] != 0)
								stringEnd++;
							names.Add(Encoding.UTF8.GetString(image, stringStart, stringEnd - stringStart));
						}

						return names;
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="ValidateSourceGeneratorAnalyzerClosure"
		AfterTargets="GetSourceGeneratorAnalyzerFiles"
		Condition="'$(PurviewSourceGeneratorFrameworkAnalyzerValidation)' != 'false' AND '$(IsRoslynComponent)' == 'true' AND '@(_PurviewSourceGeneratorAnalyzerFile)' != ''"
		Label="Validates that every analyzer-closure file is self-contained (PRSGD0005)."
	>
		<ItemGroup>
			<_PurviewAnalyzerClosurePermitted Include="$(PurviewAnalyzerClosurePermittedReferences)" />
			<_PurviewAnalyzerClosurePermitted Include="@(PurviewAnalyzerClosurePermittedReference)" />
		</ItemGroup>
		<ValidatePurviewAnalyzerClosure
			Files="@(_PurviewSourceGeneratorAnalyzerFile)"
			PermittedReferences="@(_PurviewAnalyzerClosurePermitted->'%(Identity)', ';')"
		/>
	</Target>

	<!-- =====================================================================
	     PROJECT-REFERENCE BUILD-TRANSITIVE ASSETS
	     NuGet imports a package's buildTransitive assets for PackageReference consumers only. Every
	     project inside a package repository uses ProjectReference, so a packable project's own
	     CompilerVisibleProperty items are never registered while developing the package itself. This
	     registers those items for any ProjectReference consumer by reading the referenced project's
	     Sdk/buildTransitive/*.props|*.targets.
	     Opt out with <PurviewImportProjectReferenceBuildTransitive>false</PurviewImportProjectReferenceBuildTransitive>.
	     ===================================================================== -->
	<UsingTask
		TaskName="ReadBuildTransitiveCompilerVisibleProperties"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<ProjectDirectories ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<Existing ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<CompilerVisibleProperties ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var includePattern = new Regex("Include\\s*=\\s*[\"'](?<name>[^\"']+)[\"']", RegexOptions.IgnoreCase);
					var elementPattern = new Regex("<CompilerVisibleProperty(?<attrs>[^>]*)>(?<inner>.*?)</CompilerVisibleProperty>", RegexOptions.Singleline | RegexOptions.IgnoreCase);
					var selfClosingPattern = new Regex("<CompilerVisibleProperty(?<attrs>[^>]*)/>", RegexOptions.Singleline | RegexOptions.IgnoreCase);
					var descriptionPattern = new Regex("<Description>(?<desc>.*?)</Description>", RegexOptions.Singleline | RegexOptions.IgnoreCase);

					var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					if (Existing != null)
					{
						foreach (var item in Existing)
							seen.Add(item.ItemSpec);
					}

					var candidateFiles = new List<string>();
					if (ProjectDirectories != null)
					{
						foreach (var directory in ProjectDirectories)
						{
							var buildTransitive = Path.Combine(directory.ItemSpec, "Sdk", "buildTransitive");
							if (!Directory.Exists(buildTransitive))
								continue;

							candidateFiles.AddRange(Directory.GetFiles(buildTransitive, "*.props", SearchOption.AllDirectories));
							candidateFiles.AddRange(Directory.GetFiles(buildTransitive, "*.targets", SearchOption.AllDirectories));
						}
					}

					var results = new List<ITaskItem>();
					foreach (var file in candidateFiles)
					{
							string text;
							try
							{
								text = File.ReadAllText(file);
							}
							catch (Exception)
							{
								continue;
							}

							foreach (Match match in elementPattern.Matches(text))
							{
								var includeMatch = includePattern.Match(match.Groups["attrs"].Value);
								if (!includeMatch.Success)
									continue;

								var name = includeMatch.Groups["name"].Value.Trim();
								if (name.Length == 0 || !seen.Add(name))
									continue;

								var item = new TaskItem(name);
								var descriptionMatch = descriptionPattern.Match(match.Groups["inner"].Value);
								if (descriptionMatch.Success)
								{
									var description = descriptionMatch.Groups["desc"].Value.Trim();
									if (description.Length > 0)
										item.SetMetadata("Description", description);
								}
								results.Add(item);
							}

							foreach (Match match in selfClosingPattern.Matches(text))
							{
								var includeMatch = includePattern.Match(match.Groups["attrs"].Value);
								if (!includeMatch.Success)
									continue;

								var name = includeMatch.Groups["name"].Value.Trim();
								if (name.Length == 0 || !seen.Add(name))
									continue;

								results.Add(new TaskItem(name));
							}
					}

					CompilerVisibleProperties = results.ToArray();
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="ImportProjectReferencedBuildTransitiveAssets"
		BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile"
		Condition="'$(PurviewImportProjectReferenceBuildTransitive)' != 'false'"
		Label="Registers CompilerVisibleProperty items from referenced projects' buildTransitive assets."
	>
		<ItemGroup>
			<!--
				The task enumerates Sdk/buildTransitive from each directory itself: MSBuild expands
				wildcards in literal includes but not in metadata transforms, so a
				"%(Directory)Sdk/buildTransitive/*.props" transform would stay a literal string.
			-->
			<_PurviewBuildTransitiveProjectReference Include="@(ProjectReference)" />
			<_PurviewBuildTransitiveProjectDirectory Include="@(_PurviewBuildTransitiveProjectReference->'%(RootDir)%(Directory)')" />
		</ItemGroup>
		<ReadBuildTransitiveCompilerVisibleProperties
			ProjectDirectories="@(_PurviewBuildTransitiveProjectDirectory)"
			Existing="@(CompilerVisibleProperty)"
			Condition="'@(_PurviewBuildTransitiveProjectDirectory)' != ''"
		>
			<Output TaskParameter="CompilerVisibleProperties" ItemName="_PurviewImportedCompilerVisibleProperty" />
		</ReadBuildTransitiveCompilerVisibleProperties>
		<ItemGroup Condition="'@(_PurviewImportedCompilerVisibleProperty)' != ''">
			<CompilerVisibleProperty Include="@(_PurviewImportedCompilerVisibleProperty)" />
		</ItemGroup>
	</Target>
</Project>
