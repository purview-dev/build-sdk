<Project>
	<PropertyGroup Label="Default SDK Properties">
		<_SharedProjectNames Condition="'$(_SharedProjectNames)' == ''"
			>;Shared;SharedFramework;SharedInfrastructure;SharedInfra;SharedUtilities;SharedUtils;SharedLibrary;SharedLib;SharedHelpers;</_SharedProjectNames>
		<_SharedTestingProjectNames Condition="'$(_SharedTestingProjectNames)' == ''"
			>;SharedTestingFramework;SharedTestingInfrastructure;SharedTestingInfra;SharedTestingUtilities;SharedTestingUtils;SharedTestingLibrary;SharedTestingLib;SharedTestingHelpers;</_SharedTestingProjectNames>

		<AccelerateBuildsInVisualStudio Condition="'$(AccelerateBuildsInVisualStudio)' == ''"
			>true</AccelerateBuildsInVisualStudio>
		<AllowedOutputExtensionsInPackageBuildOutputFolder
			Condition="'$(AllowedOutputExtensionsInPackageBuildOutputFolder)' == ''"
		></AllowedOutputExtensionsInPackageBuildOutputFolder>
		<AnalysisLevel Condition="'$(AnalysisLevel)' == ''">latest</AnalysisLevel>
		<AnalysisMode Condition="'$(AnalysisMode)' == ''">All</AnalysisMode>
		<AutoGeneratedAssemblyIdentifierFile
			Condition="'$(AutoGeneratedAssemblyIdentifierFile)' == ''"
		></AutoGeneratedAssemblyIdentifierFile>
		<AutoGeneratedAssemblyInfoFile
			Condition="'$(AutoGeneratedAssemblyInfoFile)' == ''"
		></AutoGeneratedAssemblyInfoFile>
		<AutoIncludeUsings Condition="'$(AutoIncludeUsings)' == ''">true</AutoIncludeUsings>
		<BootstrapEditorConfigToRepoRoot Condition="'$(BootstrapEditorConfigToRepoRoot)' == ''"
			>true</BootstrapEditorConfigToRepoRoot>
		<BootstrapGlobalJsonToRepoRoot Condition="'$(BootstrapGlobalJsonToRepoRoot)' == ''"
			>true</BootstrapGlobalJsonToRepoRoot>
		<CollectCoverage Condition="'$(CollectCoverage)' == ''">false</CollectCoverage>
		<ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
		<CurrentYear Condition="'$(CurrentYear)' == ''"></CurrentYear>
		<Deterministic Condition="'$(Deterministic)' == ''">true</Deterministic>
		<DisableProjectFileNamingConventionCheck Condition="'$(DisableProjectFileNamingConventionCheck)' == ''"
			>false</DisableProjectFileNamingConventionCheck>
		<DisableAutoCopySdkFiles Condition="'$(DisableAutoCopySdkFiles)' == ''">false</DisableAutoCopySdkFiles>
		<DisableAutoInternalsVisibleTo Condition="'$(DisableAutoInternalsVisibleTo)' == ''"
			>false</DisableAutoInternalsVisibleTo>
		<DisableGenerateAssemblyIdentifierClass Condition="'$(DisableGenerateAssemblyIdentifierClass)' == ''"
			>false</DisableGenerateAssemblyIdentifierClass>
		<DisableGenerateAssemblyInfoClass Condition="'$(DisableGenerateAssemblyInfoClass)' == ''"
			>false</DisableGenerateAssemblyInfoClass>
		<DisableNamespacePrefixCheck Condition="'$(DisableNamespacePrefixCheck)' == ''"
			>false</DisableNamespacePrefixCheck>
		<DisablePurviewStylePolicyValidation Condition="'$(DisablePurviewStylePolicyValidation)' == ''"
			>false</DisablePurviewStylePolicyValidation>
		<DisablePurviewTestContextRuleSet Condition="'$(DisablePurviewTestContextRuleSet)' == ''"
			>false</DisablePurviewTestContextRuleSet>
		<DisableRoslynCompilerDefaultsValidation Condition="'$(DisableRoslynCompilerDefaultsValidation)' == ''"
			>false</DisableRoslynCompilerDefaultsValidation>
		<DisableSourceLink Condition="'$(DisableSourceLink)' == ''">false</DisableSourceLink>
		<DisableUnconditionalProjectDeclarationCheck Condition="'$(DisableUnconditionalProjectDeclarationCheck)' == ''"
			>false</DisableUnconditionalProjectDeclarationCheck>
		<DockerDefaultTargetOS Condition="'$(DockerDefaultTargetOS)' == ''"></DockerDefaultTargetOS>
		<DockerfileContext Condition="'$(DockerfileContext)' == ''"></DockerfileContext>
		<EditorConfigFilePath Condition="'$(EditorConfigFilePath)' == ''"></EditorConfigFilePath>
		<EmbedUntrackedSources Condition="'$(EmbedUntrackedSources)' == ''">true</EmbedUntrackedSources>
		<EnableDynamicNativeInstrumentation Condition="'$(EnableDynamicNativeInstrumentation)' == ''"
			>false</EnableDynamicNativeInstrumentation>
		<EnableMicrosoftTestingPlatform Condition="'$(EnableMicrosoftTestingPlatform)' == ''"
			>false</EnableMicrosoftTestingPlatform>
		<EnableNETAnalyzers Condition="'$(EnableNETAnalyzers)' == ''">true</EnableNETAnalyzers>
		<EnableStaticNativeInstrumentation Condition="'$(EnableStaticNativeInstrumentation)' == ''"
			>false</EnableStaticNativeInstrumentation>
		<EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
		<EnableAssemblyNameGeneration Condition="'$(EnableAssemblyNameGeneration)' == ''"
			>true</EnableAssemblyNameGeneration>
		<!-- Recommendations are the one skill feature that runs during an ordinary build. They stay
		     offline (they read the restore graph and the skills CLI's own lockfile), they never
		     install anything, and they never fail a build. -->
		<EnablePurviewSkillRecommendations Condition="'$(EnablePurviewSkillRecommendations)' == ''"
			>true</EnablePurviewSkillRecommendations>
		<!-- CI installs nothing and has nobody to act on the advice, so the nudge is noise there.
		     Set true to opt a pipeline back in - a build that verifies skill state deliberately. -->
		<PurviewSkillRecommendationsInCI Condition="'$(PurviewSkillRecommendationsInCI)' == ''"
			>false</PurviewSkillRecommendationsInCI>
		<!-- Repository-level stamp holding a fingerprint of the last reported state, so a solution
		     of thirty projects reports once rather than thirty times, and an unchanged state does
		     not repeat the same advice on every build. Empty resolves to
		     '<repo root>/.purview/skill-recommendations.cache' at target time. -->
		<PurviewSkillRecommendationStampPath
			Condition="'$(PurviewSkillRecommendationStampPath)' == ''"
		></PurviewSkillRecommendationStampPath>
		<!-- Overrides where skills-lock.json is read from. Empty resolves to the repository root,
		     which is where the CLI writes it for a project-scope install. -->
		<PurviewSkillsLockFile Condition="'$(PurviewSkillsLockFile)' == ''"></PurviewSkillsLockFile>
		<!-- The skills CLI is published to npm, and a repository standardises on one package runner.
		     npx is the default because it ships with Node itself, so it is the one runner a machine
		     that has Node at all is guaranteed to have. -->
		<PurviewSkillsRunner Condition="'$(PurviewSkillsRunner)' == ''">npx</PurviewSkillsRunner>
		<!-- Probed in order after PurviewSkillsRunner, so a machine without the preferred runner
		     still installs rather than reporting that nothing was found. A 'skills' already on PATH
		     is always tried first: it needs no download and works offline. -->
		<PurviewSkillsRunnerCandidates Condition="'$(PurviewSkillsRunnerCandidates)' == ''"
			>npx;bunx;bun;pnpm;yarn;deno</PurviewSkillsRunnerCandidates>
		<!-- Pinned to a major so a future breaking release of the CLI cannot change what the install
		     target does. Recommendation text deliberately omits the pin: it is a command for a human
		     to run, not a reproducible invocation. -->
		<PurviewSkillsPackage Condition="'$(PurviewSkillsPackage)' == ''">skills@1</PurviewSkillsPackage>
		<!-- Markers that identify a repository root, most authoritative first. Each is searched all
		     the way up from the project before the next is tried, so '.git/' wins over a nearer
		     'package.json' - a monorepo package is not the repository. A trailing slash marks a
		     directory (and still matches a file of that name, because '.git' is a file in a worktree
		     or submodule); anything else must be a file. -->
		<!-- Skills have exactly one installer: the skills CLI. There is deliberately no property
		     here that re-enables mirroring them - see the exclusion in Sdk.targets. -->
		<PurviewRepositoryRootMarkers Condition="'$(PurviewRepositoryRootMarkers)' == ''"
			>.git/;.github/;.gitattributes;LICENSE.md;AGENTS.md;.agents/;CLAUDE.md;.claude/;package.json</PurviewRepositoryRootMarkers>
		<PurviewRepoBootstrapCopyFailureAsError Condition="'$(PurviewRepoBootstrapCopyFailureAsError)' == ''"
			>true</PurviewRepoBootstrapCopyFailureAsError>
		<PurviewRepoBootstrapCopyRetries Condition="'$(PurviewRepoBootstrapCopyRetries)' == ''"
			>3</PurviewRepoBootstrapCopyRetries>
		<PurviewRepoBootstrapCopyRetryDelayMilliseconds
			Condition="'$(PurviewRepoBootstrapCopyRetryDelayMilliseconds)' == ''"
			>500</PurviewRepoBootstrapCopyRetryDelayMilliseconds>
		<PurviewRepoBootstrapMode Condition="'$(PurviewRepoBootstrapMode)' == ''">IfMissing</PurviewRepoBootstrapMode>
		<PurviewSuppressCopyRetryWarnings Condition="'$(PurviewSuppressCopyRetryWarnings)' == ''"
			>true</PurviewSuppressCopyRetryWarnings>
		<Exclude Condition="'$(Exclude)' == ''"></Exclude>
		<ExcludeByAttribute Condition="'$(ExcludeByAttribute)' == ''"></ExcludeByAttribute>
		<ExcludeMSTelemetryExtension Condition="'$(ExcludeMSTelemetryExtension)' == ''"
			>false</ExcludeMSTelemetryExtension>
		<ExcludePurviewTelemetry Condition="'$(ExcludePurviewTelemetry)' == ''">false</ExcludePurviewTelemetry>
		<GenerateAssemblyCompanyAttribute Condition="'$(GenerateAssemblyCompanyAttribute)' == ''"
			>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyCopyrightAttribute Condition="'$(GenerateAssemblyCopyrightAttribute)' == ''"
			>false</GenerateAssemblyCopyrightAttribute>
		<GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
		<ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
		<IncludeSource Condition="'$(IncludeSource)' == ''">false</IncludeSource>
		<IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
		<InterceptorsNamespaces Condition="'$(InterceptorsNamespaces)' == ''"></InterceptorsNamespaces>
		<InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">false</InvariantGlobalization>
		<IsAspireHostProject Condition="'$(IsAspireHostProject)' == ''">false</IsAspireHostProject>
		<IsCLIProject Condition="'$(IsCLIProject)' == ''">false</IsCLIProject>
		<IsContainerProject Condition="'$(IsContainerProject)' == ''">false</IsContainerProject>
		<IsCSharpProject Condition="'$(IsCSharpProject)' == ''">false</IsCSharpProject>
		<IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
		<IsPublishable Condition="'$(IsPublishable)' == ''">false</IsPublishable>
		<IsSdkProject Condition="'$(IsSdkProject)' == ''">false</IsSdkProject>
		<IsSharedProject Condition="'$(IsSharedProject)' == ''">false</IsSharedProject>
		<IsSharedTestingProject Condition="'$(IsSharedTestingProject)' == ''">false</IsSharedTestingProject>
		<IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
		<IsWebProject Condition="'$(IsWebProject)' == ''">false</IsWebProject>
		<IsWebSdkProject Condition="'$(IsWebSdkProject)' == ''">false</IsWebSdkProject>
		<IsWorkerSdkProject Condition="'$(IsWorkerSdkProject)' == ''">false</IsWorkerSdkProject>
		<LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
		<ManagePackageVersionsCentrally Condition="'$(ManagePackageVersionsCentrally)' == ''"
			>true</ManagePackageVersionsCentrally>
		<MaxCpuCount Condition="'$(MaxCpuCount)' == ''"></MaxCpuCount>
		<NoWarn Condition="'$(NoWarn)' == ''"></NoWarn>
		<Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
		<OutputType Condition="'$(OutputType)' == ''"></OutputType>
		<Packable Condition="'$(Packable)' == ''">false</Packable>
		<PackageTags Condition="'$(PackageTags)' == ''"></PackageTags>
		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<TargetsForTfmSpecificContentInPackage
			Condition="'$(TargetsForTfmSpecificContentInPackage)' == ''"
		></TargetsForTfmSpecificContentInPackage>
		<TestingFramework Condition="'$(TestingFramework)' == ''">TUnit</TestingFramework>
		<SubstituteFramework Condition="'$(SubstituteFramework)' == ''">TUnitMocks</SubstituteFramework>
		<TestDataFramework Condition="'$(TestDataFramework)' == ''">Bogus</TestDataFramework>
		<PurviewLogicalProjectName Condition="'$(PurviewLogicalProjectName)' == ''"></PurviewLogicalProjectName>
		<PurviewNamespacePrefix Condition="'$(PurviewNamespacePrefix)' == ''"></PurviewNamespacePrefix>
		<PurviewProjectShortName Condition="'$(PurviewProjectShortName)' == ''"></PurviewProjectShortName>
		<PurviewTestType Condition="'$(PurviewTestType)' == ''"></PurviewTestType>
		<PurviewTestContextNoWarn Condition="'$(PurviewTestContextNoWarn)' == ''"
			>;CA1002;CA1012;CA1034;CA1047;CA1050;CA1051;CA1062;CA1064;CA1515;CA1707;</PurviewTestContextNoWarn>
		<PurviewPolicyExemptNoWarn Condition="'$(PurviewPolicyExemptNoWarn)' == ''"></PurviewPolicyExemptNoWarn>
		<PurviewSharedTestingOutputType Condition="'$(PurviewSharedTestingOutputType)' == ''"
			>Library</PurviewSharedTestingOutputType>
		<PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
		<PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">true</PublishRepositoryUrl>
		<PurviewBuildSdkVersionForGlobalJson Condition="'$(PurviewBuildSdkVersionForGlobalJson)' == ''"
			>1.0.0</PurviewBuildSdkVersionForGlobalJson>
		<RepositoryEditorConfigFilePath
			Condition="'$(RepositoryEditorConfigFilePath)' == ''"
		></RepositoryEditorConfigFilePath>
		<RepositoryGlobalJsonFilePath
			Condition="'$(RepositoryGlobalJsonFilePath)' == ''"
		></RepositoryGlobalJsonFilePath>
		<RootNamespace Condition="'$(RootNamespace)' == ''"></RootNamespace>
		<SdkProjectName Condition="'$(SdkProjectName)' == ''"></SdkProjectName>
		<SourceLinkPackageName Condition="'$(SourceLinkPackageName)' == ''"
			>Microsoft.SourceLink.GitHub</SourceLinkPackageName>
		<SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == ''">snupkg</SymbolPackageFormat>
		<TargetFramework Condition="'$(TargetFramework)' == ''"></TargetFramework>
		<!-- Curated TFM set: Latest, Current, Supported or Broad. Left empty here so Sdk.props can tell
		     "not chosen" from a real choice; it defaults to 'Current' (the single-TFM default) for every
		     non-Roslyn C# project. A Roslyn component keeps netstandard2.0 and is not covered. -->
		<PurviewTargetFrameworkSet Condition="'$(PurviewTargetFrameworkSet)' == ''"></PurviewTargetFrameworkSet>
		<TargetProjectName Condition="'$(TargetProjectName)' == ''"></TargetProjectName>
		<TestingPlatformDotnetTestSupport Condition="'$(TestingPlatformDotnetTestSupport)' == ''"
			>false</TestingPlatformDotnetTestSupport>
		<TestingType Condition="'$(TestingType)' == ''"></TestingType>
		<UseMicrosoftTestingPlatformRunner Condition="'$(UseMicrosoftTestingPlatformRunner)' == ''"
			>false</UseMicrosoftTestingPlatformRunner>
		<Version Condition="'$(Version)' == ''">0.0.1</Version>

		<_PurviewSdkContainerDirectory
			Condition="'$(_PurviewSdkContainerDirectory)' == ''"
		></_PurviewSdkContainerDirectory>
		<_PurviewSdkContainerDirectoryName
			Condition="'$(_PurviewSdkContainerDirectoryName)' == ''"
		></_PurviewSdkContainerDirectoryName>
		<_PackageJsonVersion Condition="'$(_PackageJsonVersion)' == ''"></_PackageJsonVersion>
		<_RootPackageJsonText Condition="'$(_RootPackageJsonText)' == ''"></_RootPackageJsonText>
		<_RootPackageJsonWasSpecified Condition="'$(_RootPackageJsonWasSpecified)' == ''"
			>false</_RootPackageJsonWasSpecified>
		<_UsePackageJsonVersionEnabled Condition="'$(_UsePackageJsonVersionEnabled)' == ''"
			>false</_UsePackageJsonVersionEnabled>
		<_UsePackageJsonVersionNormalized
			Condition="'$(_UsePackageJsonVersionNormalized)' == ''"
		></_UsePackageJsonVersionNormalized>
		<RepoRoot Condition="'$(RepoRoot)' == ''"></RepoRoot>
		<RootPackageJson Condition="'$(RootPackageJson)' == ''"></RootPackageJson>
		<UsePackageJsonVersion Condition="'$(UsePackageJsonVersion)' == ''">true</UsePackageJsonVersion>
		<EnableVersionDetectionCache Condition="'$(EnableVersionDetectionCache)' == ''"
			>true</EnableVersionDetectionCache>
		<VersionDetectionLogEnabled Condition="'$(VersionDetectionLogEnabled)' == ''">false</VersionDetectionLogEnabled>
		<VersionDetectionCacheFile Condition="'$(VersionDetectionCacheFile)' == ''"></VersionDetectionCacheFile>
		<_VersionDetectionCacheDirectory
			Condition="'$(_VersionDetectionCacheDirectory)' == ''"
		></_VersionDetectionCacheDirectory>
		<_VersionDetectionCacheText Condition="'$(_VersionDetectionCacheText)' == ''"></_VersionDetectionCacheText>
		<_CachedRepoRoot Condition="'$(_CachedRepoRoot)' == ''"></_CachedRepoRoot>
		<_CachedRootPackageJson Condition="'$(_CachedRootPackageJson)' == ''"></_CachedRootPackageJson>
		<_CachedPackageJsonVersion Condition="'$(_CachedPackageJsonVersion)' == ''"></_CachedPackageJsonVersion>
		<_CachedPackageJsonTicks Condition="'$(_CachedPackageJsonTicks)' == ''"></_CachedPackageJsonTicks>
		<_CurrentPackageJsonTicks Condition="'$(_CurrentPackageJsonTicks)' == ''"></_CurrentPackageJsonTicks>
		<_VersionDetectionCacheKey Condition="'$(_VersionDetectionCacheKey)' == ''"></_VersionDetectionCacheKey>
		<_VersionDetectionCacheRoot Condition="'$(_VersionDetectionCacheRoot)' == ''"></_VersionDetectionCacheRoot>
	</PropertyGroup>
</Project>
