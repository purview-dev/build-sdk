<Project>
	<Import Project="$(MSBuildThisFileDirectory)Props/Defaults.props" />
	<Import Project="$(MSBuildThisFileDirectory)Props/VersionDetection.props " />

	<!-- =====================================================================
	     SHARED PROJECT NAMES
	     Single source of truth for shared project names.
	     Defined as a property (semicolon-fenced) so IsSharedProject and IsSharedTestingProject
	     detection can use $(...Contains(...)) directly in a static Condition.
	     ===================================================================== -->
	<PropertyGroup Label="Defining Shared Project Names">
		<_SharedProjectNames>;Shared;SharedFramework;SharedInfrastructure;SharedInfra;SharedUtilities;SharedUtils;SharedLibrary;SharedLib;SharedHelpers;</_SharedProjectNames>
		<_SharedTestingProjectNames>;SharedTestingFramework;SharedTestingInfrastructure;SharedTestingInfra;SharedTestingUtilities;SharedTestingUtils;SharedTestingLibrary;SharedTestingLib;SharedTestingHelpers;</_SharedTestingProjectNames>
	</PropertyGroup>

	<ItemGroup Label="Defining Shared Project Names">
		<SharedProjectName Include="$(_SharedProjectNames)" />
		<SharedTestingProjectName Include="$(_SharedTestingProjectNames)" />
	</ItemGroup>

	<!-- =====================================================================
	     NAMESPACE SUFFIXES STRIPPED FROM RootNamespace
	     ===================================================================== -->
	<ItemGroup Label="Defining Namespace Suffixes to Remove from RootNamespace">
		<NamespaceRemoveSuffix Include="@(SharedProjectName)" />
		<NamespaceRemoveSuffix Include="@(SharedTestingProjectName)" />
		<NamespaceRemoveSuffix Include="Core" />
		<NamespaceRemoveSuffix Include="EF" />
		<NamespaceRemoveSuffix Include="Shared" />
		<NamespaceRemoveSuffix Include="ClientShared" />
		<NamespaceRemoveSuffix Include="ServiceDefaults" />
	</ItemGroup>

	<!-- =====================================================================
	     TESTING TYPES
	     Controls InternalsVisibleTo generation and TestingType detection.
	     ===================================================================== -->
	<ItemGroup Label="Defining Testing Types">
		<TestType Include="Accessibility" />
		<TestType Include="Acceptance" />
		<TestType Include="Architecture" />
		<TestType Include="BlackBox" />
		<TestType Include="Chaos" />
		<TestType Include="Contract" />
		<TestType Include="E2E" />
		<TestType Include="EndToEnd" />
		<TestType Include="Environment" />
		<TestType Include="Functional" />
		<TestType Include="Interactive" />
		<TestType Include="Integration" />
		<TestType Include="Load" />
		<TestType Include="Performance" />
		<TestType Include="Regression" />
		<TestType Include="Security" />
		<TestType Include="Scenario" />
		<TestType Include="Smoke" />
		<TestType Include="Stress" />
		<TestType Include="System" />
		<TestType Include="Threat" />
		<TestType Include="Unit" />
		<TestType Include="WhiteBox" />
	</ItemGroup>

	<!-- =====================================================================
	     PROJECT TYPE DETECTION
	     Runs for all .csproj files to classify project types and detect the
	     testing type from the project name suffix.
	     ===================================================================== -->
	<PropertyGroup Label="Define C# Properties" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<!-- Set some defaults -->
		<IsCSharpProject>true</IsCSharpProject>
		<ExcludePurviewTelemetry Condition="'$(ExcludePurviewTelemetry)' == ''">false</ExcludePurviewTelemetry>
		<ExcludeMSTelemetryExtension Condition="'$(ExcludeMSTelemetryExtension)' == ''"
			>false</ExcludeMSTelemetryExtension>
		<DisableGenerateAssemblyInfoClass Condition="'$(DisableGenerateAssemblyInfoClass)' == ''"
			>false</DisableGenerateAssemblyInfoClass>
		<EnableAssemblyNameGeneration Condition="'$(EnableAssemblyNameGeneration)' == ''"
			>true</EnableAssemblyNameGeneration>
		<DisableAutoInternalsVisibleTo Condition="'$(DisableAutoInternalsVisibleTo)' == ''"
			>false</DisableAutoInternalsVisibleTo>
		<AutoIncludeUsings Condition="'$(AutoIncludeUsings)' == ''">true</AutoIncludeUsings>
		<!-- Test project types -->
		<IsTestProject>false</IsTestProject>
		<IsSharedTestingProject>false</IsSharedTestingProject>
		<!-- Project types -->
		<IsSharedProject>false</IsSharedProject>
		<IsContainerProject>false</IsContainerProject>
		<IsSdkProject>false</IsSdkProject>
		<IsWebProject>false</IsWebProject>
		<IsWebSdkProject>false</IsWebSdkProject>
		<IsWorkerSdkProject>false</IsWorkerSdkProject>
		<IsAspireHostProject>false</IsAspireHostProject>
		<IsCLIProject>false</IsCLIProject>
		<IsRoslynComponent
			Condition="'$(IsRoslynComponent)' == '' AND $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText(`$(MSBuildProjectFullPath)`)), `(?is)&lt;IsRoslynComponent\s*&gt;\s*true\s*&lt;/IsRoslynComponent\s*&gt;`))"
			>true</IsRoslynComponent>
		<IsRoslynComponent Condition="'$(IsRoslynComponent)' == ''">false</IsRoslynComponent>
		<IsPackable
			Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText(`$(MSBuildProjectFullPath)`)), `(?is)&lt;IsPackable\s*&gt;\s*true\s*&lt;/IsPackable\s*&gt;`))"
			>true</IsPackable>
		<_PurviewProjectDeclaresTargetFramework
			Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText(`$(MSBuildProjectFullPath)`)), `(?is)&lt;TargetFrameworks?\s*&gt;`))"
			>true</_PurviewProjectDeclaresTargetFramework>
		<!-- SDK project type detection by parsing the Sdk attribute -->
		<SdkProjectName>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText(`$(MSBuildProjectFullPath)`)), `(?s-i)(?:^|\s|&gt;)(?s-i)(?:^|\s|&gt;)&lt;\s*(?:Project|Import)\s(?:[^&gt;]*?)\s?Sdk\s*="(?&lt;sdkproj&gt;.*?)"`).Groups['sdkproj'].Value)</SdkProjectName>
		<IsSdkProject Condition="'$(SdkProjectName)' != ''">true</IsSdkProject>
		<IsWebSdkProject Condition="'$(SdkProjectName)' == 'Microsoft.NET.Sdk.Web'">true</IsWebSdkProject>
		<IsWorkerSdkProject Condition="'$(SdkProjectName)' == 'Microsoft.NET.Sdk.Worker'">true</IsWorkerSdkProject>
		<IsContainerProject
			Condition="Exists('$(MSBuildProjectDirectory)\Dockerfile') OR Exists('$(MSBuildProjectDirectory)\dockerfile') OR Exists('$(MSBuildProjectDirectory)\Dockerfile.dev')"
			>true</IsContainerProject>
		<IsAspireHostProject
			Label="Detect Aspire.Sdk.Host SDK projects - only works when the SDK attribute is on the Project element"
			Condition="$([System.String]::Copy('$(SdkProjectName)').StartsWith('Aspire.Sdk.Host')) == 'True' OR $([System.String]::Copy('$(SdkProjectName)').StartsWith('Aspire.AppHost.Sdk')) == 'True'"
			>true</IsAspireHostProject>
		<IsCLIProject
			Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('CLI')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Console')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('CommandLine')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('QuickStart')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('QuickStarts')) == 'True'"
			>true</IsCLIProject>
		<IsSharedProject
			Condition="$([System.String]::Copy('$(_SharedProjectNames)').Contains(';$(MSBuildProjectName);')) == 'True'"
			>true</IsSharedProject>
		<PurviewNamespacePrefix Condition="'$(PurviewNamespacePrefix)' == ''"
			>$(NamespacePrefix)</PurviewNamespacePrefix>
		<NamespacePrefix Condition="'$(NamespacePrefix)' == ''">$(PurviewNamespacePrefix)</NamespacePrefix>
		<PurviewProjectShortName>$(MSBuildProjectName)</PurviewProjectShortName>
		<_PurviewEscapedNamespacePrefix Condition="'$(PurviewNamespacePrefix)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Escape('$(PurviewNamespacePrefix)'))</_PurviewEscapedNamespacePrefix>
		<_PurviewNamespacePrefixTailSegment Condition="'$(PurviewNamespacePrefix)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Match('$(PurviewNamespacePrefix)', '([^\.]+)$').Groups[1].Value)</_PurviewNamespacePrefixTailSegment>
		<_PurviewEscapedNamespacePrefixTailSegment Condition="'$(_PurviewNamespacePrefixTailSegment)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Escape('$(_PurviewNamespacePrefixTailSegment)'))</_PurviewEscapedNamespacePrefixTailSegment>
		<_PurviewProjectNameWithoutRepeatedTail
			Condition="'$(PurviewNamespacePrefix)' != '' AND '$(_PurviewEscapedNamespacePrefixTailSegment)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '^$(_PurviewEscapedNamespacePrefixTailSegment)(?=\.|$)\.?', ''))</_PurviewProjectNameWithoutRepeatedTail>
		<_PurviewIsSegmentPrefixedProjectName
			Condition="'$(PurviewNamespacePrefix)' != '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^$(_PurviewEscapedNamespacePrefix)($|\.)'))"
			>true</_PurviewIsSegmentPrefixedProjectName>
		<PurviewLogicalProjectName Condition="'$(PurviewNamespacePrefix)' == ''"
			>$(MSBuildProjectName)</PurviewLogicalProjectName>
		<PurviewLogicalProjectName
			Condition="'$(PurviewNamespacePrefix)' != '' AND '$(_PurviewIsSegmentPrefixedProjectName)' == 'true'"
			>$(MSBuildProjectName)</PurviewLogicalProjectName>
		<PurviewLogicalProjectName
			Condition="'$(PurviewNamespacePrefix)' != '' AND '$(_PurviewIsSegmentPrefixedProjectName)' != 'true' AND '$(_PurviewProjectNameWithoutRepeatedTail)' == ''"
			>$(PurviewNamespacePrefix)</PurviewLogicalProjectName>
		<PurviewLogicalProjectName
			Condition="'$(PurviewNamespacePrefix)' != '' AND '$(_PurviewIsSegmentPrefixedProjectName)' != 'true' AND '$(_PurviewProjectNameWithoutRepeatedTail)' != ''"
			>$(PurviewNamespacePrefix).$(_PurviewProjectNameWithoutRepeatedTail)</PurviewLogicalProjectName>
		<!-- Determine the testing type from the project name suffix -->
		<TestingType
			Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Test')) == 'True' OR $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests')) == 'True'"
			>$([System.Text.RegularExpressions.Regex]::Match($(MSBuildProjectName), `^.*\.([\w|_]\w*)Tests?$`).get_Groups().get_Item(1).ToString())</TestingType>
		<PurviewTestType Condition="'$(TestingType)' != ''">$(TestingType)Tests</PurviewTestType>
		<IsTestProject Condition="'$(TestingType)' != ''">true</IsTestProject>
		<IsSharedTestingProject
			Condition="$([System.String]::Copy('$(_SharedTestingProjectNames)').Contains(';$(MSBuildProjectName);')) == 'True'"
			>true</IsSharedTestingProject>
	</PropertyGroup>

	<!-- =====================================================================
	     TESTING FRAMEWORKS
	     Defaults:
	     - TestingFramework: TUnit (supported: TUnit, Xunit, None)
	     - SubstituteFramework: TUnitMocks (supported: TUnitMocks, NSubstitute, None)
	     - TestDataFramework: Bogus (supported: Bogus, None)
	     ===================================================================== -->
	<PropertyGroup Label="Testing Framework Selection">
		<_TestingFrameworkNormalized>$([System.String]::Copy('$(TestingFramework)').Trim().ToLowerInvariant())</_TestingFrameworkNormalized>
	</PropertyGroup>

	<PropertyGroup Label="Substitution Framework Selection">
		<_SubstituteFrameworkNormalized>$([System.String]::Copy('$(SubstituteFramework)').Trim().ToLowerInvariant())</_SubstituteFrameworkNormalized>
	</PropertyGroup>

	<PropertyGroup Label="Testing Framework Data Selection">
		<_TestDataFrameworkNormalized>$([System.String]::Copy('$(TestDataFramework)').Trim().ToLowerInvariant())</_TestDataFrameworkNormalized>
	</PropertyGroup>

	<!-- =====================================================================
	     COMPILER-VISIBLE SDK PROPERTIES
	     Exposes SDK properties to Roslyn analyzers/source generators via
	     AnalyzerConfigOptions as build_property.<PropertyName>.
	     ===================================================================== -->
	<ItemGroup Label="Compiler Visible SDK Properties" Condition="'$(IsCSharpProject)' == 'true'">
		<!-- Required by Purview analyzers that derive namespace expectations from project-relative paths. -->
		<CompilerVisibleProperty Include="ProjectDir">
			<Description>Absolute project directory path (with trailing separator) used by analyzers for project-relative file calculations.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="RootNamespace">
			<Description>Effective project root namespace used by analyzers that validate or customize namespace conventions.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="NamespacePrefix">
			<Description>Required namespace prefix used to derive RootNamespace for projects.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableNamespacePrefixCheck">
			<Description>Disables the build error that requires NamespacePrefix to be set.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TestingFramework">
			<Description>Selected testing framework (TUnit, Xunit, or None). Defaults to TUnit.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="SubstituteFramework">
			<Description>Selected mocking/substitute framework (TUnitMocks, NSubstitute, or None). Defaults to TUnitMocks.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TestDataFramework">
			<Description>Selected test data framework (Bogus or None). Defaults to Bogus.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="SourceLinkPackageName">
			<Description>NuGet package ID used for SourceLink integration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableSourceLink">
			<Description>Disables automatic SourceLink integration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="ExcludePurviewTelemetry">
			<Description>Opt-out flag that removes Purview telemetry source-generator integration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="ExcludeMSTelemetryExtension">
			<Description>Opt-out flag that removes Microsoft.Extensions.Telemetry.Abstractions.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="EnableAgentFolderInPackage">
			<Description>When true, copies the bundled .agents folder from the SDK NuGet package into the consuming repository. Defaults to true.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="AgentPackDestinationFolder">
			<Description>Repo-relative destination folder that receives copied .agents content. Defaults to .agents.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewAutoSdkPack">
			<Description>When true, automatically packs the Sdk/ folder contents into the NuGet package with the correct root-level paths. Defaults to true.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableGenerateAssemblyInfoClass">
			<Description>Disables generation of the AssemblyInfo helper class in intermediate output.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="EnableAssemblyNameGeneration">
			<Description>When true (default), the SDK derives AssemblyName and PackageId from RootNamespace (or from the full logical project name when suffix-stripping removed a segment, e.g. Shared/ServiceDefaults). Set to false to fall back to the standard .NET behaviour (project name).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableAutoInternalsVisibleTo">
			<Description>Disables automatic InternalsVisibleTo generation for test and shared testing projects.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="AutoIncludeUsings">
			<Description>Controls SDK-added global usings for NamespacePrefix and RootNamespace.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsCSharpProject">
			<Description>True when the current project is a C# project (*.csproj).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsTestProject">
			<Description>True when the project name matches a supported *Test/*Tests suffix.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsSharedTestingProject">
			<Description>True for known shared testing helper projects (SharedTestingFramework, etc.).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TestingType">
			<Description>Detected test category suffix from project name (Unit, Integration, E2E, etc.).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TargetProjectName">
			<Description>Inferred non-test project name that a test project targets.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsContainerProject">
			<Description>True when a Dockerfile marker indicates container-project defaults should apply.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsSdkProject">
			<Description>True when an SDK value is detected from the project/import declaration.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="SdkProjectName">
			<Description>Detected SDK name from the project/import declaration (for example Microsoft.NET.Sdk.Web).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsWebProject">
			<Description>Marker used to distinguish API/web project behaviour in SDK logic.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsWebSdkProject">
			<Description>True when SdkProjectName is Microsoft.NET.Sdk.Web.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsWorkerSdkProject">
			<Description>True when SdkProjectName is Microsoft.NET.Sdk.Worker.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsAspireHostProject">
			<Description>True when the project SDK starts with Aspire.Sdk.Host.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="EditorConfigFilePath">
			<Description>Path to the SDK-provided .editorconfig used for build-time style enforcement.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="RepositoryEditorConfigFilePath">
			<Description>Destination path for bootstrapping a physical repo-level .editorconfig when missing.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="BootstrapEditorConfigToRepoRoot">
			<Description>When true, copies the SDK .editorconfig to RepositoryEditorConfigFilePath if that file does not exist.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="RepositoryGlobalJsonFilePath">
			<Description>Destination path for bootstrapping a physical repo-level global.json when missing.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="BootstrapGlobalJsonToRepoRoot">
			<Description>When true, bootstraps global.json to RepositoryGlobalJsonFilePath if that file does not exist.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableAutoCopySdkFiles">
			<Description>When true, disables SDK auto-copy bootstrapping for repository files such as .editorconfig and global.json.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewBuildSdkVersionForGlobalJson">
			<Description>Version written to the msbuild-sdks Purview.BuildSdk entry when bootstrapping global.json.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="CurrentYear">
			<Description>Current year value used by generated assembly metadata.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="AutoGeneratedAssemblyInfoFile">
			<Description>Relative path to the SDK-generated AssemblyInfo source file.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsCLIProject">
			<Description>True when the project is a CLI project.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsSharedProject">
			<Description>True when the project is a shared project.</Description>
		</CompilerVisibleProperty>
	</ItemGroup>

	<!-- =====================================================================
	     ROSLYN COMPONENT COMPILER-VISIBLE SETTINGS
	     Exposes the compiler defaults applied to Roslyn components to the
	     compiler (as build_property.* AnalyzerConfigOptions) so the SDK's own
	     analyzers/generators and downstream tooling can confirm the shipped
	     analyzer packages were built with the standard settings.
	     ===================================================================== -->
	<ItemGroup
		Label="Roslyn Component Compiler Visible Settings"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'"
	>
		<CompilerVisibleProperty Include="LangVersion">
			<Description>C# language version used to build the Roslyn component. Defaults to latest.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="Nullable">
			<Description>Nullable reference-types context used to build the Roslyn component. Defaults to enable.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="TreatWarningsAsErrors">
			<Description>Treats all compiler/analyzer warnings as errors. Defaults to true for Roslyn components.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="EnforceExtendedAnalyzerRules">
			<Description>Enforces Roslyn analyzer best-practice rules. Defaults to true for Roslyn components.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="Deterministic">
			<Description>Produce deterministic builds. Defaults to true.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="ContinuousIntegrationBuild">
			<Description>True when building in a recognized CI environment, producing deterministic SourceLink output.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="EmbedUntrackedSources">
			<Description>Embeds untracked source files for SourceLink. Defaults to true for Roslyn components.</Description>
		</CompilerVisibleProperty>
	</ItemGroup>

	<!-- =====================================================================
	     C# PROJECT DEFAULTS
	     ===================================================================== -->
	<PropertyGroup
		Label="Roslyn Component Project Properties"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsRoslynComponent)' == 'true'"
	>
		<!-- Compiler components should not inherit repository-wide application TFMs. A project-level
		     TargetFramework/TargetFrameworks declaration is evaluated later and can still override this. -->
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework Condition="'$(_PurviewProjectDeclaresTargetFramework)' != 'true'"
			>netstandard2.0</TargetFramework>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<!-- Roslyn best-practice compiler defaults. Project body values are evaluated later and win. -->
		<LangVersion Condition="'$(LangVersion)' == '' OR '$(LangVersion)' == 'preview'">latest</LangVersion>
		<Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
		<TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
		<!-- Analyzer-only packages have no lib/ folder; suppress NU5128 so TreatWarningsAsErrors
		     does not fail the pack. No symbol package is produced by default (the PDB ships in
		     analyzers/dotnet/cs beside the analyzer assembly), and any explicit opt-in uses the
		     modern snupkg format rather than the legacy symbols.nupkg. -->
		<IncludeSymbols Condition="'$(IncludeSymbols)' == '' OR '$(IncludeSymbols)' == 'true'">false</IncludeSymbols>
		<NoWarn>$(NoWarn);NU5128;</NoWarn>
		<!-- The analyzer PDB ships inside the .nupkg under analyzers/dotnet/cs by default so symbols
		     are always delivered. NuGet's .snupkg only carries build-output (lib) symbols, so opt out
		     with PurviewPackAnalyzerPdb=false only when symbols are delivered another way. -->
		<PurviewPackAnalyzerPdb Condition="'$(PurviewPackAnalyzerPdb)' == ''">true</PurviewPackAnalyzerPdb>
		<!-- Roslyn components get the same SourceLink and source-embedding treatment as regular
		     packages so the shipped analyzer PDBs are source-linked and reproducible. -->
		<EmbedUntrackedSources Condition="'$(EmbedUntrackedSources)' == ''">true</EmbedUntrackedSources>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>

	<PropertyGroup Label="C# Project Property Groups" Condition="'$(IsCSharpProject)' == 'true'">
		<TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == ''"
			>net10.0</TargetFramework>
		<Deterministic Condition="'$(Deterministic)' == ''">true</Deterministic>
		<!-- Auto-detect CI environment from common env vars. Local builds (even packable ones) must
		     not be treated as CI builds, otherwise SourceLink's CI-mode dirty-repository checks can
		     fail under TreatWarningsAsErrors when embedding untracked sources locally. -->
		<ContinuousIntegrationBuild
			Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true' OR '$(TF_BUILD)' == 'true'"
			>true</ContinuousIntegrationBuild>
		<!-- EditorConfig from the NuGet package Sdk/ folder — used for build-time code-style enforcement. -->
		<_PurviewPackagedEditorConfigFilePath>$(MSBuildThisFileDirectory).editorconfig</_PurviewPackagedEditorConfigFilePath>
		<EditorConfigFilePath>$(_PurviewPackagedEditorConfigFilePath)</EditorConfigFilePath>
		<!-- Source-tree fallback: the package project packs the repository-root file into Sdk/.editorconfig. -->
		<EditorConfigFilePath Condition="!Exists('$(EditorConfigFilePath)')"
			>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../.editorconfig'))</EditorConfigFilePath>
		<_PurviewDiscoveredEditorConfigFilePath>$([MSBuild]::GetPathOfFileAbove('.editorconfig', '$(MSBuildProjectDirectory)'))</_PurviewDiscoveredEditorConfigFilePath>
		<_PurviewEffectiveEditorConfigFullPath>$([System.IO.Path]::GetFullPath('$(EditorConfigFilePath)'))</_PurviewEffectiveEditorConfigFullPath>
		<_PurviewDiscoveredEditorConfigFullPath Condition="'$(_PurviewDiscoveredEditorConfigFilePath)' != ''"
			>$([System.IO.Path]::GetFullPath('$(_PurviewDiscoveredEditorConfigFilePath)'))</_PurviewDiscoveredEditorConfigFullPath>
		<!-- Also bootstrap a physical repo-level .editorconfig for tools (for example CSharpier) that don't read @(EditorConfigFiles). -->
		<DisableAutoCopySdkFiles Condition="'$(DisableAutoCopySdkFiles)' == ''">false</DisableAutoCopySdkFiles>
		<BootstrapEditorConfigToRepoRoot Condition="'$(BootstrapEditorConfigToRepoRoot)' == ''"
			>true</BootstrapEditorConfigToRepoRoot>
		<RepositoryEditorConfigFilePath
			Condition="'$(RepositoryEditorConfigFilePath)' == ''"
		></RepositoryEditorConfigFilePath>
		<BootstrapGlobalJsonToRepoRoot Condition="'$(BootstrapGlobalJsonToRepoRoot)' == ''"
			>true</BootstrapGlobalJsonToRepoRoot>
		<RepositoryGlobalJsonFilePath
			Condition="'$(RepositoryGlobalJsonFilePath)' == ''"
		></RepositoryGlobalJsonFilePath>
		<_PurviewSdkContainerDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_PurviewSdkContainerDirectory>
		<_PurviewSdkContainerDirectoryName>$([System.IO.Path]::GetFileName('$(_PurviewSdkContainerDirectory)'))</_PurviewSdkContainerDirectoryName>
		<PurviewBuildSdkVersionForGlobalJson
			Condition="'$(PurviewBuildSdkVersionForGlobalJson)' == '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(_PurviewSdkContainerDirectoryName)', '^\d+\.\d+\.\d+([-.].+)?$'))"
			>$(_PurviewSdkContainerDirectoryName)</PurviewBuildSdkVersionForGlobalJson>
		<PurviewBuildSdkVersionForGlobalJson Condition="'$(PurviewBuildSdkVersionForGlobalJson)' == ''"
			>1.0.0</PurviewBuildSdkVersionForGlobalJson>
		<!-- Sensible default for SourceLink (override by setting SourceLinkPackageName) -->
		<SourceLinkPackageName Condition="'$(SourceLinkPackageName)' == ''"
			>Microsoft.SourceLink.GitHub</SourceLinkPackageName>
		<DisableSourceLink Condition="'$(IsRoslynComponent)' != 'true'">false</DisableSourceLink>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
		<IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
		<WarnOnPackingNonPackableProject
			Condition="'$(WarnOnPackingNonPackableProject)' == '' AND '$(IsPackable)' == 'false'"
			>false</WarnOnPackingNonPackableProject>
		<NoWarn>AD0001;$(NoWarn)</NoWarn>
		<NoWarn>IDE2001;$(NoWarn)</NoWarn>
		<NoWarn>CA1014;CA1848;CA2007;CA2201;CA2225;CA2254;$(NoWarn)</NoWarn>
		<NoWarn>RCS1090;RCS1108;$(NoWarn)</NoWarn>
		<CurrentYear>$([System.DateTime]::Now.Year)</CurrentYear>
		<Version Condition="'$(Version)' == ''">0.0.1</Version>
		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<!-- Path for the auto-generated assembly info class -->
		<AutoGeneratedAssemblyInfoFile>$(IntermediateOutputPath)/Properties/GeneratedAssemblyInfo.cs</AutoGeneratedAssemblyInfoFile>
	</PropertyGroup>

	<PropertyGroup
		Label="Aspire Host Project Properties"
		Condition="'$(IsAspireHostProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
		<!--
			When  using things like SpectreConsole, you generally define the settings
			as a nested public class to the internal command. However, this still forces
			CA1515 to be created which is a pain as it's not really relevant.
		-->
		<NoWarn>$(NoWarn);CA1515;</NoWarn>
	</PropertyGroup>

	<PropertyGroup
		Label="CLI Project Properties"
		Condition="'$(IsCLIProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
		<!--
			When  using things like SpectreConsole, you generally define the settings
			as a nested public class to the internal command. However, this still forces
			CA1515 to be created which is a pain as it's not really relevant.
		-->
		<NoWarn>$(NoWarn);CA1515;</NoWarn>
	</PropertyGroup>

	<ItemGroup Label="CLI Item Properties" Condition="'$(IsCLIProject)' == 'true'">
		<Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup
		Label="C# Analyzer Config Files"
		Condition="'$(IsCSharpProject)' == 'true' AND Exists('$(EditorConfigFilePath)')"
	>
		<EditorConfigFiles
			Include="$(EditorConfigFilePath)"
			Condition="'$(_PurviewEffectiveEditorConfigFullPath)' != '$(_PurviewDiscoveredEditorConfigFullPath)'"
		/>
	</ItemGroup>

	<!-- =====================================================================
	     SDK-SHIPPED ANALYZERS
	     Analyzer assets inside an MSBuild SDK package are not automatically added
	     to the compiler by NuGet, so add the SDK's analyzer assembly explicitly
	     (this is why the shipped rules show up in both command-line builds and
	     Visual Studio).

	     The code-fix assembly ships beside the analyzer in analyzers/dotnet/cs,
	     but the IDE discovers project-level code fixes only from analyzer
	     references (Roslyn's CodeFixService keys on Project.AnalyzerReferences),
	     so it must ALSO be an Analyzer item for the fixes to appear in Visual
	     Studio. It can never be an unconditional Analyzer item: CodeFixProvider
	     and [ExportCodeFixProvider] live in Microsoft.CodeAnalysis.Workspaces,
	     which the command-line compiler cannot resolve (the SDK's Roslyn folder
	     ships only the compiler assemblies), so csc would emit CS8032 for every
	     build. Gating on BuildingInsideVisualStudio restricts the code-fix
	     assembly to Visual Studio, where Workspaces is always available. The
	     Exists() guard keeps the in-repo bootstrap (which has no
	     analyzers/dotnet/cs folder) inert.
	     ===================================================================== -->
	<ItemGroup
		Label="SDK-Shipped Analyzers"
		Condition="'$(IsCSharpProject)' == 'true' AND Exists('$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Purview.BuildSdk.Analyzers.dll')"
	>
		<Analyzer Include="$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Purview.BuildSdk.Analyzers.dll" />
		<Analyzer
			Include="$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Purview.BuildSdk.CodeFixers.dll"
			Condition="'$(BuildingInsideVisualStudio)' == 'true'"
		/>
	</ItemGroup>

	<!-- Default namespace from logical project identity -->
	<PropertyGroup>
		<_PurviewSharedProjectRemovePattern>$([System.Text.RegularExpressions.Regex]::Replace('$(_SharedProjectNames)', '^;|;$', '').Replace(';', '|'))</_PurviewSharedProjectRemovePattern>
		<_PurviewSharedTestingProjectRemovePattern>$([System.Text.RegularExpressions.Regex]::Replace('$(_SharedTestingProjectNames)', '^;|;$', '').Replace(';', '|'))</_PurviewSharedTestingProjectRemovePattern>
		<_PurviewNamespaceRemovePattern>$(_PurviewSharedProjectRemovePattern)|$(_PurviewSharedTestingProjectRemovePattern)|Core|EF|Shared|ClientShared|ServiceDefaults</_PurviewNamespaceRemovePattern>
		<RootNamespace
			Condition="('$(RootNamespace)' == '' OR '$(RootNamespace)' == '$(MSBuildProjectName)') AND '$(PurviewLogicalProjectName)' != ''"
			>$(PurviewLogicalProjectName)</RootNamespace>
		<!-- Captures the RootNamespace before suffix stripping. It equals PurviewLogicalProjectName
		     only when RootNamespace was not explicitly overridden before the SDK import, which lets
		     the assembly/package defaults re-append a stripped suffix without breaking explicit
		     RootNamespace overrides. -->
		<_PurviewUnstrippedRootNamespace>$(RootNamespace)</_PurviewUnstrippedRootNamespace>
		<RootNamespace Condition="'$(_PurviewNamespaceRemovePattern)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Replace('$(RootNamespace)', '\.(?:$(_PurviewNamespaceRemovePattern))(?=\.|$)', ''))</RootNamespace>
		<RootNamespace Condition="'$(TestingType)' != ''"
			>$([System.Text.RegularExpressions.Regex]::Replace($(RootNamespace), `[.]$(TestingType)Tests?$$`, ``))</RootNamespace>
	</PropertyGroup>

	<!-- =====================================================================
	     ASSEMBLY NAME AND PACKAGE ID GENERATION
	     RootNamespace is the canonical default public name. These defaults run
	     during Sdk.props — before the Microsoft SDK computes TargetName and before
	     the project body — so compilation, output paths, project references,
	     restore, and packing all agree on the same identities. The Microsoft SDK
	     initializes AssemblyName from MSBuildProjectName, so both the empty and
	     synthesized-value cases must be handled here. Project-authored
	     AssemblyName/PackageId values set before the import (Directory.Build.props)
	     are preserved, and values set in the project body are evaluated later and
	     win. Set EnableAssemblyNameGeneration=false before the import to opt out
	     and restore the standard .NET project-name behaviour.
	     ===================================================================== -->
	<PropertyGroup
		Label="Assembly Name and Package ID Generation"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(EnableAssemblyNameGeneration)' != 'false'"
	>
		<!-- True only when RootNamespace came from the logical project name AND suffix-stripping removed
		     a segment, so the assembly/package identity re-appends it. Explicit RootNamespace overrides
		     leave _PurviewUseLogicalProjectName unset and keep following RootNamespace. -->
		<_PurviewUseLogicalProjectName
			Condition="'$(PurviewLogicalProjectName)' != '' AND '$(RootNamespace)' != '$(PurviewLogicalProjectName)' AND '$(_PurviewUnstrippedRootNamespace)' == '$(PurviewLogicalProjectName)'"
			>true</_PurviewUseLogicalProjectName>
		<!-- Non-test projects: when suffix-stripping removed a segment of the logical project name
		     (Shared, Core, EF, ServiceDefaults, ...), use the full logical project name so assemblies
		     stay distinct (Purview.SampleApp.Shared vs Purview.SampleApp.ServiceDefaults rather than
		     two Purview.SampleApp assemblies). -->
		<AssemblyName
			Condition="('$(AssemblyName)' == '' OR '$(AssemblyName)' == '$(MSBuildProjectName)') AND '$(_PurviewUseLogicalProjectName)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
			>$(PurviewLogicalProjectName)</AssemblyName>
		<!-- Otherwise: default to the fully-evaluated RootNamespace (unchanged behaviour). -->
		<AssemblyName
			Condition="('$(AssemblyName)' == '' OR '$(AssemblyName)' == '$(MSBuildProjectName)') AND '$(_PurviewUseLogicalProjectName)' != 'true' AND '$(RootNamespace)' != '' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
			>$(RootNamespace)</AssemblyName>
		<!-- Test/shared-testing projects: RootNamespace strips the test suffix, so derive from the
		     logical project name to keep test assemblies distinct from the source assembly. -->
		<AssemblyName
			Condition="('$(AssemblyName)' == '' OR '$(AssemblyName)' == '$(MSBuildProjectName)') AND '$(PurviewLogicalProjectName)' != '' AND ('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true')"
			>$(PurviewLogicalProjectName)</AssemblyName>
		<!-- PackageId follows the same rule as AssemblyName so package identity stays in sync. -->
		<PackageId
			Condition="('$(PackageId)' == '' OR '$(PackageId)' == '$(MSBuildProjectName)') AND '$(_PurviewUseLogicalProjectName)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
			>$(PurviewLogicalProjectName)</PackageId>
		<PackageId
			Condition="('$(PackageId)' == '' OR '$(PackageId)' == '$(MSBuildProjectName)') AND '$(_PurviewUseLogicalProjectName)' != 'true' AND '$(RootNamespace)' != '' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
			>$(RootNamespace)</PackageId>
		<PackageId
			Condition="('$(PackageId)' == '' OR '$(PackageId)' == '$(MSBuildProjectName)') AND '$(PurviewLogicalProjectName)' != '' AND ('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true')"
			>$(PurviewLogicalProjectName)</PackageId>
	</PropertyGroup>

	<!-- Test project target resolution -->
	<PropertyGroup Label="C# Test Properties" Condition="'$(IsTestProject)' == 'true'">
		<TargetProjectName>$([System.Text.RegularExpressions.Regex]::Replace($(MSBuildProjectName), `[.]$(TestingType)Tests?$$`, ``))</TargetProjectName>
	</PropertyGroup>

	<!-- =====================================================================
	     C# PROJECT ITEM GROUPS
	     ===================================================================== -->
	<ItemGroup Label="C# Project Item Groups" Condition="'$(IsCSharpProject)' == 'true'">
		<!-- Implicit usings -->
		<Using
			Condition="'$(AutoIncludeUsings)' == 'true' AND '$(NamespacePrefix)' != ''"
			Include="$(NamespacePrefix)"
		/>
		<Using Condition="'$(AutoIncludeUsings)' == 'true'" Include="$(RootNamespace)" />
		<!-- InternalsVisibleTo for Moq/NSubstitute dynamic proxies -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>"DynamicProxyGenAssembly2"</_Parameter1>
		</AssemblyAttribute>
		<!-- Exclusions -->
		<None Remove="$(MSBuildProjectName).v3.ncrunchproject" />
		<None Remove="$(AssemblyName).xml" />
		<Compile Remove="TestResults/**" />
		<Content Remove="TestResults/**" />
		<EmbeddedResource Remove="TestResults/**" />
		<None Remove="TestResults/**" />
		<!-- Embedded resources -->
		<None Remove="Resources/**/*" />
		<EmbeddedResource Include="Resources/**/*" />
		<EmbeddedResource Include="FileSystemResources\**\*">
			<LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- =====================================================================
	     FILE CONTENT OPTIONS
	     ===================================================================== -->
	<ItemGroup Label="C# File Content Options" Condition="'$(IsCSharpProject)' == 'true'">
		<None Remove="$(AssemblyName).xml" />
		<Compile Remove="TestResults/**" />
		<Content Remove="TestResults/**" />
		<EmbeddedResource Remove="TestResults/**" />
		<None Remove="TestResults/**" />
	</ItemGroup>

	<!-- =====================================================================
	     AUTOMATIC SDK FOLDER PACKAGING
	     ===================================================================== -->
	<PropertyGroup Label="Automatic Sdk Folder Packaging">
		<PurviewAutoSdkPack Condition="'$(PurviewAutoSdkPack)' == ''">true</PurviewAutoSdkPack>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeLinkedSdkFiles;IncludeSdkDotAgentsGitIgnoreFiles;IncludeRepoReadmeInPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<!-- Analyzer project references are build-time assets and are not packed by NuGet's
	     normal ProjectReference handling. Collect them automatically for packable projects. -->
	<PropertyGroup Label="Automatic Source Generator Packaging">
		<PackProjectReferencedSourceGenerators Condition="'$(PackProjectReferencedSourceGenerators)' == ''"
			>true</PackProjectReferencedSourceGenerators>
		<TargetsForTfmSpecificContentInPackage
			Condition="'$(PackProjectReferencedSourceGenerators)' == 'true' AND !$([System.String]::Copy(';$(TargetsForTfmSpecificContentInPackage);').Contains(';IncludeProjectReferencedSourceGenerators;'))"
			>$(TargetsForTfmSpecificContentInPackage);IncludeProjectReferencedSourceGenerators</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup Label="Automatic Sdk Folder Packaging" Condition="'$(PurviewAutoSdkPack)' == 'true'">
		<None Include="Sdk/.agents/**/*" Pack="true" Visible="true">
			<PackagePath>.agents/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)</PackagePath>
		</None>
		<None Include="Sdk/.github/**/*" Pack="true" Visible="true">
			<PackagePath>.github/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)</PackagePath>
		</None>
		<None Include="Sdk/build/**/*" Pack="true" Visible="true">
			<PackagePath>build/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)</PackagePath>
		</None>
		<None Include="Sdk/buildTransitive/**/*" Pack="true" Visible="true">
			<PackagePath>buildTransitive/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)</PackagePath>
		</None>
		<None Include="Sdk/buildMultiTargeting/**/*" Pack="true" Visible="true">
			<PackagePath>buildMultiTargeting/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)</PackagePath>
		</None>
		<None Include="Sdk/*.md;Sdk/*.png;Sdk/*.jpg;Sdk/*.jpeg;Sdk/*.gif;Sdk/*.svg" Pack="true" Visible="true">
			<PackagePath>%(Filename)%(Extension)</PackagePath>
		</None>
		<None
			Include="Sdk/**/*"
			Pack="true"
			Visible="true"
			Exclude="Sdk/.agents/**/*;Sdk/.github/**/*;Sdk/build/**/*;Sdk/buildTransitive/**/*;Sdk/buildMultiTargeting/**/*;Sdk/*.md;Sdk/*.png;Sdk/*.jpg;Sdk/*.jpeg;Sdk/*.gif;Sdk/*.svg"
		>
			<PackagePath>Sdk/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)</PackagePath>
		</None>
	</ItemGroup>

	<!-- =====================================================================
	     CONTAINER PROJECTS
	     ===================================================================== -->
	<PropertyGroup
		Label="Container Project"
		Condition="'$(IsContainerProject)' == 'true' AND '$(IsTestProject)' != 'true'"
	>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishAot>true</PublishAot>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..\</DockerfileContext>
	</PropertyGroup>

	<ItemGroup Label="Container Project" Condition="'$(IsContainerProject)' == 'true' AND '$(IsTestProject)' != 'true'">
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	</ItemGroup>

	<!-- =====================================================================
	     WEB PROJECTS (non-API web apps that need OpenAPI interceptors)
	     ===================================================================== -->
	<PropertyGroup Label="Web Project" Condition="'$(IsWebSdkProject)' == 'true' AND '$(IsWebProject)' != 'true'">
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
	</PropertyGroup>

	<!-- =====================================================================
	     LIBRARY PROJECTS
	     ===================================================================== -->
	<PropertyGroup
		Label="Library Project Properties"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<NoWarn>$(NoWarn);CS1591;</NoWarn>
	</PropertyGroup>

	<!-- =====================================================================
	     NUGET PACKAGE PROJECTS
	     Only applied when the consuming project has not supplied a value.
	     Portable PDBs are delivered through the symbol package (.snupkg); the
	     normal package keeps the default build-output extensions unless the
	     project explicitly opts into adding more (for example .pdb).
	     ===================================================================== -->
	<PropertyGroup Label="NuGet Package Project Properties" Condition="'$(IsPackable)' == 'true'">
		<GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
		<IncludeSource Condition="'$(IncludeSource)' == ''">true</IncludeSource>
		<IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
		<PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">true</PublishRepositoryUrl>
		<EmbedUntrackedSources Condition="'$(EmbedUntrackedSources)' == ''">true</EmbedUntrackedSources>
		<SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == ''">snupkg</SymbolPackageFormat>
		<DebugType Condition="'$(DebugType)' == ''">portable</DebugType>
	</PropertyGroup>

	<!-- =====================================================================
	     REPOSITORY README
	     When the repo-root README exists and PackageReadmeFile has not been
	     explicitly configured, register it as the package readme. The file itself
	     is added to the package by the IncludeRepoReadmeInPackage target during
	     pack (which guards against duplicates).
	     ===================================================================== -->
	<PropertyGroup
		Label="Repository Readme Defaults"
		Condition="'$(IsPackable)' == 'true' AND '$(PackageReadmeFile)' == '' AND '$(RepoRoot)' != '' AND Exists('$(RepoRoot)/README.md')"
	>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- =====================================================================
	     PURVIEW TELEMETRY — OPT-OUT (set ExcludePurviewTelemetry=true to skip)
	     ===================================================================== -->
	<ItemGroup
		Label="C# Telemetry Packages"
		Condition="'$(IsCSharpProject)' == 'true' AND '$(IsTestProject)' != 'true' AND '$(ExcludePurviewTelemetry)' != 'true'"
	>
		<PackageReference Include="Purview.Telemetry.SourceGenerator">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference
			Condition="'$(ExcludeMSTelemetryExtension)' != 'true'"
			Include="Microsoft.Extensions.Telemetry.Abstractions"
		/>
	</ItemGroup>

	<!-- =====================================================================
	     SOURCELINK — auto-added to all non-test projects
	     ===================================================================== -->
	<ItemGroup
		Label="NuGet Package References"
		Condition="'$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true' AND '$(DisableSourceLink)' != 'true' AND '$(SourceLinkPackageName)' != ''"
	>
		<PackageReference Include="$(SourceLinkPackageName)">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>all</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- =====================================================================
	     SHARED TEST PROJECT PROPERTIES
	     ===================================================================== -->
	<PropertyGroup
		Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'"
		Label="C# Shared Testing Project Properties"
	>
		<NoWarn>$(NoWarn);CA1062;CA1515;CA1707;CA1822;</NoWarn>
		<NoWarn>$(NoWarn);CS1591;</NoWarn>
		<Packable>false</Packable>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Label="Testing Project Properties" Condition="'$(IsTestProject)' == 'true'">
		<OutputType Condition="'$(_TestingFrameworkNormalized)' != 'none'">Exe</OutputType>
		<MaxCpuCount>0</MaxCpuCount>
		<CollectCoverage>true</CollectCoverage>
		<Exclude>[NSubstitute*]*,[TUnit.*]*,[xunit.*]*,[Microsoft.Testing.*]*,[Microsoft.NET.Test*]*,[Bogus*]*</Exclude>
		<ExcludeByAttribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<!-- Disable native instrumentation unless C++ is involved -->
		<EnableStaticNativeInstrumentation>false</EnableStaticNativeInstrumentation>
		<EnableDynamicNativeInstrumentation>false</EnableDynamicNativeInstrumentation>
	</PropertyGroup>

	<PropertyGroup
		Label="Testing NuGet Packages"
		Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'"
	>
		<DisableGenerateAssemblyInfoClass>true</DisableGenerateAssemblyInfoClass>
	</PropertyGroup>

	<ItemGroup
		Label="Testing NuGet Packages"
		Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'"
	>
		<AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
	</ItemGroup>

	<ItemGroup
		Label="Substitute Framework NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_SubstituteFrameworkNormalized)' == 'nsubstitute'"
	>
		<Using Include="NSubstitute" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="NSubstitute.Analyzers.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup
		Label="Substitute Framework NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_SubstituteFrameworkNormalized)' == 'tunitmocks'"
	>
		<PackageReference Include="TUnit.Mocks" />
	</ItemGroup>

	<ItemGroup
		Label="Test Data Framework NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_TestDataFrameworkNormalized)' == 'bogus'"
	>
		<Using Include="Bogus" />
		<PackageReference Include="Bogus" />
	</ItemGroup>

	<!-- =====================================================================
	     TUNIT TEST PACKAGES (default)
	     ===================================================================== -->
	<PropertyGroup
		Label="TUnit Testing Platform Properties"
		Condition="'$(IsTestProject)' == 'true' AND '$(_TestingFrameworkNormalized)' == 'tunit'"
	>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<EnableMicrosoftTestingPlatform>true</EnableMicrosoftTestingPlatform>
	</PropertyGroup>

	<ItemGroup
		Label="TUnit NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_TestingFrameworkNormalized)' == 'tunit'"
	>
		<AssemblyAttribute Include="TUnit.Core.Category" Condition="'$(IsSharedTestingProject)' != 'true'">
			<_Parameter1>$(TestingType)</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="TUnit.Core.Skip" Condition="'$(IsSharedTestingProject)' == 'true'">
			<_Parameter1>Skipping Shared Testing Project</_Parameter1>
		</AssemblyAttribute>
		<PackageReference Include="TUnit" Condition="'$(IsSharedTestingProject)' != 'true'" />
		<PackageReference Include="TUnit.Core" Condition="'$(IsSharedTestingProject)' == 'true'" />
	</ItemGroup>

	<!-- =====================================================================
	     XUNIT TEST PACKAGES (opt-in: set TestingFramework=Xunit)
	     ===================================================================== -->
	<ItemGroup
		Label="XUnit NuGet Packages"
		Condition="('$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true') AND '$(_TestingFrameworkNormalized)' == 'xunit'"
	>
		<AssemblyAttribute Include="Xunit.Trait" Condition="'$(IsSharedTestingProject)' != 'true'">
			<_Parameter1>Category</_Parameter1>
			<_Parameter2>$(TestingType)</_Parameter2>
		</AssemblyAttribute>
		<PackageReference Include="xunit.v3" Condition="'$(IsSharedTestingProject)' != 'true'" />
		<PackageReference Include="xunit.runner.visualstudio" Condition="'$(IsSharedTestingProject)' != 'true'">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- =====================================================================
     AUTOMATIC PROJECT REFERENCES FOR TEST PROJECTS
     Resolves the target project relative to the test project location.
     ===================================================================== -->
	<ItemGroup
		Label="Automatic ProjectReference for Projects"
		Condition="'$(IsTestProject)' != 'true' AND '$(IsSharedProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<!-- Shared project alongside this one (wildcards silently match 0 files) -->
		<ProjectReference Condition="'$(IsAspireHostProject)' == 'false'" Include="../Shared*/Shared*.csproj" />
		<ProjectReference
			Condition="'$(IsAspireHostProject)' == 'true'"
			Include="../Shared*/Shared*.csproj"
			IsAspireProjectResource="false"
		/>
		<ProjectReference Remove="../SharedTesting*/SharedTesting*.csproj" />
		<ProjectReference Remove="../$(MSBuildProjectName)/$(MSBuildProjectName).csproj" />
	</ItemGroup>

	<!-- =====================================================================
	     AUTOMATIC PROJECT REFERENCES FOR TEST PROJECTS
	     Resolves the target project relative to the test project location.
	     ===================================================================== -->
	<ItemGroup
		Label="Automatic ProjectReference for Test Projects"
		Condition="'$(IsTestProject)' == 'true' AND '$(IsSharedTestingProject)' != 'true'"
	>
		<ProjectReference
			Include="../$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<ProjectReference
			Include="../../$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../../$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<ProjectReference
			Include="../src/$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../src/$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<ProjectReference
			Include="../../src/$(TargetProjectName)/$(TargetProjectName).csproj"
			Condition="Exists('../../src/$(TargetProjectName)/$(TargetProjectName).csproj')"
		/>
		<!-- Shared testing project alongside this one (wildcards silently match 0 files) -->
		<ProjectReference Include="../SharedTesting*/SharedTesting*.csproj" />
		<ProjectReference Remove="../$(MSBuildProjectName)/$(MSBuildProjectName).csproj" />
	</ItemGroup>
</Project>
