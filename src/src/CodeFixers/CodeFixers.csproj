<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<AssemblyName>Purview.BuildSdk.CodeFixers</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Analyzers\Analyzers.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The refactoring and code-fix tests live alongside the analyzer tests in
			Analyzers.IntegrationTests, because the behaviour they cover spans an analyzer's diagnostic and
			the fix for it. The SDK's automatic grant is derived from this project's own name, so that one
			test assembly has to be named explicitly.
		-->
		<InternalsVisibleTo Include="Purview.BuildSdk.Analyzers.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
